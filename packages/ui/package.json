    "lint": "eslint src",
    "test": "echo 'ui primitives are covered by the web e2e and accessibility suites'"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-direction": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.2.1",
