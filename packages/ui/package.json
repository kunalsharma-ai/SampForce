{
  "name": "@dealflow/ui",
  "version": "0.1.0",
  "private": true,
  "description": "SampForce design system: tokens, Tailwind preset and accessible primitives (Radix + shadcn conventions).",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tailwind-preset": "./tailwind-preset.js",
    "./tokens.css": "./src/tokens.css"
