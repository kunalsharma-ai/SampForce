  tenantId    String   @map("tenant_id") @db.Uuid
  priceBookId String   @map("price_book_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  unitPrice   Decimal  @map("unit_price") @db.Decimal(18, 2)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceBook PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceBookId, productId])
  @@map("price_book_entries")
}

model TaxRate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  /// Percentage, e.g. 18.000 for 18 %.
  rate      Decimal  @db.Decimal(6, 3)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("tax_rates")
}

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  ACCEPTED
  DECLINED
}

/// One version of a quote. Revising creates a new row with the same number and version + 1.
model Quote {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String      @map("tenant_id") @db.Uuid
  number             Int
  version            Int         @default(1)
  isLatest           Boolean     @default(true) @map("is_latest")
  opportunityId      String      @map("opportunity_id") @db.Uuid
  priceBookId        String      @map("price_book_id") @db.Uuid
  title              String
  currency           String      @db.Char(3)
  status             QuoteStatus @default(DRAFT)
  validUntil         DateTime?   @map("valid_until") @db.Date
  notes              String?
  terms              String?
  subtotal           Decimal     @default(0) @db.Decimal(18, 2)
  discountTotal      Decimal     @default(0) @map("discount_total") @db.Decimal(18, 2)
  taxTotal           Decimal     @default(0) @map("tax_total") @db.Decimal(18, 2)
  total              Decimal     @default(0) @db.Decimal(18, 2)
  maxDiscountPercent Decimal     @default(0) @map("max_discount_percent") @db.Decimal(5, 2)
  approvalId         String?     @map("approval_id") @db.Uuid
  createdById        String?     @map("created_by_id") @db.Uuid
  sentAt             DateTime?   @map("sent_at") @db.Timestamptz(3)
  decidedAt          DateTime?   @map("decided_at") @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  priceBook   PriceBook   @relation(fields: [priceBookId], references: [id])
  lines       QuoteLine[]
  contracts   Contract[]

  @@unique([tenantId, number, version])
  @@index([tenantId, opportunityId])
  @@index([tenantId, status, isLatest])
  @@map("quotes")
}

model QuoteLine {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  quoteId         String  @map("quote_id") @db.Uuid
  productId       String  @map("product_id") @db.Uuid
  position        Int
  name            String
  description     String?
  quantity        Decimal @db.Decimal(12, 2)
  /// Copied from the price book when the line is saved; never typed in.
  unitPrice       Decimal @map("unit_price") @db.Decimal(18, 2)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxRateId       String? @map("tax_rate_id") @db.Uuid
  taxPercent      Decimal @default(0) @map("tax_percent") @db.Decimal(6, 3)
  netTotal        Decimal @map("net_total") @db.Decimal(18, 2)
  taxTotal        Decimal @map("tax_total") @db.Decimal(18, 2)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([quoteId, position])
  @@map("quote_lines")
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

model Contract {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  number            Int
  name              String
  companyId         String?        @map("company_id") @db.Uuid
  opportunityId     String?        @map("opportunity_id") @db.Uuid
  quoteId           String?        @map("quote_id") @db.Uuid
  ownerId           String?        @map("owner_id") @db.Uuid
  status            ContractStatus @default(DRAFT)
  value             Decimal        @default(0) @db.Decimal(18, 2)
  currency          String         @db.Char(3)
  startDate         DateTime       @map("start_date") @db.Date
  endDate           DateTime?      @map("end_date") @db.Date
  autoRenew         Boolean        @default(false) @map("auto_renew")
  renewalNoticeDays Int            @default(30) @map("renewal_notice_days")
  /// How the signature was captured. No e-signature provider is connected yet.
  signatureMethod   String?        @map("signature_method")
  signedBy          String?        @map("signed_by")
  signedAt          DateTime?      @map("signed_at") @db.Date
  terms             String?
  renewedFromId     String?        @unique @map("renewed_from_id") @db.Uuid
  reminderSentAt    DateTime?      @map("reminder_sent_at") @db.Timestamptz(3)
  terminatedAt      DateTime?      @map("terminated_at") @db.Timestamptz(3)
  terminationReason String?        @map("termination_reason")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company?     @relation(fields: [companyId], references: [id])
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  quote       Quote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  renewedFrom Contract?    @relation("ContractRenewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewal     Contract?    @relation("ContractRenewal")
  escalations Escalation[]

  @@unique([tenantId, number])
  @@index([tenantId, status, endDate])
  @@index([tenantId, companyId])
  @@map("contracts")
}

// ───────────── Phase 5: marketing ─────────────

enum CampaignStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

model Campaign {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  name        String
  channel     String
  status      CampaignStatus @default(PLANNED)
  startDate   DateTime?      @map("start_date") @db.Date
  endDate     DateTime?      @map("end_date") @db.Date
  budget      Decimal?       @db.Decimal(18, 2)
  currency    String         @db.Char(3)
  /// Leads whose campaign source equals this value count towards the campaign too.
  utmCampaign String?        @map("utm_campaign")
  ownerId     String?        @map("owner_id") @db.Uuid
  description String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]
  forms  LeadForm[]

  @@unique([tenantId, name])
  @@map("campaigns")
}

/// A saved audience: rules over leads or contacts, evaluated when it is viewed or exported.
model Segment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String?
  entity      String
  rules       Json
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("segments")
}

/// A hosted lead-capture form. Its public token is safe to embed in a website.
model LeadForm {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  name           String
  publicToken    String   @unique @map("public_token")
  title          String
  intro          String?
  fields         Json
  consentText    String?  @map("consent_text")
  successMessage String   @map("success_message")
  source         String   @default("web_form")
  campaignId     String?  @map("campaign_id") @db.Uuid
  ownerId        String   @map("owner_id") @db.Uuid
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign    Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  submissions FormSubmission[]

  @@map("lead_forms")
}

model FormSubmission {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  formId    String   @map("form_id") @db.Uuid
  leadId    String?  @map("lead_id") @db.Uuid
  data      Json
  consent   Boolean  @default(false)
  /// SHA-256 of the client IP with a server secret; used for rate limiting, not tracking.
  ipHash    String?  @map("ip_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  form   LeadForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, createdAt(sort: Desc)])
  @@index([tenantId, ipHash, createdAt])
  @@map("form_submissions")
}

// ───────────── Phase 5: revenue and customer success ─────────────

/// Manually maintained rate: 1 unit of `currency` = `rate` units of the workspace default currency.
model ExchangeRate {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  currency      String   @db.Char(3)
  rate          Decimal  @db.Decimal(18, 8)
  effectiveDate DateTime @map("effective_date") @db.Date
  source        String   @default("manual")
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, currency, effectiveDate])
  @@map("exchange_rates")
}

/// Revenue target for a quarter, for a person (userId) or the whole workspace (userId null).
model SalesTarget {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  period    String
  amount    Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, period, userId])
  @@map("sales_targets")
}

enum EscalationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EscalationStatus {
  OPEN
  RESOLVED
}

model Escalation {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  companyId   String             @map("company_id") @db.Uuid
  contractId  String?            @map("contract_id") @db.Uuid
  title       String
  description String?
  severity    EscalationSeverity @default(MEDIUM)
  status      EscalationStatus   @default(OPEN)
  ownerId     String?            @map("owner_id") @db.Uuid
  openedById  String?            @map("opened_by_id") @db.Uuid
  resolution  String?
  resolvedAt  DateTime?          @map("resolved_at") @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, severity])
  @@index([tenantId, companyId])
  @@map("escalations")
}

/// Latest rule-based health score per customer, kept so a drop can raise one churn alert.
model CompanyHealth {
  companyId  String    @id @map("company_id") @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  score      Int
  band       String
  signals    Json
  computedAt DateTime  @map("computed_at") @db.Timestamptz(3)
  alertedAt  DateTime? @map("alerted_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([tenantId, band])
  @@map("company_health")
}

// ───────────── Phase 6: billing, operators, support access ─────────────

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

/// Invoices as reported by the billing provider. Amounts in the smallest currency unit.
model Invoice {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  provider          BillingProvider
  providerInvoiceId String          @map("provider_invoice_id")
  number            String?
  status            InvoiceStatus
  currency          String          @db.Char(3)
  subtotalCents     Int             @map("subtotal_cents")
  taxCents          Int             @default(0) @map("tax_cents")
  totalCents        Int             @map("total_cents")
  amountPaidCents   Int             @default(0) @map("amount_paid_cents")
  periodStart       DateTime?       @map("period_start") @db.Timestamptz(3)
  periodEnd         DateTime?       @map("period_end") @db.Timestamptz(3)
  hostedUrl         String?         @map("hosted_url")
  pdfUrl            String?         @map("pdf_url")
  issuedAt          DateTime        @map("issued_at") @db.Timestamptz(3)
  paidAt            DateTime?       @map("paid_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([provider, providerInvoiceId])
  @@index([tenantId, issuedAt])
  @@map("invoices")
}

/// Provider webhook events already applied (idempotency). Stores the event type, not the payload.
model BillingEvent {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  provider        BillingProvider
  providerEventId String          @map("provider_event_id")
  type            String
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@map("billing_events")
}

/// A workspace owner's time-boxed permission for platform support to look inside the workspace.
model SupportGrant {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  grantedById String    @map("granted_by_id") @db.Uuid
  reason      String
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, expiresAt])
  @@map("support_grants")
}

enum OperatorRole {
  ADMIN
  SUPPORT
}

enum OperatorStatus {
  ACTIVE
  DISABLED
}

/// Platform staff. A separate realm from workspace users: own table, own sign-in, own token secret.
model PlatformOperator {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String         @unique
  name         String
  passwordHash String         @map("password_hash")
  role         OperatorRole   @default(SUPPORT)
  status       OperatorStatus @default(ACTIVE)
  lastLoginAt  DateTime?      @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  auditLogs PlatformAuditLog[]

  @@map("platform_operators")
}

/// Append-only log of everything operators do. The application role may insert and read, never change.
model PlatformAuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operatorId     String?  @map("operator_id") @db.Uuid
  action         String
  targetTenantId String?  @map("target_tenant_id") @db.Uuid
  metadata       Json     @default("{}")
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  operator PlatformOperator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([targetTenantId, createdAt])
  @@index([createdAt])
  @@map("platform_audit_logs")
}

// ───────────────────────────── Reports and immersive views (Phase 7) ─────────────────────────────

enum ReportVisibility {
  PRIVATE
  WORKSPACE
}

/// A saved report definition (see reportDefinitionSchema). Only catalogue field keys are stored, never SQL.
model Report {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  name        String
  description String?
  visibility  ReportVisibility @default(PRIVATE)
  definition  Json
  createdById String?          @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdById])
  @@map("reports")
}

/// An ordered grid of report widgets: [{ reportId, size }]. Widgets whose report is gone or hidden are skipped.
model Dashboard {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  name        String
  description String?
  visibility  ReportVisibility @default(PRIVATE)
  widgets     Json             @default("[]")
  createdById String?          @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdById])
  @@map("dashboards")
}

/// Every stage a deal enters, with when. Written on create and on each move; the source of flow and replay views.
/// `reconstructed` rows were back-filled from the audit log when the table was introduced.
model DealStageEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  opportunityId String   @map("opportunity_id") @db.Uuid
  pipelineId    String   @map("pipeline_id") @db.Uuid
  fromStageId   String?  @map("from_stage_id") @db.Uuid
  toStageId     String   @map("to_stage_id") @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  reconstructed Boolean  @default(false)
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([tenantId, pipelineId, occurredAt])
  @@index([opportunityId, occurredAt])
  @@map("deal_stage_events")
}

// ───────────────────────────── Enterprise identity (Phase 8) ─────────────────────────────

/// A workspace's OpenID Connect identity provider. One per workspace.
model SsoConnection {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @unique @map("tenant_id") @db.Uuid
  /// Globally unique name people type on the sign-in page ("Sign in with SSO").
  loginSlug       String    @unique @map("login_slug")
  issuer          String
  clientId        String    @map("client_id")
  clientSecretEnc String    @map("client_secret_enc")
  /// Lower-case email domains the provider may sign in. Empty = any domain the provider asserts.
  allowedDomains  String[]  @default([]) @map("allowed_domains")
  /// Create a membership on first sign-in for people the workspace has not invited.
  jitProvisioning Boolean   @default(false) @map("jit_provisioning")
  defaultRoleId   String?   @map("default_role_id") @db.Uuid
  enabled         Boolean   @default(false)
  /// Password sign-in no longer opens this workspace (owners keep it as a break-glass route).
  enforced        Boolean   @default(false)
  /// Last successful test or sign-in, for the settings page.
  lastVerifiedAt  DateTime? @map("last_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  identities SsoIdentity[]

  @@map("sso_connections")
}

/// Links an identity-provider subject to a DealFlow user, per workspace.
model SsoIdentity {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  connectionId String   @map("connection_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  subject      String
  lastLoginAt  DateTime @default(now()) @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection SsoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, subject])
  @@index([tenantId, userId])
  @@map("sso_identities")
}

/// Bearer tokens for SCIM 2.0 provisioning. Only SHA-256 hashes are stored.
model ScimToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  tokenHash   String    @unique @map("token_hash")
  /// First characters of the token, shown so admins can tell tokens apart.
  prefix      String
  createdById String?   @map("created_by_id") @db.Uuid
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

