// SampForce database schema.
// Conventions:
//   * MongoDB (a replica set, for transactions). Every workspace-owned collection has a non-null tenant_id, and the
//     workspace guard in src/scope.ts holds every query to the current workspace (ADR 0058, docs/SECURITY_MODEL.md).
//   * Indexes, including partial and case-insensitive ones, are created by src/setup.ts from this file
//     (`pnpm db:setup`); there are no migrations.
//   * Global collections (users, sessions, plans) are only touched by the auth and billing services.
//   * Soft deletion uses deleted_at; hard deletion is reserved for data-deletion workflows.
//   * Money is a double rounded to its old NUMERIC scale on every write (src/money.ts), alongside an ISO-4217
//     currency code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Platform (global) ─────────────────────────────

/// Named counters: sequential numbers (offline invoice numbers) and transaction locks (a quote number per workspace
/// is max + 1 under a lock). Replaces PostgreSQL sequences and advisory locks (ADR 0058). The id names the counter
/// and, where it matters, the workspace.
model Counter {
  id    String @id @map("_id")
  value Int    @default(0)

  @@map("counters")
}

model Plan {
  code                    String   @id @map("_id")
  name                    String
  monthlyPriceCents       Int?     @map("monthly_price_cents")
  annualMonthlyPriceCents Int?     @map("annual_monthly_price_cents")
  entitlements            Json
  isPublic                Boolean  @default(true) @map("is_public")
  /// Created by the Console Admin (ADR 0071) rather than shipped; its code starts with "custom_".
  custom                  Boolean  @default(false)
  /// What the Console Admin sells the plan for and how (description, price, billing frequency, support level,
  /// duration, renewal and upgrade settings). Shape: ConsolePlanTerms in @dealflow/types.
  terms                   Json?
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

/// Console rules for the workspaces of every client on a plan (workspace redesign W3). Shape: WorkspaceRules in
/// @dealflow/types. No row = no extra limits.
model PlanWorkspaceRules {
  planCode  String   @id @map("_id")
  rules     Json
  updatedBy String   @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("plan_workspace_rules")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id               String     @id @default(uuid()) @map("_id")
  email            String     @unique
  name             String
  /// Work phone (W5), from the workspace invitation or the profile.
  phone            String?
  passwordHash     String     @map("password_hash")
  status           UserStatus @default(ACTIVE)
  emailVerifiedAt  DateTime?  @map("email_verified_at")
  lastLoginAt      DateTime?  @map("last_login_at")
  /// Consecutive failed sign-in attempts (password or second factor); reset on success.
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until")
  /// TOTP shared secret, sealed with SecretBox. Set during enrolment; active once mfaEnabledAt is set.
  mfaSecretEnc     String?    @map("mfa_secret_enc")
  mfaEnabledAt     DateTime?  @map("mfa_enabled_at")
  /// Last accepted TOTP time step, so a code cannot be replayed.
  mfaLastStep      BigInt?    @map("mfa_last_step")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  sessions           Session[]
  memberships        Membership[]
  recoveryCodes      MfaRecoveryCode[]
  resetTokens        PasswordResetToken[]
  gamificationAwards GamificationAward[]
  preferences        UserPreference?
  notificationPrefs  NotificationPreference?
  regional           UserRegionalSetting?
  contactTimes       UserContactTimes?
  savedThemes        UserSavedTheme[]
  navigation         WorkspaceNavigation[]
  savedViews         SavedView[]
  managedTerritories Territory[]
  photo              UserPhoto?
  profile            UserProfile?

  @@map("users")
}

/// A person's profile photo (ADR 0072, M6). One per person, shown in every organisation they belong to (where the
/// organisation shows photos). Kept apart from the user so lists never load image bytes.
/// A client organisation's logo, set in the Console (ADR 0074, C4). Keyed by the client, not by `tenantId`, because
/// it is platform data about the client rather than a record inside its workspace.
model ClientLogo {
  clientId    String   @id @map("_id")
  contentType String   @map("content_type")
  data        Bytes
  sizeBytes   Int      @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("client_logos")
}

/// An operator's change to the city list behind the location pickers (ADR 0074, C4): a city the shipped data lacks
/// (originalName null) or a new name for one it has. Applied over apps/api/assets/geo on every look-up.
model GeoCityEdit {
  id           String   @id @default(uuid()) @map("_id")
  countryCode  String   @map("country_code")
  /// The region (state or province) code from the shipped data; null when the city has none.
  regionCode   String?  @map("region_code")
  name         String
  /// The shipped name this renames; null for a city an operator added.
  originalName String?  @map("original_name")
  operatorId   String   @map("operator_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([countryCode])
  @@map("geo_city_edits")
}

model UserPhoto {
  userId      String   @id @map("_id")
  contentType String   @map("content_type")
  data        Bytes
  sizeBytes   Int      @map("size_bytes")
  /// Pixel size of the larger side.
  width       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_photos")
}

/// A person's own profile (ADR 0086): headline, quote, bio, LinkedIn, "ask me about" tags, a cover and their current
/// mood. One per person, like the photo, and shown to the people in each organisation they belong to. The name and
/// phone stay on the user.
model UserProfile {
  userId        String    @id @map("_id")
  headline      String?
  quote         String?
  bio           String?
  linkedinUrl   String?   @map("linkedin_url")
  cover         String?
  tags          String[]  @default([])
  moodEmoji     String?   @map("mood_emoji")
  moodText      String?   @map("mood_text")
  moodSetAt     DateTime? @map("mood_set_at")
  /// The mood clears itself after this time; null keeps it until it is changed.
  moodExpiresAt DateTime? @map("mood_expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_profiles")
}

/// A person's own interface settings (theme, density, motion...). Follows the person across devices and workspaces.
model UserPreference {
  userId     String   @id @map("_id")
  appearance Json
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_preferences")
}

/// A person's own notification settings (ADR 0075): the chime, its volume, muted categories and browser or phone
/// alerts. Follows the person across devices and workspaces.
model NotificationPreference {
  userId     String   @id @map("_id")
  sound      Boolean  @default(true)
  volume     Int      @default(40)
  mutedSound String[] @map("muted_sound")
  desktop    Boolean  @default(false)
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("notification_preferences")
}

/// A person's language and regional formats. Per person, like UserPreference, so it follows them across workspaces.
model UserRegionalSetting {
  userId       String   @id @map("_id")
  language     String   @default("en")
  formatLocale String?  @map("format_locale")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_regional_settings")
}

/// The person's own time zone and calling hours for "best time to connect" (ADR 0089). Follows them across workspaces.
model UserContactTimes {
  userId               String   @id @map("_id")
  timeZone             String   @map("time_zone")
  start                String
  end                  String
  confirmBeforeContact Boolean  @default(true) @map("confirm_before_contact")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_contact_times")
}

/// Named custom themes a person saved in the Theme Studio.
model UserSavedTheme {
  id        String   @id @default(uuid()) @map("_id")
  userId    String   @map("user_id")
  name      String
  settings  Json
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, name])
  @@map("user_saved_themes")
}

/// A person's own navigation in one workspace: pinned pages and records, sidebar order and hidden modules.
/// Recently visited pages are not recorded (2026-11-22); setup removes any old `recent` field. The workspace guard limits documents to the current workspace AND the current user.
model WorkspaceNavigation {
  id              String   @id @default(uuid()) @map("_id")
  tenantId        String   @map("tenant_id")
  userId          String   @map("user_id")
  pinned          Json     @default("[]")
  moduleOrder     String[] @default([]) @map("module_order")
  hiddenModules   String[] @default([]) @map("hidden_modules")
  /// Command Center widgets, sizes and filters (dashboardLayoutSchema); null means the default layout.
  dashboardLayout Json?    @map("dashboard_layout")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, userId])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([userId])
  @@map("workspace_navigation")
}

/// A saved data table view (columns, widths, sort, filters, density) for one list. Visible to its creator, and to the
/// whole workspace when shared; only the creator can change or delete it (enforced by the workspace guard).
model SavedView {
  id        String   @id @default(uuid()) @map("_id")
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  entity    String
  name      String
  shared    Boolean  @default(false)
  config    Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, userId, entity, name])
  @@index([tenantId, entity])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([userId])
  @@map("saved_views")
}

/// A sales territory: a named set of countries. A deal belongs to the territory that holds its company's country.
model Territory {
  id          String   @id @default(uuid()) @map("_id")
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  managerId   String?  @map("manager_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  manager   User?              @relation(fields: [managerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  countries TerritoryCountry[]

  @@unique([tenantId, name])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([managerId])
  @@map("territories")
}

/// A country belongs to at most one territory per workspace.
model TerritoryCountry {
  id          String @id @default(uuid()) @map("_id")
  tenantId    String @map("tenant_id")
  territoryId String @map("territory_id")
  country     String

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  territory Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([territoryId, country])
  @@unique([tenantId, country])
  @@map("territory_countries")
}

/// One-time password reset links. Only a SHA-256 hash of the token is stored; a link works once, for a short time.
model PasswordResetToken {
  id        String    @id @default(uuid()) @map("_id")
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

/// Refresh-token sessions. Tokens are stored as SHA-256 hashes and rotated on every refresh.
model Session {
  id                 String    @id @default(uuid()) @map("_id")
  userId             String    @map("user_id")
  activeTenantId     String    @map("active_tenant_id")
  refreshTokenHash   String    @unique @map("refresh_token_hash")
  userAgent          String?   @map("user_agent")
  ipAddress          String?   @map("ip_address")
  expiresAt          DateTime  @map("expires_at")
  revokedAt          DateTime? @map("revoked_at")
  replacedById       String?   @map("replaced_by_id")
  /// "password", "mfa" (password + second factor) or "sso".
  authMethod         String    @default("password") @map("auth_method")
  /// Set for single sign-on sessions: the session can only ever act in this workspace.
  ssoTenantId        String?   @map("sso_tenant_id")
  /// Browser extension connections: the SHA-256 hash of the extension's token. These sessions never refresh.
  extensionTokenHash String?   @unique @map("extension_token_hash")
  /// The name the person gave a browser extension connection.
  extensionName      String?   @map("extension_name")
  /// "MOBILE" for the SampForce phone app (ADR 0072); null for the web. Copied onto every rotated session.
  client             String?
  /// The phone this session belongs to (MobileDevice id), for mobile sessions.
  deviceId           String?   @map("device_id")
  lastUsedAt         DateTime? @map("last_used_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([deviceId])
  @@map("sessions")
}

/// One-time recovery codes for a user's second factor. Only SHA-256 hashes are stored.
model MfaRecoveryCode {
  id        String    @id @default(uuid()) @map("_id")
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, codeHash])
  @@map("mfa_recovery_codes")
}

/// A one-time pass proving the person typed their password (or two-step code) moments ago. Every destructive route
/// asks for one (password confirmation): it is bound to the session that asked, works once and lapses after five
/// minutes. Only a SHA-256 hash of the pass is stored. `principalKind` is USER for workspace people, OPERATOR for the
/// Console.
model PasswordConfirmation {
  id            String    @id @default(uuid()) @map("_id")
  tokenHash     String    @unique @map("token_hash")
  principalKind String    @map("principal_kind")
  principalId   String    @map("principal_id")
  sessionId     String?   @map("session_id")
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([principalKind, principalId, createdAt])
  @@map("password_confirmations")
}

/// A wrong password (or code) typed to confirm a destructive action. Five within fifteen minutes pause the check.
model PasswordCheckFailure {
  id            String   @id @default(uuid()) @map("_id")
  principalKind String   @map("principal_kind")
  principalId   String   @map("principal_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([principalKind, principalId, createdAt])
  @@map("password_check_failures")
}

// ───────────────────────────── Tenancy ─────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
}

model Tenant {
  portalSettings        PortalSettings?
  portalUsers           PortalUser[]
  forecastSettings      ForecastSettings?
  voiceNotes            VoiceNote[]
  id                    String            @id @default(uuid()) @map("_id")
  name                  String
  slug                  String            @unique
  status                TenantStatus      @default(ACTIVE)
  brandColor            String?           @map("brand_color")
  defaultCurrency       String            @default("USD") @map("default_currency")
  defaultTimezone       String            @default("UTC") @map("default_timezone")
  defaultLocale         String            @default("en-US") @map("default_locale")
  /// True only for development/demo workspaces populated by the seed script.
  isDemo                Boolean           @default(false) @map("is_demo")
  /// Set when an owner hides the getting-started checklist.
  onboardingDismissedAt DateTime?         @map("onboarding_dismissed_at")
  /// Members must turn on two-step verification before they can use the workspace.
  requireMfa            Boolean           @default(false) @map("require_mfa")
  /// Mirrors sso_connections.enabled AND enforced, readable wherever the tenant row is (sign-in, switcher).
  ssoEnforced           Boolean           @default(false) @map("sso_enforced")
  /// Workspace default appearance (theme engine settings) for members who have not picked their own.
  defaultAppearance     Json?             @map("default_appearance")
  /// Company lead numbers (FRFS01...): the prefix and the minimum digits. Null prefix = the workspace initials.
  leadNumberPrefix      String?           @map("lead_number_prefix")
  leadNumberDigits      Int               @default(2) @map("lead_number_digits")
  /// Revenue attribution rule (ADR 0063, attributionRuleSchema in @dealflow/types); null = the whole deal to its closer.
  revenueAttribution    Json?             @map("revenue_attribution")
  /// Company details the Console keeps for the client (ADR 0074, C4). Country is ISO 3166-1 alpha-2; region is the
  /// GeoNames first-level code (a state or province) and city its name.
  legalName             String?           @map("legal_name")
  website               String?
  industry              String?
  countryCode           String?           @map("country_code")
  regionCode            String?           @map("region_code")
  city                  String?
  addressLine1          String?           @map("address_line1")
  addressLine2          String?           @map("address_line2")
  postalCode            String?           @map("postal_code")
  contactName           String?           @map("contact_name")
  contactEmail          String?           @map("contact_email")
  contactPhone          String?           @map("contact_phone")
  /// The client's readable number, shown as SF-000123; given once, in order, from the counter "client.customer".
  customerNumber        Int?              @map("customer_number")
  /// The latest health score (ADR 0074, C5): 0-100, its band (HEALTHY, AT_RISK, CRITICAL) and when the worker
  /// measured it. The signals behind it are in client_health_daily.
  healthScore           Int?              @map("health_score")
  healthBand            String?           @map("health_band")
  healthAt              DateTime?         @map("health_at")
  /// Who the organisation is, for AI sales emails (ADR 0078): salesProfileSchema in @dealflow/types. The Super
  /// Workspace keeps it; every workspace in the organisation writes with it. Null = never set.
  salesProfile          Json?             @map("sales_profile")
  salesProfileUpdatedAt DateTime?         @map("sales_profile_updated_at")
  salesProfileUpdatedBy String?           @map("sales_profile_updated_by")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  deletedAt             DateTime?         @map("deleted_at")
  /// Closing the company (workspace redesign W7): who closed it and when. The status is PENDING_DELETION from then
  /// on, so nobody can sign in; the Console can reopen it until eraseAfter, when the worker erases its data.
  closedAt              DateTime?         @map("closed_at")
  closedById            String?           @map("closed_by_id")
  closeReason           String?           @map("close_reason")
  eraseAfter            DateTime?         @map("erase_after")
  /// Set once the worker has erased the company's data; the row stays (deletedAt set) as the record that it existed.
  erasedAt              DateTime?         @map("erased_at")

  subscription           Subscription?
  navigation             WorkspaceNavigation[]
  savedViews             SavedView[]
  territories            Territory[]
  featureOverrides       TenantFeatureOverride[]
  mobileAccess           MobileAccess?
  mobileDevices          MobileDevice[]
  mobilePushes           MobilePush[]
  announcements          Announcement[]
  mobileConfig           MobileConfig?
  mobileConfigVersions   MobileConfigVersion[]
  territoryCountries     TerritoryCountry[]
  roles                  Role[]
  memberships            Membership[]
  teams                  Team[]
  auditLogs              AuditLog[]
  companies              Company[]
  contacts               Contact[]
  leads                  Lead[]
  pipelines              Pipeline[]
  stages                 PipelineStage[]
  opportunities          Opportunity[]
  activities             Activity[]
  tasks                  Task[]
  customFields           CustomField[]
  customFieldFiles       CustomFieldFile[]
  crmOptions             CrmOption[]
  crmSettings            CrmSettings?
  invitations            Invitation[]
  domainEvents           DomainEvent[]
  workflows              Workflow[]
  workflowVersions       WorkflowVersion[]
  workflowExecutions     WorkflowExecution[]
  workflowSteps          WorkflowStep[]
  approvals              ApprovalRequest[]
  notifications          Notification[]
  webhooks               Webhook[]
  apiKeys                ApiKey[]
  webhookDeliveries      WebhookDelivery[]
  integrationConnections IntegrationConnection[]
  emailMessages          EmailMessage[]
  meetings               Meeting[]
  aiSettings             AiSettings?
  aiRuns                 AiRun[]
  aiUsage                AiUsage[]
  aiRecommendations      AiRecommendation[]
  forecastSnapshots      ForecastSnapshot[]
  commercialSettings     CommercialSettings?
  products               Product[]
  priceBooks             PriceBook[]
  priceBookEntries       PriceBookEntry[]
  taxRates               TaxRate[]
  quotes                 Quote[]
  quoteLines             QuoteLine[]
  contracts              Contract[]
  campaigns              Campaign[]
  segments               Segment[]
  leadForms              LeadForm[]
  formSubmissions        FormSubmission[]
  exchangeRates          ExchangeRate[]
  salesTargets           SalesTarget[]
  escalations            Escalation[]
  companyHealth          CompanyHealth[]
  gamificationSettings   GamificationSettings?
  gamificationBadges     GamificationBadge[]
  gamificationAwards     GamificationAward[]
  gamificationContests   GamificationCompetition[]
  websiteEnquiries       WebsiteEnquiry[]
  prospectLists          ProspectList[]
  prospects              Prospect[]
  prospectOutreach       ProspectOutreach[]
  prospectImports        ProspectImport[]
  providerUsage          ProviderUsage[]
  prospectSettings       ProspectSettings?
  companyHealthDays      CompanyHealthDaily[]
  dealHealthScores       DealHealthScore[]
  dealHealthDays         DealHealthDaily[]
  nextActionDecisions    NextActionDecision[]
  invoices               Invoice[]
  billingEvents          BillingEvent[]
  emailTemplates         EmailTemplate[]
  sequences              Sequence[]
  sequenceEnrollments    SequenceEnrollment[]
  sequenceMessages       SequenceMessage[]
  emailEvents            EmailEvent[]
  emailSuppressions      EmailSuppression[]
  supportGrants          SupportGrant[]
  reports                Report[]
  dashboards             Dashboard[]
  dealStageEvents        DealStageEvent[]
  ssoConnection          SsoConnection?
  ssoIdentities          SsoIdentity[]
  scimTokens             ScimToken[]
  finderLookups          FinderLookup[]
  emailVariables         EmailVariable[]
  emailThreads           EmailThread[]
  emailThreadNotes       EmailThreadNote[]
  integrationSyncLogs    IntegrationSyncLog[]
  meetingRecords         MeetingRecord[]
  appConnections         AppConnection[]
  appEvents              AppEvent[]
  zoomMeetings           ZoomMeeting[]
  signatureEnvelopes     SignatureEnvelope[]
  quotePayments          QuotePayment[]
  whatsappMessages       WhatsappMessage[]
  whatsappConsents       WhatsappConsent[]
  smsMessages            SmsMessage[]
  smsConsents            SmsConsent[]
  departments            Department[]
  designations           Designation[]
  crmStatuses            CrmStatus[]
  companyBranches        CompanyBranch[]
  leadOwnerChanges       LeadOwnerChange[]
  companyFiles           CompanyFile[]
  companyLogos           CompanyLogo[]
  companyEnrichments     CompanyEnrichment[]
  leadDrafts             LeadDraft[]
  sampbidxTransfers      SampbidxTransfer[]
  sampbidxAttachments    SampbidxAttachment[]
  contactStageChanges    ContactStageChange[]
  sampbidxClients        SampbidxClient[]
  rfqs                   Rfq[]
  chatConversations      ChatConversation[]
  supportTickets         SupportTicket[]
  supportTicketMessages  SupportTicketMessage[]
  supportFiles           SupportTicketAttachment[]
  helpFeedback           HelpFeedback[]
  helpSettings           HelpSettings?
  chatMembers            ChatMember[]
  chatMessages           ChatMessage[]
  chatAttachments        ChatAttachment[]
  chatSignals            ChatSignal[]
  chatPresence           ChatPresence[]

  @@index([createdAt])
  @@index([customerNumber])
  @@index([healthBand])
  @@map("tenants")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  /// Payment failed and the grace period ended: paid allowances fall back to Free until paid.
  UNPAID
}

enum BillingProvider {
  NONE
  STRIPE
  RAZORPAY
  /// Paid by bank transfer or another offline method against a SampForce invoice; an operator records the payment.
  OFFLINE
}

enum BillingInterval {
  MONTH
  YEAR
}

model Subscription {
  id                     String             @id @default(uuid()) @map("_id")
  tenantId               String             @unique @map("tenant_id")
  planCode               String             @map("plan_code")
  status                 SubscriptionStatus @default(ACTIVE)
  billingInterval        BillingInterval    @default(MONTH) @map("billing_interval")
  seats                  Int                @default(1)
  currentPeriodStart     DateTime           @default(now()) @map("current_period_start")
  currentPeriodEnd       DateTime?          @map("current_period_end")
  trialEndsAt            DateTime?          @map("trial_ends_at")
  /// A workspace gets one free trial of a paid plan.
  trialUsedAt            DateTime?          @map("trial_used_at")
  provider               BillingProvider    @default(NONE)
  /// Provider references only. Card and bank details stay with the provider and never reach SampForce.
  providerCustomerId     String?            @map("provider_customer_id")
  providerSubscriptionId String?            @unique @map("provider_subscription_id")
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  pastDueSince           DateTime?          @map("past_due_since")
  /// Invoice-paid plans: when billing managers were last reminded to renew (once per period end).
  renewalRemindedAt      DateTime?          @map("renewal_reminded_at")
  /// Workspace limits (ADR 0071) set by the Console Admin for this client; null = the plan's limit.
  maxManagerWorkspaces   Int?               @map("max_manager_workspaces")
  maxExecutiveWorkspaces Int?               @map("max_executive_workspaces")
  /// Console rules for this client's workspaces (workspace redesign W3): only what differs from its plan's rules.
  /// Shape: WorkspaceRulesOverride in @dealflow/types; null = the plan's rules.
  workspaceRules         Json?              @map("workspace_rules")
  /// Sales-led terms the Console Admin agreed with this client (ADR 0071): price for one billing period in minor
  /// units, its currency, whether it has been paid, the term in months and whether it renews by itself.
  priceCents             Int?               @map("price_cents")
  currency               String?
  paymentStatus          String?            @map("payment_status")
  durationMonths         Int?               @map("duration_months")
  autoRenew              Boolean            @default(true) @map("auto_renew")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  plan   Plan   @relation(fields: [planCode], references: [code], onUpdate: NoAction)

  @@index([provider, providerCustomerId])
  @@index([pastDueSince])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([planCode])
  @@map("subscriptions")
}

model Role {
  id                String   @id @default(uuid()) @map("_id")
  tenantId          String   @map("tenant_id")
  key               String
  name              String
  description       String?
  permissions       String[]
  isSystem          Boolean  @default(false) @map("is_system")
  /// Which company leads, employees and inbound leads people with this role see: OWN (their own and unassigned),
  /// TEAM (also everyone reporting to them, directly or not) or ALL.
  recordScope       String   @default("ALL") @map("record_scope")
  /// Whether they see contact details (emails, phones, links, notes) of visible records someone else owns.
  viewOthersDetails Boolean  @default(true) @map("view_others_details")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  memberships Membership[]
  invitations Invitation[]

  @@unique([tenantId, key])
  @@map("roles")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

model Membership {
  id                 String           @id @default(uuid()) @map("_id")
  tenantId           String           @map("tenant_id")
  userId             String           @map("user_id")
  roleId             String           @map("role_id")
  status             MembershipStatus @default(ACTIVE)
  /// SCIM externalId from the workspace's identity provider, when provisioned through SCIM.
  externalId         String?          @map("external_id")
  /// Organisation structure (company-centric CRM): job title from the workspace's designations, department and the
  /// person they report to (a user id).
  designationId      String?          @map("designation_id")
  departmentId       String?          @map("department_id")
  reportingManagerId String?          @map("reporting_manager_id")
  /// The workspace (ADR 0071) this person works in: a Super, Manager or Executive Workspace of the organisation.
  /// Null = the organisation's Super Workspace (everyone who joined before the hierarchy existed).
  workspaceNodeId    String?          @map("workspace_node_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role        Role         @relation(fields: [roleId], references: [id], onUpdate: NoAction)
  teamMembers TeamMember[]

  @@unique([tenantId, userId])
  @@unique([tenantId, externalId])
  @@index([userId])
  @@index([tenantId, workspaceNodeId])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([roleId])
  @@map("memberships")
}

/// The four-level workspace hierarchy (ADR 0071). The organisation is the tenant; inside it one SUPER workspace is the
/// root, MANAGER workspaces hang under it and EXECUTIVE workspaces under a manager or the root. All of them share the
/// organisation's CRM data; a workspace narrows what its people may see and do. A child's features and actions are
/// always its own grant intersected with its parent's, recomputed on every request, so a revocation applies at once.
model WorkspaceNode {
  id                   String    @id @default(uuid()) @map("_id")
  tenantId             String    @map("tenant_id")
  /// SUPER, MANAGER or EXECUTIVE.
  level                String
  name                 String
  /// The name lower-cased and trimmed: an organisation never has two workspaces of the same name.
  nameKey              String    @map("name_key")
  parentId             String?   @map("parent_id")
  /// The designation shown with the workspace (Client Administrator, Sales Manager, Sales Executive by default).
  designation          String
  /// Feature keys the parent granted (the root ignores it: it gets everything the subscription includes).
  features             String[]
  /// Actions the parent granted, per module or feature key ({ "CRM": ["view", "create"] }). On the root this is the
  /// ceiling the Console Admin sets for the client; null on the root = no ceiling.
  actions              Json?
  /// Root: whether the Console allows the Super Workspace to create Executive Workspaces. Manager: whether the Super
  /// Workspace allows it to create Executive Workspaces under itself.
  canCreateExecutives  Boolean   @default(false) @map("can_create_executives")
  /// Manager: whether it may see the sales reports of the other Manager Workspaces (never their records).
  canViewOtherManagers Boolean   @default(false) @map("can_view_other_managers")
  /// Manager: whether the Super Workspace lets it read the audit log of its own team (never anyone else's).
  canViewAuditLog      Boolean   @default(false) @map("can_view_audit_log")
  /// Manager or Executive: whether its parent lets it chat with workspaces of the same level (other managers; for an
  /// executive, the other executives of the same team). Both sides need it.
  canChatWithPeers     Boolean   @default(false) @map("can_chat_with_peers")
  createdById          String?   @map("created_by_id")
  /// Wizard details (W5): the team or department, a short description, and for a Manager Workspace whose records it
  /// sees: TEAM (its own and its executives'; null means TEAM) or OWN (only its own people's).
  department           String?
  description          String?
  accessLevel          String?   @map("access_level")
  /// Set while deactivated (W4): its people, and everyone in the workspaces below it, cannot work until it is
  /// reactivated. Grants are kept, so reactivating restores things exactly.
  deactivatedAt        DateTime? @map("deactivated_at")
  deactivatedById      String?   @map("deactivated_by_id")
  deactivationReason   String?   @map("deactivation_reason")
  /// Temporarily blacklisted until this time: its people, and everyone below it, are stopped like a deactivated
  /// workspace, and the block lifts by itself when the time passes (or earlier, when it is reactivated).
  blacklistedUntil     DateTime? @map("blacklisted_until")
  blacklistedById      String?   @map("blacklisted_by_id")
  blacklistReason      String?   @map("blacklist_reason")
  /// Set ("operator:<email>") when the Console deactivated or blacklisted it: only the Console can lift that.
  lockedByConsole      String?   @map("locked_by_console")
  /// The people a delete took out of it (W4), so restoring it brings exactly them back.
  removedMemberIds     String[]  @map("removed_member_ids")
  /// Set when deleted (W4): the node stays, renamed out of the way, so history and audit entries keep their name.
  archivedAt           DateTime? @map("archived_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, nameKey])
  @@index([tenantId, parentId])
  @@index([tenantId, level])
  @@index([level, createdAt])
  @@map("workspace_nodes")
}

/// A target set for a workspace (ADR 0071): a metric over a period, set by the Super Workspace or handed down by a
/// manager from its own target. Achievement is counted from the records of the workspace's people and those below it.
model WorkspaceTarget {
  id              String    @id @default(uuid()) @map("_id")
  tenantId        String    @map("tenant_id")
  workspaceNodeId String    @map("workspace_node_id")
  /// LEADS, CALLS, DEALS_WON or REVENUE.
  metric          String
  /// DAILY, WEEKLY, MONTHLY, QUARTERLY or CUSTOM.
  period          String
  startsAt        DateTime  @map("starts_at")
  /// The day after the last day (periods are [startsAt, endsAt)).
  endsAt          DateTime  @map("ends_at")
  amount          Float
  note            String?
  /// The target this one was split from, when a manager (or the Super Workspace) hands part of a target down.
  parentTargetId  String?   @map("parent_target_id")
  setById         String?   @map("set_by_id")
  /// SUPER or MANAGER: which level set it.
  setByLevel      String    @map("set_by_level")
  archivedAt      DateTime? @map("archived_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, workspaceNodeId])
  @@index([tenantId, parentTargetId])
  @@map("workspace_targets")
}

model Team {
  id          String   @id @default(uuid()) @map("_id")
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  members TeamMember[]

  @@unique([tenantId, name])
  @@map("teams")
}

model TeamMember {
  id           String @id @default(uuid()) @map("_id")
  tenantId     String @map("tenant_id")
  teamId       String @map("team_id")
  membershipId String @map("membership_id")

  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([teamId, membershipId])
  @@index([tenantId])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([membershipId])
  @@map("team_members")
}

enum ActorType {
  USER
  SYSTEM
  AI_AGENT
  PLATFORM_ADMIN
}

/// Append-only. The application role is granted INSERT and SELECT only.
model AuditLog {
  id          String    @id @default(uuid()) @map("_id")
  tenantId    String    @map("tenant_id")
  actorType   ActorType @default(USER) @map("actor_type")
  actorUserId String?   @map("actor_user_id")
  action      String
  /// DONE for a change that happened; REFUSED for an attempt the system turned down (no permission, wrong password).
  outcome     String    @default("DONE")
  entityType  String?   @map("entity_type")
  entityId    String?   @map("entity_id")
  metadata    Json      @default("{}")
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  requestId   String?   @map("request_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

// ───────────────────────────── Core CRM ─────────────────────────────

model Company {
  id                String    @id @default(uuid()) @map("_id")
  tenantId          String    @map("tenant_id")
  name              String
  domain            String?
  industry          String?
  country           String?
  ownerId           String?   @map("owner_id")
  parentCompanyId   String?   @map("parent_company_id")
  customFields      Json      @default("{}") @map("custom_fields")
  /// Company lead number (prefix + sequence, e.g. FRFS07). Assigned once, never reused, never edited by people.
  leadNumber        String?   @map("lead_number")
  leadSeq           Int?      @map("lead_seq")
  statusId          String?   @map("status_id")
  statusChangedAt   DateTime? @map("status_changed_at")
  statusChangedById String?   @map("status_changed_by_id")
  /// The deal made (or closed as won) when the company became a client; one per win, so a second win reuses it (ADR 0084).
  wonDealId         String?   @map("won_deal_id")
  wonAt             DateTime? @map("won_at")
  /// Who generated the lead; kept when ownership moves. ownerId is the current lead owner.
  createdById       String?   @map("created_by_id")
  updatedById       String?   @map("updated_by_id")
  managerId         String?   @map("manager_id")
  /// The internal point of contact for this lead (a workspace user), kept apart from the creator and the owner.
  pocUserId         String?   @map("poc_user_id")
  departmentId      String?   @map("department_id")
  teamId            String?   @map("team_id")
  linkedinUrl       String?   @map("linkedin_url")
  website           String?
  primaryEmail      String?   @map("primary_email")
  primaryPhone      String?   @map("primary_phone")
  overview          String?
  foundedYear       Int?      @map("founded_year")
  branchCount       Int?      @map("branch_count")
  companySize       String?   @map("company_size")
  companyType       String?   @map("company_type")
  headquarters      String?
  specialties       String?
  businessCategory  String?   @map("business_category")
  state             String?
  city              String?
  address           String?
  postalCode        String?   @map("postal_code")
  timezone          String?
  /// Office hours on the company's own clock { days, start, end, source } (ADR 0089); null = the country's usual day.
  workingHours      Json?     @map("working_hours")
  notes             String?
  /// Further addresses and links: [{ value, label?, primary }]. Primary entries are mirrored in the fields above.
  emails            Json      @default("[]")
  phones            Json      @default("[]")
  websites          Json      @default("[]")
  linkedinUrls      Json      @default("[]") @map("linkedin_urls")
  /// Further office addresses: [{ label?, country?, state?, city?, address?, postalCode? }].
  addresses         Json      @default("[]")
  /// Business Information from public sources or typed by people (ADR 0076).
  services          String[]
  products          String[]
  industriesServed  String[]  @map("industries_served")
  certifications    String[]
  founders          String[]
  employeeCount     Int?      @map("employee_count")
  legalName         String?   @map("legal_name")
  /// The parent named publicly (a CRM parent record is parentCompanyId).
  parentCompanyName String?   @map("parent_company_name")
  ownership         String?
  ceo               String?
  /// [{ name, title? }]
  leadership        Json      @default("[]")
  /// Active, Acquired, Merged, Dissolved or Inactive.
  operatingStatus   String?   @map("operating_status")
  contactPageUrl    String?   @map("contact_page_url")
  /// Official profiles: [{ platform, url }].
  socialLinks       Json      @default("[]") @map("social_links")
  /// Details with no column of their own: [{ label, value }].
  moreDetails       Json      @default("[]") @map("more_details")
  aiSummary         String?   @map("ai_summary")
  aiSummaryAt       DateTime? @map("ai_summary_at")
  /// Where each Business Information value came from: { field: { source, url, at, confidence, runId, items?, alternatives? } }.
  fieldSources      Json      @default("{}") @map("field_sources")
  /// Normalised keys for duplicate checks, kept by the API: lower-case name without legal suffixes, domains,
  /// lower-case emails, last ten phone digits, LinkedIn paths.
  nameKey           String?   @map("name_key")
  matchKeys         String[]  @map("match_keys")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parent        Company?             @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children      Company[]            @relation("CompanyHierarchy")
  contacts      Contact[]
  opportunities Opportunity[]
  activities    Activity[]
  contracts     Contract[]
  escalations   Escalation[]
  health        CompanyHealth?
  healthDays    CompanyHealthDaily[]

  portalUsers    PortalUser[]
  portalRequests PortalRequest[]

  branches     CompanyBranch[]
  ownerChanges LeadOwnerChange[]
  files        CompanyFile[]
  logo         CompanyLogo?
  enrichments  CompanyEnrichment[]
  tasks        Task[]
  rfqs         Rfq[]

  @@unique([tenantId, leadNumber])
  @@index([tenantId, name])
  @@index([tenantId, domain])
  @@index([tenantId, nameKey])
  @@index([tenantId, matchKeys])
  @@index([tenantId, statusId])
  @@index([tenantId, ownerId])
  @@index([tenantId, createdById])
  @@index([tenantId, leadSeq])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([parentCompanyId])
  @@map("companies")
}

model Contact {
  id                String           @id @default(uuid()) @map("_id")
  tenantId          String           @map("tenant_id")
  companyId         String?          @map("company_id")
  firstName         String           @map("first_name")
  lastName          String?          @map("last_name")
  email             String?
  phone             String?
  /// Last ten digits of `phone`, kept by the database client (packages/database/src/derived.ts) for duplicate checks.
  phoneDigits       String?          @map("phone_digits")
  /// `phone` as international digits (no + or 00) when it was written in international form; WhatsApp and SMS match on it.
  phoneIntl         String?          @map("phone_intl")
  jobTitle          String?          @map("job_title")
  country           String?
  timezone          String?
  /// This person's own office hours (ADR 0089); null = their company's hours.
  workingHours      Json?            @map("working_hours")
  ownerId           String?          @map("owner_id")
  marketingConsent  MarketingConsent @default(UNKNOWN) @map("marketing_consent")
  /// valid, risky, catch_all, invalid, unknown, bounced, needs_verification; null = never checked.
  emailStatus       String?          @map("email_status")
  /// 0-100, raised by email engagement rules in Automation Studio; null = never scored.
  engagementScore   Int?             @map("engagement_score")
  consentSource     String?          @map("consent_source")
  consentUpdatedAt  DateTime?        @map("consent_updated_at")
  customFields      Json             @default("{}") @map("custom_fields")
  /// Employee / POC fields (company-centric CRM). jobTitle is the designation; ownerId the assigned executive.
  statusId          String?          @map("status_id")
  statusChangedAt   DateTime?        @map("status_changed_at")
  statusChangedById String?          @map("status_changed_by_id")
  department        String?
  linkedinUrl       String?          @map("linkedin_url")
  state             String?
  city              String?
  remarks           String?
  nextFollowUpAt    DateTime?        @map("next_follow_up_at")
  /// The employee's communication stage (a CrmStatus of kind STAGE, ADR 0080), apart from the employee status.
  stageId           String?          @map("stage_id")
  stageChangedAt    DateTime?        @map("stage_changed_at")
  stageChangedById  String?          @map("stage_changed_by_id")
  /// Marked as an RFQ contributor by hand, for RFQs from before SampForce. Real RFQs make one without a mark.
  rfqContributorAt   DateTime?       @map("rfq_contributor_at")
  rfqContributorById String?         @map("rfq_contributor_by_id")
  /// The follow-up cadence (ADR 0083): when the first email reached the employee, and when and why it stopped.
  initialEmailAt     DateTime?       @map("initial_email_at")
  cadenceStoppedAt   DateTime?       @map("cadence_stopped_at")
  cadenceStopReason  String?         @map("cadence_stop_reason")
  createdById       String?          @map("created_by_id")
  updatedById       String?          @map("updated_by_id")
  /// [{ value, label?, primary }]; the primary entries are mirrored in email and phone.
  emails            Json             @default("[]")
  phones            Json             @default("[]")
  matchKeys         String[]         @map("match_keys")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  deletedAt         DateTime?        @map("deleted_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company       Company?      @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  opportunities Opportunity[]
  activities    Activity[]
  tasks         Task[]

  portalUsers      PortalUser[]
  prospects        Prospect[]
  whatsappMessages WhatsappMessage[]
  whatsappConsents WhatsappConsent[]
  smsMessages      SmsMessage[]
  smsConsents      SmsConsent[]

  @@index([tenantId, email])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, phoneDigits])
  @@index([tenantId, phoneIntl])
  @@index([tenantId, companyId])
  @@index([tenantId, matchKeys])
  @@index([tenantId, statusId])
  @@index([tenantId, stageId])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([companyId])
  @@map("contacts")
}

/// One office of a company lead. Always belongs to its parent company.
model CompanyBranch {
  id            String   @id @default(uuid()) @map("_id")
  tenantId      String   @map("tenant_id")
  companyId     String   @map("company_id")
  name          String
  country       String?
  state         String?
  city          String?
  address       String?
  postalCode    String?  @map("postal_code")
  email         String?
  phone         String?
  contactPerson String?  @map("contact_person")
  website       String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, companyId])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([companyId])
  @@map("company_branches")
}

/// Each change of a company lead's owner: who had it, who has it now, who made the change and why.
model LeadOwnerChange {
  id         String   @id @default(uuid()) @map("_id")
  tenantId   String   @map("tenant_id")
  companyId  String   @map("company_id")
  fromUserId String?  @map("from_user_id")
  toUserId   String?  @map("to_user_id")
  byUserId   String?  @map("by_user_id")
  /// LEAD_TRANSFER_REASONS, or null for the first assignment.
  reason     String?
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, companyId, createdAt(sort: Desc)])
  @@index([tenantId, toUserId, createdAt(sort: Desc)])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([companyId])
  @@map("lead_owner_changes")
}

/// A file kept with a company lead for the team (not shared with the client portal).
model CompanyFile {
  id           String   @id @default(uuid()) @map("_id")
  tenantId     String   @map("tenant_id")
  companyId    String   @map("company_id")
  name         String
  contentType  String   @map("content_type")
  sizeBytes    Int      @map("size_bytes")
  data         Bytes
  sha256       String
  uploadedById String?  @map("uploaded_by_id")
  /// Set when the file belongs to one RFQ of the company.
  rfqId        String?  @map("rfq_id")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, companyId, createdAt(sort: Desc)])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([companyId])
  @@map("company_files")
}

/// A company's logo (ADR 0070): found automatically from the company's website, or uploaded by someone. Kept apart
/// from the company so lists never load image bytes. The document doubles as the worker's queue item: PENDING with
/// a due nextRunAt means "look for a logo now".
/// Company auto-fill runs (ADR 0076): one per look-up, also the worker queue (PENDING + nextRunAt). `fills` records
/// every value the run wrote, so it can be undone.
model CompanyEnrichment {
  id            String    @id @default(uuid()) @map("_id")
  tenantId      String    @map("tenant_id")
  companyId     String    @map("company_id")
  /// PENDING, RUNNING, DONE, NOTHING_FOUND or FAILED.
  status        String
  /// CREATE, IMPORT, MANUAL or WEBSITE_CHANGED.
  trigger       String
  domain        String?
  requestedById String?   @map("requested_by_id")
  attempts      Int       @default(0)
  nextRunAt     DateTime? @map("next_run_at")
  /// [{ field, display, value, source, url, confidence, undone }]
  fills         Json      @default("[]")
  /// [{ url, kind }]
  sources       Json      @default("[]")
  error         String?
  finishedAt    DateTime? @map("finished_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, companyId, createdAt])
  @@index([status, nextRunAt])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([companyId])
  @@map("company_enrichments")
}

model CompanyLogo {
  id           String    @id @default(uuid()) @map("_id")
  tenantId     String    @map("tenant_id")
  companyId    String    @unique @map("company_id")
  /// AUTO (found from the website) or UPLOAD (someone chose the picture; never replaced automatically).
  source       String
  /// PENDING (waiting for the worker), FOUND, NOT_FOUND (the site has no usable icon) or FAILED (gave up after retries).
  status       String
  /// The domain the automatic logo was looked up for; a change of website looks again.
  domain       String?
  contentType  String?   @map("content_type")
  data         Bytes?
  sizeBytes    Int?      @map("size_bytes")
  /// Pixel size of the image (the larger side); null for SVG, which scales.
  width        Int?
  sourceUrl    String?   @map("source_url")
  attempts     Int       @default(0)
  nextRunAt    DateTime? @map("next_run_at")
  lastError    String?   @map("last_error")
  uploadedById String?   @map("uploaded_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, companyId])
  @@index([status, nextRunAt])
  @@map("company_logos")
}

/// A request for quotation from a company lead (ADR 0060, Phase 3). Numbered RFQ-0001.. per workspace. Receiving an
/// RFQ is not won business: only RFQs marked won, or the deals they turn into, count as revenue.
/// An RFQ, or an RFQ email, sent to the workspace's SampBidx (ADR 0061). One row per send; a retry reuses the row so
/// SampBidx sees the same Idempotency-Key. Email files are kept so a failed send can be retried.
model SampbidxTransfer {
  id              String    @id @default(uuid()) @map("_id")
  tenantId        String    @map("tenant_id")
  /// RFQ, MAILBOX_EMAIL, EMAIL_FILE, PASTED_EMAIL or CLIENT (a company sent as a SampBidx client, ADR 0080).
  kind            String
  title           String
  rfqId           String?   @map("rfq_id")
  companyId       String?   @map("company_id")
  emailMessageId  String?   @map("email_message_id")
  emailFrom       String?   @map("email_from")
  emailDate       DateTime? @map("email_date")
  /// The uploaded .eml/.msg file (EMAIL_FILE only).
  emailFileName   String?   @map("email_file_name")
  emailFileType   String?   @map("email_file_type")
  emailFileData   Bytes?    @map("email_file_data")
  /// The pasted email text (PASTED_EMAIL only), sent to SampBidx exactly as pasted.
  emailText       String?   @map("email_text")
  /// The company employee who sent the email (PASTED_EMAIL).
  contactId       String?   @map("contact_id")
  /// The "RFQ received" interaction logged for a pasted email, if any.
  activityId      String?   @map("activity_id")
  /// sha256 of the pasted text with spacing and case ignored, to catch the same email pasted twice.
  emailTextHash   String?   @map("email_text_hash")
  /// Where it was captured: company, contact, lead, deal, email or rfqs, and that record's id.
  sourceType      String?   @map("source_type")
  sourceId        String?   @map("source_id")
  /// Attachments added next to pasted text (sampbidx_attachments), sent as files.
  attachmentIds   String[]  @map("attachment_ids")
  /// Company files sent with an RFQ.
  fileIds         String[]  @map("file_ids")
  /// Names and sizes of everything sent, for the history list.
  files           Json      @default("[]")
  /// The employee chosen as the one who shared the RFQ (company sends, ADR 0080), and the details that went with
  /// the send, as checked on the preview, so the history shows exactly what SampBidx got.
  sentPayload     Json?     @map("sent_payload")
  note            String?
  /// SENDING, SENT or FAILED.
  delivery        String    @default("SENDING")
  attempts        Int       @default(0)
  lastError       String?   @map("last_error")
  remoteId        String?   @map("remote_id")
  remoteUrl       String?   @map("remote_url")
  remoteStatus    String?   @map("remote_status")
  remoteNote      String?   @map("remote_note")
  remoteUpdatedAt DateTime? @map("remote_updated_at")
  createdById     String    @map("created_by_id")
  sentAt          DateTime? @map("sent_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, rfqId])
  @@index([tenantId, companyId])
  @@index([tenantId, emailMessageId])
  @@index([tenantId, remoteId])
  @@index([tenantId, emailTextHash])
  @@map("sampbidx_transfers")
}

/// One change of an employee's communication stage (ADR 0080). Never edited or deleted: it is the stage history.
model ContactStageChange {
  id          String   @id @default(uuid()) @map("_id")
  tenantId    String   @map("tenant_id")
  contactId   String   @map("contact_id")
  companyId   String?  @map("company_id")
  fromStageId String?  @map("from_stage_id")
  toStageId   String   @map("to_stage_id")
  /// MANUAL, RFQ, FOLLOW_UP, INTERACTION, SAMPBIDX, RFQ_OUTCOME or CALL_SCHEDULED (STAGE_CHANGE_SOURCES).
  source      String
  note        String?
  rfqId       String?  @map("rfq_id")
  /// The person who changed it, or whose action (an RFQ, a follow-up, a send) moved it.
  changedById String?  @map("changed_by_id")
  at          DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, contactId, at(sort: Desc)])
  @@index([tenantId, companyId])
  @@map("contact_stage_changes")
}

/// A SampForce company as a client in SampBidx (ADR 0080): one per company, kept so the same client is updated,
/// never created twice. Each employee sent along is listed with SampBidx's id for them.
model SampbidxClient {
  id           String    @id @default(uuid()) @map("_id")
  tenantId     String    @map("tenant_id")
  companyId    String    @map("company_id")
  remoteId     String?   @map("remote_id")
  remoteUrl    String?   @map("remote_url")
  /// [{ contactId, remoteId }]
  contacts     Json      @default("[]")
  lastSyncedAt DateTime? @map("last_synced_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, companyId])
  @@map("sampbidx_clients")
}

/// A file added next to pasted RFQ email text, kept so the send (and any retry) carries it to SampBidx (ADR 0061).
model SampbidxAttachment {
  id          String   @id @default(uuid()) @map("_id")
  tenantId    String   @map("tenant_id")
  createdById String   @map("created_by_id")
  /// Set once a transfer uses it; unused uploads are removed after a day.
  transferId  String?  @map("transfer_id")
  name        String
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  sha256      String
  data        Bytes
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, transferId])
  @@index([tenantId, createdAt])
  @@map("sampbidx_attachments")
}

model Rfq {
  id              String    @id @default(uuid()) @map("_id")
  tenantId        String    @map("tenant_id")
  number          String
  seq             Int
  companyId       String    @map("company_id")
  contactId       String?   @map("contact_id")
  projectName     String    @map("project_name")
  description     String?
  methodology     String?
  /// ISO country code of the market, or free text such as "Multi-country".
  market          String?
  industry        String?
  targetAudience  String?   @map("target_audience")
  /// QUANTITATIVE or QUALITATIVE, and the service (CAWI, CATI, CAPI...), as SampBidx files a bid (ADR 0080).
  serviceCategory String?   @map("service_category")
  service         String?
  /// One row per country and target group, exactly as the client asked:
  /// [{ country, targetGroup, quota, loi, ir, cpi, description }]. Empty = the single market/sample/LOI/IR/CPI above.
  lines           Json      @default("[]")
  sampleSize      Int?      @map("sample_size")
  /// Length of interview in minutes, incidence rate in percent, cost per interview in `currency`.
  loi             Float?
  ir              Float?
  cpi             Float?
  totalQuotation  Float?    @map("total_quotation")
  currency        String    @default("USD")
  receivedAt      DateTime  @map("received_at")
  submittedAt     DateTime? @map("submitted_at")
  deadlineAt      DateTime? @map("deadline_at")
  /// RFQ_STATUSES in packages/types/src/company-work.ts.
  status          String    @default("RECEIVED")
  statusChangedAt DateTime? @map("status_changed_at")
  ownerId         String?   @map("owner_id")
  managerId       String?   @map("manager_id")
  expectedRevenue Float?    @map("expected_revenue")
  actualRevenue   Float?    @map("actual_revenue")
  outcomeReason   String?   @map("outcome_reason")
  /// The deal this RFQ turned into.
  opportunityId   String?   @map("opportunity_id")
  createdById     String?   @map("created_by_id")
  updatedById     String?   @map("updated_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  /// Custom field values (ADR 0062).
  customFields        Json      @default("{}") @map("custom_fields")
  /// Set when the deadline reminder went out, for the deadline it was sent for.
  deadlineReminderFor DateTime? @map("deadline_reminder_for")

  @@unique([tenantId, number])
  @@index([tenantId, companyId, receivedAt(sort: Desc)])
  @@index([tenantId, status, deadlineAt])
  @@index([tenantId, ownerId])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([companyId])
  @@map("rfqs")
}

/// A company lead being written in the "Create new lead" form, saved part-way. Private to the person writing it.
model LeadDraft {
  id        String   @id @default(uuid()) @map("_id")
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  title     String?
  step      Int      @default(0)
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, userId, updatedAt(sort: Desc)])
  @@map("lead_drafts")
}

model Department {
  id          String    @id @default(uuid()) @map("_id")
  tenantId    String    @map("tenant_id")
  name        String
  description String?
  position    Int       @default(0)
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, name])
  @@map("departments")
}

/// A job title such as "Business Development Manager". The tier picks the Command Center layout; what a person may
/// do still comes from their role.
model Designation {
  id          String    @id @default(uuid()) @map("_id")
  tenantId    String    @map("tenant_id")
  name        String
  /// EXECUTIVE, MANAGER or SENIOR.
  tier        String    @default("EXECUTIVE")
  description String?
  position    Int       @default(0)
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, name])
  @@map("designations")
}

/// Workspace-defined statuses with colours. kind: COMPANY or EMPLOYEE (more kinds follow with RFQs and deals).
model CrmStatus {
  id          String    @id @default(uuid()) @map("_id")
  tenantId    String    @map("tenant_id")
  kind        String
  name        String
  description String?
  /// #rrggbb
  color       String
  position    Int       @default(0)
  /// The status new records start in (one per kind).
  isDefault   Boolean   @default(false) @map("is_default")
  /// What the status means to reports: NEW, ACTIVE, CLIENT, CONCERN, ON_HOLD, LOST (null = ACTIVE).
  meaning     String?
  /// Communication stages (kind STAGE) only: the built-in stage it is (NEW_CONTACT, RFQ_RECEIVED, FOLLOW_UP_1...),
  /// which SampForce uses to move employees on by itself, and its phase (STAGE_PHASES) for filters and dashboards.
  key         String?
  phase       String?
  /// Deactivated statuses stay on the records that have them but cannot be picked.
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, kind, name])
  @@index([tenantId, kind, position])
  @@map("crm_statuses")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

model Lead {
  id                     String           @id @default(uuid()) @map("_id")
  tenantId               String           @map("tenant_id")
  fullName               String           @map("full_name")
  companyName            String?          @map("company_name")
  jobTitle               String?          @map("job_title")
  industry               String?
  email                  String?
  phone                  String?
  /// Last ten digits of `phone`, kept by the database client (packages/database/src/derived.ts) for duplicate checks.
  phoneDigits            String?          @map("phone_digits")
  country                String?
  city                   String?
  timezone               String?
  website                String?
  source                 String?
  campaignSource         String?          @map("campaign_source")
  /// First-touch campaign, set by hosted forms or by hand.
  campaignId             String?          @map("campaign_id")
  marketingConsent       MarketingConsent @default(UNKNOWN) @map("marketing_consent")
  /// valid, risky, catch_all, invalid, unknown, bounced, needs_verification; null = never checked.
  emailStatus            String?          @map("email_status")
  consentSource          String?          @map("consent_source")
  consentUpdatedAt       DateTime?        @map("consent_updated_at")
  estimatedValue         Float?           @map("estimated_value")
  currency               String?
  status                 LeadStatus       @default(NEW)
  /// Position of `status` in LeadStatus, kept by the database client so sorting follows the enum order.
  statusRank             Int?             @map("status_rank")
  engagementScore        Int?             @map("engagement_score")
  aiScore                Int?             @map("ai_score")
  tags                   String[]
  customFields           Json             @default("{}") @map("custom_fields")
  ownerId                String?          @map("owner_id")
  convertedAt            DateTime?        @map("converted_at")
  convertedContactId     String?          @map("converted_contact_id")
  convertedOpportunityId String?          @map("converted_opportunity_id")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")
  deletedAt              DateTime?        @map("deleted_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  campaign    Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  activities  Activity[]
  tasks       Task[]
  prospects   Prospect[]

  @@index([tenantId, status])
  @@index([tenantId, campaignId])
  @@index([tenantId, createdAt])
  @@index([tenantId, email])
  @@index([tenantId, ownerId])
  @@index([tenantId, phoneDigits])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([campaignId])
  @@map("leads")
}

model Pipeline {
  id        String    @id @default(uuid()) @map("_id")
  tenantId  String    @map("tenant_id")
  name      String
  isDefault Boolean   @default(false) @map("is_default")
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stages        PipelineStage[]
  opportunities Opportunity[]

  @@unique([tenantId, name])
  @@map("pipelines")
}

enum StageCategory {
  OPEN
  WON
  LOST
}

model PipelineStage {
  id          String        @id @default(uuid()) @map("_id")
  tenantId    String        @map("tenant_id")
  pipelineId  String        @map("pipeline_id")
  name        String
  position    Int
  /// Default win probability (0-100) used for weighted pipeline value.
  probability Int
  category    StageCategory @default(OPEN)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  opportunities Opportunity[]

  @@unique([pipelineId, position])
  @@index([tenantId])
  @@map("pipeline_stages")
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

enum DealPriority {
  LOW
  MEDIUM
  HIGH
}

model Opportunity {
  id                String            @id @default(uuid()) @map("_id")
  tenantId          String            @map("tenant_id")
  pipelineId        String            @map("pipeline_id")
  stageId           String            @map("stage_id")
  name              String
  amount            Float             @default(0)
  currency          String
  /// Overrides the stage probability when set.
  probability       Int?
  status            OpportunityStatus @default(OPEN)
  expectedCloseDate DateTime?         @map("expected_close_date")
  closedAt          DateTime?         @map("closed_at")
  lossReason        String?           @map("loss_reason")
  /// Set by people; null means not prioritised.
  priority          DealPriority?
  /// Position of `status` / `priority` in their enum, kept by the database client so sorting follows the enum order
  /// (as PostgreSQL enums sorted) rather than the alphabet (packages/database/src/derived.ts).
  statusRank        Int?              @map("status_rank")
  priorityRank      Int?              @map("priority_rank")
  ownerId           String?           @map("owner_id")
  companyId         String?           @map("company_id")
  contactId         String?           @map("contact_id")
  sourceLeadId      String?           @map("source_lead_id")
  /// Deal number (DEAL-0001), from the workspace counter; assigned once (ADR 0063).
  dealNumber        String?           @map("deal_number")
  dealSeq           Int?              @map("deal_seq")
  /// The assigned manager, the lead creator (copied from the company when the deal is created) and the people who
  /// helped win it. They decide revenue credits with the workspace's attribution rule.
  managerId         String?           @map("manager_id")
  leadCreatorId     String?           @map("lead_creator_id")
  supportingUserIds String[]          @map("supporting_user_ids")
  /// Where the deal came from (DEAL_SOURCES or the team's own words), the products or services it covers, and
  /// free notes (Deals redesign, ADR 0096).
  source            String?
  products          String[]
  notes             String?
  /// Archived deals leave the board, the list and the dashboard but are kept, and can be brought back.
  archivedAt        DateTime?         @map("archived_at")
  archivedById      String?           @map("archived_by_id")
  customFields      Json              @default("{}") @map("custom_fields")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  deletedAt         DateTime?         @map("deleted_at")

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pipeline       Pipeline          @relation(fields: [pipelineId], references: [id], onUpdate: NoAction)
  stage          PipelineStage     @relation(fields: [stageId], references: [id], onUpdate: NoAction)
  company        Company?          @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  contact        Contact?          @relation(fields: [contactId], references: [id], onUpdate: NoAction)
  activities     Activity[]
  tasks          Task[]
  quotes         Quote[]
  contracts      Contract[]
  stageEvents    DealStageEvent[]
  healthScore    DealHealthScore?
  healthDays     DealHealthDaily[]
  emailThreads   EmailThread[]
  meetingRecords MeetingRecord[]

  @@unique([tenantId, dealNumber])
  @@index([tenantId, archivedAt])
  @@index([tenantId, status])
  @@index([tenantId, stageId])
  @@index([tenantId, closedAt])
  @@index([tenantId, ownerId])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([pipelineId])
  @@index([stageId])
  @@index([companyId])
  @@index([contactId])
  @@map("opportunities")
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
}

model Activity {
  id            String       @id @default(uuid()) @map("_id")
  tenantId      String       @map("tenant_id")
  type          ActivityType
  subject       String
  body          String?
  occurredAt    DateTime     @default(now()) @map("occurred_at")
  ownerId       String?      @map("owner_id")
  /// Set when an AI agent drafted or performed the activity (with human approval where required).
  aiAssisted    Boolean      @default(false) @map("ai_assisted")
  leadId        String?      @map("lead_id")
  contactId     String?      @map("contact_id")
  companyId     String?      @map("company_id")
  opportunityId String?      @map("opportunity_id")
  /// What kind of interaction was logged (INTERACTION_KINDS in packages/types/src/company-work.ts); null for activities
  /// logged before the company CRM. Logged by a person, never synced: synced emails live in email_messages.
  interaction   String?
  sender        String?
  recipient     String?
  outcome       String?
  nextAction    String?      @map("next_action")
  followUpAt    DateTime?    @map("follow_up_at")
  /// How the client responded: POSITIVE, NEUTRAL or NEGATIVE (positive responses on the dashboards).
  sentiment     String?
  /// An attachment in company_files, and the RFQ the interaction is about.
  fileId        String?      @map("file_id")
  rfqId         String?      @map("rfq_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  /// When a person last edited it after logging (null = never edited).
  editedAt      DateTime?    @map("edited_at")
  deletedAt     DateTime?    @map("deleted_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([tenantId, occurredAt])
  @@index([tenantId, leadId])
  @@index([tenantId, contactId])
  @@index([tenantId, companyId])
  @@index([tenantId, opportunityId])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([leadId])
  @@index([contactId])
  @@index([companyId])
  @@index([opportunityId])
  @@map("activities")
}

enum TaskStatus {
  OPEN
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

model Task {
  id                String       @id @default(uuid()) @map("_id")
  tenantId          String       @map("tenant_id")
  title             String
  description       String?
  status            TaskStatus   @default(OPEN)
  priority          TaskPriority @default(NORMAL)
  dueAt             DateTime?    @map("due_at")
  completedAt       DateTime?    @map("completed_at")
  /// Shown to the customer in the client portal as a milestone.
  portalVisible     Boolean      @default(false) @map("portal_visible")
  assigneeId        String?      @map("assignee_id")
  leadId            String?      @map("lead_id")
  contactId         String?      @map("contact_id")
  opportunityId     String?      @map("opportunity_id")
  /// Follow-ups (ADR 0060, Phase 3) are tasks with a follow-up type, linked to a company lead.
  companyId         String?      @map("company_id")
  followUpType      String?      @map("follow_up_type")
  managerId         String?      @map("manager_id")
  /// The previous discussion, the action needed next, and remarks.
  summary           String?
  nextAction        String?      @map("next_action")
  remarks           String?
  rescheduleCount   Int          @default(0) @map("reschedule_count")
  /// Redesign R3 (ADR 0083): the n-th follow-up of an employee's outreach cadence, planned by SampForce.
  cadenceStep       Int?         @map("cadence_step")
  rescheduledAt     DateTime?    @map("rescheduled_at")
  outcome           String?
  rfqId             String?      @map("rfq_id")
  createdById       String?      @map("created_by_id")
  /// Who it was assigned to before the last reassignment, and when (My Work: "reassigned to me").
  reassignedFromId  String?      @map("reassigned_from_id")
  reassignedAt      DateTime?    @map("reassigned_at")
  /// Custom field values (ADR 0062) for follow-ups.
  customFields      Json         @default("{}") @map("custom_fields")
  /// Reminder bookkeeping (ADR 0062) so each reminder goes out once per due date.
  reminderSentAt    DateTime?    @map("reminder_sent_at")
  overdueNotifiedAt DateTime?    @map("overdue_notified_at")
  /// Workspace hierarchy (ADR 0071): the workspace a task was handed down to, and the workspace it came from.
  workspaceNodeId   String?      @map("workspace_node_id")
  assignedByNodeId  String?      @map("assigned_by_node_id")
  /// Redesign R7 (ADR 0087): ACKNOWLEDGED, IN_PROGRESS or BLOCKED once the assignee moves it; null = not acknowledged.
  progress          String?
  acknowledgedAt    DateTime?    @map("acknowledged_at")
  blockedReason     String?      @map("blocked_reason")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  deletedAt         DateTime?    @map("deleted_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([tenantId, status, dueAt])
  @@index([tenantId, assigneeId])
  @@index([tenantId, companyId, status])
  @@index([tenantId, followUpType, status, dueAt])
  @@index([tenantId, workspaceNodeId, status])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([leadId])
  @@index([contactId])
  @@index([opportunityId])
  @@index([companyId])
  @@map("tasks")
}

/// A comment on a task handed down the workspace hierarchy (ADR 0071).
model TaskComment {
  id        String   @id @default(uuid()) @map("_id")
  tenantId  String   @map("tenant_id")
  taskId    String   @map("task_id")
  authorId  String?  @map("author_id")
  body      String
  /// Redesign R7: quick reactions, { "👍": [userId, ...] }.
  reactions Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, taskId, createdAt])
  @@map("task_comments")
}

/// The full history of a handed-down task: who created, changed or commented on it, and what changed. Append-only.
model TaskEvent {
  id        String   @id @default(uuid()) @map("_id")
  tenantId  String   @map("tenant_id")
  taskId    String   @map("task_id")
  actorId   String?  @map("actor_id")
  /// created, updated or commented.
  kind      String
  /// [{ field, from, to }]
  changes   Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, taskId, createdAt])
  @@map("task_events")
}

// ───────────────────────────── Extensibility & onboarding ─────────────────────────────

enum CustomFieldEntity {
  LEAD
  CONTACT
  COMPANY
  OPPORTUNITY
  FOLLOW_UP
  RFQ
}

enum CustomFieldType {
  TEXT
  TEXTAREA
  NUMBER
  CURRENCY
  DATE
  DATETIME
  SELECT
  MULTISELECT
  CHECKBOX
  BOOLEAN
  URL
  EMAIL
  PHONE
  FILE
  FORMULA
}

/// Typed definition for values stored in a record's custom_fields JSON under `key`.
model CustomField {
  id                 String            @id @default(uuid()) @map("_id")
  tenantId           String            @map("tenant_id")
  entity             CustomFieldEntity
  key                String
  label              String
  type               CustomFieldType
  options            String[]
  required           Boolean           @default(false)
  position           Int               @default(0)
  /// ADR 0062: description, default value, currency for CURRENCY, designation rules, form and search flags.
  description        String?
  defaultValue       Json?             @map("default_value")
  currency           String?
  viewDesignationIds String[]          @default([]) @map("view_designation_ids")
  editDesignationIds String[]          @default([]) @map("edit_designation_ids")
  showInForms        Boolean           @default(true) @map("show_in_forms")
  searchable         Boolean           @default(false)
  active             Boolean           @default(true)
  /// Shown only while another field passes this test: {key, op, value} (ADR 0062).
  showWhen           Json?             @map("show_when")
  /// FORMULA: the expression and the decimals its result is rounded to.
  formula            String?
  decimals           Int?
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  archivedAt         DateTime?         @map("archived_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, entity, key])
  @@map("custom_fields")
}

/// Workspace invitation. Only the SHA-256 of the token is stored.
model Invitation {
  id              String    @id @default(uuid()) @map("_id")
  tenantId        String    @map("tenant_id")
  email           String
  roleId          String    @map("role_id")
  tokenHash       String    @unique @map("token_hash")
  invitedById     String    @map("invited_by_id")
  /// The workspace (ADR 0071) the person joins when they accept. Null = the Super Workspace.
  workspaceNodeId String?   @map("workspace_node_id")
  /// The invitee's name and phone as the inviter typed them (W5): the name pre-fills the accept page, the phone is
  /// copied to the account when it has none.
  name            String?
  phone           String?
  /// The Console's permission (operator email) for this person to own one more Super Workspace: without it, someone
  /// who already owns a Super Workspace cannot accept the administrator invitation of another company.
  superGrantedBy  String?   @map("super_granted_by")
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role   Role   @relation(fields: [roleId], references: [id], onUpdate: NoAction)

  @@index([tenantId, email])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([roleId])
  @@map("invitations")
}

// ───────────────────────────── Automation & communication (Phase 3) ─────────────────────────────

/// Transactional outbox. Written in the same transaction as the change it describes (via the audit
/// service), then processed by the worker: workflow triggers, notifications and webhooks.
model DomainEvent {
  id          String    @id @default(uuid()) @map("_id")
  tenantId    String    @map("tenant_id")
  type        String
  entityType  String?   @map("entity_type")
  entityId    String?   @map("entity_id")
  actorUserId String?   @map("actor_user_id")
  payload     Json      @default("{}")
  /// Automation depth that produced this event (0 = a person). Used for loop protection.
  depth       Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([processedAt, createdAt])
  @@index([tenantId, createdAt])
  @@map("domain_events")
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
}

model Workflow {
  id              String         @id @default(uuid()) @map("_id")
  tenantId        String         @map("tenant_id")
  name            String
  description     String?
  status          WorkflowStatus @default(DRAFT)
  triggerType     String         @map("trigger_type")
  activeVersionId String?        @map("active_version_id")
  /// When it was last switched on; events from before then do not start runs.
  activatedAt     DateTime?      @map("activated_at")
  createdById     String         @map("created_by_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  versions   WorkflowVersion[]
  executions WorkflowExecution[]

  @@index([tenantId, status, triggerType])
  @@map("workflows")
}

/// Immutable. Editing a workflow creates a new version; running executions finish on theirs.
model WorkflowVersion {
  id          String   @id @default(uuid()) @map("_id")
  tenantId    String   @map("tenant_id")
  workflowId  String   @map("workflow_id")
  version     Int
  definition  Json
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workflow   Workflow            @relation(fields: [workflowId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  executions WorkflowExecution[]

  @@unique([workflowId, version])
  @@map("workflow_versions")
}

enum ExecutionStatus {
  RUNNING
  WAITING
  AWAITING_APPROVAL
  SUCCEEDED
  FAILED
  CANCELED
}

model WorkflowExecution {
  id          String          @id @default(uuid()) @map("_id")
  tenantId    String          @map("tenant_id")
  workflowId  String          @map("workflow_id")
  versionId   String          @map("version_id")
  /// Idempotency: one execution per (event, version).
  eventId     String          @map("event_id")
  status      ExecutionStatus @default(RUNNING)
  simulation  Boolean         @default(false)
  currentNode String?         @map("current_node")
  context     Json            @default("{}")
  depth       Int             @default(0)
  resumeAt    DateTime?       @map("resume_at")
  attempts    Int             @default(0)
  lockedUntil DateTime?       @map("locked_until")
  error       String?
  startedAt   DateTime        @default(now()) @map("started_at")
  finishedAt  DateTime?       @map("finished_at")

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workflow  Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  version   WorkflowVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  steps     WorkflowStep[]
  approvals ApprovalRequest[]

  @@unique([versionId, eventId])
  @@index([status, resumeAt])
  @@index([tenantId, workflowId, startedAt(sort: Desc)])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([workflowId])
  @@map("workflow_executions")
}

model WorkflowStep {
  id          String    @id @default(uuid()) @map("_id")
  tenantId    String    @map("tenant_id")
  executionId String    @map("execution_id")
  nodeId      String    @map("node_id")
  nodeType    String    @map("node_type")
  status      String
  output      Json      @default("{}")
  error       String?
  startedAt   DateTime  @default(now()) @map("started_at")
  finishedAt  DateTime? @map("finished_at")

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([executionId, startedAt])
  @@map("workflow_steps")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELED
}

/// Human-in-the-loop decision for an automation (and, from Phase 4, AI) action.
model ApprovalRequest {
  id           String         @id @default(uuid()) @map("_id")
  tenantId     String         @map("tenant_id")
  executionId  String?        @map("execution_id")
  nodeId       String?        @map("node_id")
  kind         String
  title        String
  summary      String?
  payload      Json           @default("{}")
  /// Permission an approver must hold.
  permission   String
  status       ApprovalStatus @default(PENDING)
  decidedById  String?        @map("decided_by_id")
  decidedAt    DateTime?      @map("decided_at")
  decisionNote String?        @map("decision_note")
  expiresAt    DateTime       @map("expires_at")
  createdAt    DateTime       @default(now()) @map("created_at")

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  execution WorkflowExecution? @relation(fields: [executionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, status, createdAt(sort: Desc)])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([executionId])
  @@map("approval_requests")
}

model Notification {
  id             String    @id @default(uuid()) @map("_id")
  tenantId       String    @map("tenant_id")
  userId         String    @map("user_id")
  type           String
  title          String
  body           String?
  link           String?
  /// Source event, so a retried event never notifies twice.
  eventId        String?   @map("event_id")
  /// Who sent it, when a person did (manager instructions, remarks, escalations); null for system notices.
  senderId       String?   @map("sender_id")
  /// LOW, NORMAL, HIGH or URGENT (null = NORMAL).
  priority       String?
  companyId      String?   @map("company_id")
  contactId      String?   @map("contact_id")
  /// The recipient is asked to do something (acknowledge, decide, resolve).
  actionRequired Boolean   @default(false) @map("action_required")
  /// The section it comes from (ADR 0075: Leads, Tasks...), worked out when it is written; null for older rows.
  section        String?
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, eventId, type])
  @@index([tenantId, userId, readAt, createdAt(sort: Desc)])
  @@index([tenantId, userId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Outbound webhook subscription. The signing secret is stored encrypted.
model Webhook {
  id                  String    @id @default(uuid()) @map("_id")
  tenantId            String    @map("tenant_id")
  url                 String
  events              String[]
  secretEncrypted     String    @map("secret_encrypted")
  active              Boolean   @default(true)
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  disabledReason      String?   @map("disabled_reason")
  /// manual (added under Integrations) or zapier (a REST-hook subscription made with an API key)
  source              String    @default("manual")
  apiKeyId            String?   @map("api_key_id")
  createdById         String    @map("created_by_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  apiKey     ApiKey?           @relation(fields: [apiKeyId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deliveries WebhookDelivery[]

  @@index([tenantId, active])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([apiKeyId])
  @@map("webhooks")
}

enum DeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model WebhookDelivery {
  id            String         @id @default(uuid()) @map("_id")
  tenantId      String         @map("tenant_id")
  webhookId     String         @map("webhook_id")
  eventId       String         @map("event_id")
  eventType     String         @map("event_type")
  status        DeliveryStatus @default(PENDING)
  attempts      Int            @default(0)
  nextAttemptAt DateTime       @default(now()) @map("next_attempt_at")
  responseCode  Int?           @map("response_code")
  lastError     String?        @map("last_error")
  createdAt     DateTime       @default(now()) @map("created_at")
  deliveredAt   DateTime?      @map("delivered_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([webhookId, eventId])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

enum IntegrationProvider {
  GOOGLE
  MICROSOFT
}

enum ConnectionStatus {
  CONNECTED
  ERROR
  DISCONNECTED
}

/// A user's mailbox and calendar connection. Tokens are envelope-encrypted (AES-256-GCM).
model IntegrationConnection {
  id                   String              @id @default(uuid()) @map("_id")
  tenantId             String              @map("tenant_id")
  userId               String              @map("user_id")
  provider             IntegrationProvider
  accountEmail         String              @map("account_email")
  scopes               String[]
  credentialsEncrypted String              @map("credentials_encrypted")
  status               ConnectionStatus    @default(CONNECTED)
  mailCursor           String?             @map("mail_cursor")
  calendarCursor       String?             @map("calendar_cursor")
  lastSyncAt           DateTime?           @map("last_sync_at")
  nextSyncAt           DateTime            @default(now()) @map("next_sync_at")
  consecutiveFailures  Int                 @default(0) @map("consecutive_failures")
  lastError            String?             @map("last_error")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  emails   EmailMessage[]
  meetings Meeting[]
  threads  EmailThread[]
  syncLogs IntegrationSyncLog[]

  @@unique([tenantId, userId, provider])
  @@index([status, nextSyncAt])
  @@map("integration_connections")
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

model EmailMessage {
  id                String         @id @default(uuid()) @map("_id")
  tenantId          String         @map("tenant_id")
  connectionId      String         @map("connection_id")
  providerMessageId String         @map("provider_message_id")
  threadId          String?        @map("thread_id")
  direction         EmailDirection
  fromAddress       String         @map("from_address")
  toAddresses       String[]       @map("to_addresses")
  ccAddresses       String[]       @map("cc_addresses")
  subject           String
  snippet           String?
  bodyText          String?        @map("body_text")
  sentAt            DateTime       @map("sent_at")
  contactId         String?        @map("contact_id")
  leadId            String?        @map("lead_id")
  /// The Email Assistant's latest reading of a received email (EMAIL_INTENTS); a model's judgement, not a fact.
  aiIntent          String?        @map("ai_intent")
  aiAnalysedAt      DateTime?      @map("ai_analysed_at")
  /// The inbox conversation, set when the email is stored (storeEmail in apps/api/src/integrations/threading.ts).
  conversationId    String?        @map("conversation_id")
  createdAt         DateTime       @default(now()) @map("created_at")

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  conversation EmailThread?          @relation(fields: [conversationId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([connectionId, providerMessageId])
  @@index([tenantId, contactId, sentAt(sort: Desc)])
  @@index([tenantId, leadId, sentAt(sort: Desc)])
  @@index([conversationId, sentAt])
  @@map("email_messages")
}

model Meeting {
  id              String   @id @default(uuid()) @map("_id")
  tenantId        String   @map("tenant_id")
  connectionId    String   @map("connection_id")
  providerEventId String   @map("provider_event_id")
  title           String
  startsAt        DateTime @map("starts_at")
  endsAt          DateTime @map("ends_at")
  location        String?
  attendees       String[]
  organizer       String?
  canceled        Boolean  @default(false)
  contactIds      String[] @map("contact_ids")
  /// Google Meet, Teams or Zoom link from the calendar event, when it has one.
  joinUrl         String?  @map("join_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  record     MeetingRecord?

  @@unique([connectionId, providerEventId])
  @@index([tenantId, startsAt])
  @@map("meetings")
}

// ───────────── Phase 4: AI intelligence ─────────────

/// Tenant AI policy: the tenant-wide kill switch, per-agent switches, redaction and an optional credit cap.
model AiSettings {
  tenantId         String   @id @map("_id")
  enabled          Boolean  @default(true)
  disabledAgents   String[] @default([]) @map("disabled_agents")
  autoQualifyLeads Boolean  @default(false) @map("auto_qualify_leads")
  redactPii        Boolean  @default(false) @map("redact_pii")
  /// Optional tenant-set ceiling below the plan allowance.
  monthlyCreditCap Int?     @map("monthly_credit_cap")
  updatedById      String?  @map("updated_by_id")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("ai_settings")
}

enum AiRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  BLOCKED
}

/// One Copilot turn or agent run, with every model call and tool call in `trace`.
model AiRun {
  id             String      @id @default(uuid()) @map("_id")
  tenantId       String      @map("tenant_id")
  /// Requesting user; null for automatic runs (they act with no user and can only propose).
  userId         String?     @map("user_id")
  agent          String
  status         AiRunStatus @default(QUEUED)
  entityType     String?     @map("entity_type")
  entityId       String?     @map("entity_id")
  conversationId String?     @map("conversation_id")
  input          Json        @default("{}")
  output         Json?
  trace          Json        @default("[]")
  promptVersion  String      @map("prompt_version")
  model          String?
  creditsUsed    Int         @default(0) @map("credits_used")
  error          String?
  attempts       Int         @default(0)
  runAt          DateTime    @default(now()) @map("run_at")
  leaseUntil     DateTime?   @map("lease_until")
  createdAt      DateTime    @default(now()) @map("created_at")
  finishedAt     DateTime?   @map("finished_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, conversationId, createdAt])
  @@index([status, runAt])
  @@map("ai_runs")
}

/// Metering: one row per model call, converted to SampForce AI credits.
model AiUsage {
  id            String   @id @default(uuid()) @map("_id")
  tenantId      String   @map("tenant_id")
  userId        String?  @map("user_id")
  runId         String?  @map("run_id")
  agent         String
  provider      String
  model         String
  inputTokens   Int      @map("input_tokens")
  outputTokens  Int      @map("output_tokens")
  credits       Int
  status        String
  latencyMs     Int      @map("latency_ms")
  promptVersion String   @map("prompt_version")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, createdAt])
  @@map("ai_usage")
}

enum RecommendationStatus {
  PROPOSED
  ACCEPTED
  DISMISSED
}

/// A stored, explainable agent result: the signals and prompt version that produced it.
model AiRecommendation {
  id            String               @id @default(uuid()) @map("_id")
  tenantId      String               @map("tenant_id")
  runId         String?              @map("run_id")
  agent         String
  kind          String
  entityType    String               @map("entity_type")
  entityId      String               @map("entity_id")
  payload       Json
  promptVersion String               @map("prompt_version")
  status        RecommendationStatus @default(PROPOSED)
  decidedById   String?              @map("decided_by_id")
  decidedAt     DateTime?            @map("decided_at")
  createdAt     DateTime             @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, entityType, entityId, createdAt(sort: Desc)])
  @@map("ai_recommendations")
}

/// A frozen copy of the forecast inputs and totals, so a past forecast can be recomputed exactly.
model ForecastSnapshot {
  id          String   @id @default(uuid()) @map("_id")
  tenantId    String   @map("tenant_id")
  label       String?
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  currency    String
  method      String
  /// Category thresholds used ({commit, bestCase}); null = the original 70/30.
  assumptions Json?
  totals      Json
  lines       Json
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, periodStart, createdAt(sort: Desc)])
  @@index([tenantId, periodStart, periodEnd], map: "forecast_snapshots_period_idx")
  @@map("forecast_snapshots")
}

/// Enhancement feature 10: how a workspace's forecast works out probabilities and categories.
model ForecastSettings {
  tenantId          String   @id @map("_id")
  method            String   @default("stage")
  commitThreshold   Int      @default(70) @map("commit_threshold")
  bestCaseThreshold Int      @default(30) @map("best_case_threshold")
  historyMonths     Int      @default(12) @map("history_months")
  minSample         Int      @default(10) @map("min_sample")
  updatedById       String?  @map("updated_by_id")
  updatedAt         DateTime @default(now()) @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("forecast_settings")
}

// ───────────── Phase 5: commercial documents ─────────────

enum MarketingConsent {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

/// Workspace rules for quotes and reporting.
model CommercialSettings {
  tenantId                  String   @id @map("_id")
  /// A quote with any discount above this percentage needs approval (quotes:approve).
  discountApprovalThreshold Float    @default(10) @map("discount_approval_threshold")
  quoteValidityDays         Int      @default(30) @map("quote_validity_days")
  quoteTerms                String?  @map("quote_terms")
  proposalHeader            String?  @map("proposal_header")
  proposalFooter            String?  @map("proposal_footer")
  /// Small PNG or JPEG data URL printed on proposals.
  logoDataUrl               String?  @map("logo_data_url")
  updatedById               String?  @map("updated_by_id")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("commercial_settings")
}

model Product {
  id          String   @id @default(uuid()) @map("_id")
  tenantId    String   @map("tenant_id")
  sku         String?
  name        String
  description String?
  unit        String   @default("unit")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  prices PriceBookEntry[]
  lines  QuoteLine[]

  @@unique([tenantId, sku])
  @@index([tenantId, name])
  @@map("products")
}

/// A price list in one currency. Quotes take unit prices only from a price book.
model PriceBook {
  id        String   @id @default(uuid()) @map("_id")
  tenantId  String   @map("tenant_id")
  name      String
  currency  String
  isDefault Boolean  @default(false) @map("is_default")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  entries PriceBookEntry[]
  quotes  Quote[]

  @@unique([tenantId, name])
  @@map("price_books")
}

model PriceBookEntry {
  id          String   @id @default(uuid()) @map("_id")
  tenantId    String   @map("tenant_id")
  priceBookId String   @map("price_book_id")
  productId   String   @map("product_id")
  unitPrice   Float    @map("unit_price")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  priceBook PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([priceBookId, productId])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([productId])
  @@map("price_book_entries")
}

model TaxRate {
  id        String   @id @default(uuid()) @map("_id")
  tenantId  String   @map("tenant_id")
  name      String
  /// Percentage, e.g. 18.000 for 18 %.
  rate      Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, name])
  @@map("tax_rates")
}

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  ACCEPTED
  DECLINED
}

/// One version of a quote. Revising creates a new row with the same number and version + 1.
model Quote {
  id                    String      @id @default(uuid()) @map("_id")
  tenantId              String      @map("tenant_id")
  number                Int
  version               Int         @default(1)
  isLatest              Boolean     @default(true) @map("is_latest")
  opportunityId         String      @map("opportunity_id")
  priceBookId           String      @map("price_book_id")
  title                 String
  currency              String
  status                QuoteStatus @default(DRAFT)
  validUntil            DateTime?   @map("valid_until")
  notes                 String?
  terms                 String?
  subtotal              Float       @default(0)
  discountTotal         Float       @default(0) @map("discount_total")
  taxTotal              Float       @default(0) @map("tax_total")
  total                 Float       @default(0)
  maxDiscountPercent    Float       @default(0) @map("max_discount_percent")
  approvalId            String?     @map("approval_id")
  createdById           String?     @map("created_by_id")
  sentAt                DateTime?   @map("sent_at")
  decidedAt             DateTime?   @map("decided_at")
  /// Proposal sections ([{heading, body}]) shown above the price table.
  sections              Json        @default("[]")
  /// Whether the online proposal link works. Turning it off revokes every link to this version.
  shareEnabled          Boolean     @default(false) @map("share_enabled")
  /// Set when the customer approved or declined in the client portal.
  decidedByPortalUserId String?     @map("decided_by_portal_user_id")
  decisionNote          String?     @map("decision_note")
  firstViewedAt         DateTime?   @map("first_viewed_at")
  lastViewedAt          DateTime?   @map("last_viewed_at")
  viewCount             Int         @default(0) @map("view_count")
  /// Bid template look (key from @dealflow/types BID_TEMPLATES); null uses the plain default.
  templateKey           String?     @map("template_key")
  /// Accent colour override (#rrggbb) for the online proposal and PDF.
  accentColor           String?     @map("accent_color")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  opportunity Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  priceBook   PriceBook      @relation(fields: [priceBookId], references: [id], onUpdate: NoAction)
  lines       QuoteLine[]
  contracts   Contract[]
  payments    QuotePayment[]

  @@unique([tenantId, number, version])
  @@index([tenantId, opportunityId])
  @@index([tenantId, status, isLatest])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([opportunityId])
  @@index([priceBookId])
  @@map("quotes")
}

model QuoteLine {
  id              String  @id @default(uuid()) @map("_id")
  tenantId        String  @map("tenant_id")
  quoteId         String  @map("quote_id")
  productId       String  @map("product_id")
  position        Int
  name            String
  description     String?
  quantity        Float
  /// Copied from the price book when the line is saved; never typed in.
  unitPrice       Float   @map("unit_price")
  discountPercent Float   @default(0) @map("discount_percent")
  taxRateId       String? @map("tax_rate_id")
  taxPercent      Float   @default(0) @map("tax_percent")
  netTotal        Float   @map("net_total")
  taxTotal        Float   @map("tax_total")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product Product @relation(fields: [productId], references: [id], onUpdate: NoAction)

  @@index([quoteId, position])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([productId])
  @@map("quote_lines")
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

model Contract {
  id                String         @id @default(uuid()) @map("_id")
  tenantId          String         @map("tenant_id")
  number            Int
  name              String
  companyId         String?        @map("company_id")
  opportunityId     String?        @map("opportunity_id")
  quoteId           String?        @map("quote_id")
  ownerId           String?        @map("owner_id")
  status            ContractStatus @default(DRAFT)
  value             Float          @default(0)
  currency          String
  startDate         DateTime       @map("start_date")
  endDate           DateTime?      @map("end_date")
  autoRenew         Boolean        @default(false) @map("auto_renew")
  renewalNoticeDays Int            @default(30) @map("renewal_notice_days")
  /// How the signature was captured. No e-signature provider is connected yet.
  signatureMethod   String?        @map("signature_method")
  signedBy          String?        @map("signed_by")
  signedAt          DateTime?      @map("signed_at")
  terms             String?
  renewedFromId     String?        @unique @map("renewed_from_id")
  reminderSentAt    DateTime?      @map("reminder_sent_at")
  terminatedAt      DateTime?      @map("terminated_at")
  terminationReason String?        @map("termination_reason")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company     Company?            @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  opportunity Opportunity?        @relation(fields: [opportunityId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  quote       Quote?              @relation(fields: [quoteId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  renewedFrom Contract?           @relation("ContractRenewal", fields: [renewedFromId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  renewal     Contract?           @relation("ContractRenewal")
  escalations Escalation[]
  envelopes   SignatureEnvelope[]

  @@unique([tenantId, number])
  @@index([tenantId, status, endDate])
  @@index([tenantId, companyId])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([companyId])
  @@index([opportunityId])
  @@index([quoteId])
  @@map("contracts")
}

// ───────────── Phase 5: marketing ─────────────

enum CampaignStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

model Campaign {
  id          String         @id @default(uuid()) @map("_id")
  tenantId    String         @map("tenant_id")
  name        String
  channel     String
  status      CampaignStatus @default(PLANNED)
  startDate   DateTime?      @map("start_date")
  endDate     DateTime?      @map("end_date")
  budget      Float?
  currency    String
  /// Leads whose campaign source equals this value count towards the campaign too.
  utmCampaign String?        @map("utm_campaign")
  ownerId     String?        @map("owner_id")
  description String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  leads          Lead[]
  forms          LeadForm[]
  emailTemplates EmailTemplate[]

  @@unique([tenantId, name])
  @@map("campaigns")
}

/// A saved audience: rules over leads or contacts, evaluated when it is viewed or exported.
model Segment {
  id          String   @id @default(uuid()) @map("_id")
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  entity      String
  rules       Json
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, name])
  @@map("segments")
}

/// A hosted lead-capture form. Its public token is safe to embed in a website.
model LeadForm {
  id             String   @id @default(uuid()) @map("_id")
  tenantId       String   @map("tenant_id")
  name           String
  publicToken    String   @unique @map("public_token")
  title          String
  intro          String?
  fields         Json
  consentText    String?  @map("consent_text")
  successMessage String   @map("success_message")
  source         String   @default("web_form")
  campaignId     String?  @map("campaign_id")
  ownerId        String   @map("owner_id")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  campaign    Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  submissions FormSubmission[]

  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([campaignId])
  @@map("lead_forms")
}

model FormSubmission {
  id        String   @id @default(uuid()) @map("_id")
  tenantId  String   @map("tenant_id")
  formId    String   @map("form_id")
  leadId    String?  @map("lead_id")
  data      Json
  consent   Boolean  @default(false)
  /// SHA-256 of the client IP with a server secret; used for rate limiting, not tracking.
  ipHash    String?  @map("ip_hash")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  form   LeadForm @relation(fields: [formId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([formId, createdAt(sort: Desc)])
  @@index([tenantId, ipHash, createdAt])
  @@map("form_submissions")
}

// ───────────── Phase 5: revenue and customer success ─────────────

/// Manually maintained rate: 1 unit of `currency` = `rate` units of the workspace default currency.
model ExchangeRate {
  id            String   @id @default(uuid()) @map("_id")
  tenantId      String   @map("tenant_id")
  currency      String
  rate          Float
  effectiveDate DateTime @map("effective_date")
  source        String   @default("manual")
  createdById   String?  @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, currency, effectiveDate])
  @@map("exchange_rates")
}

/// Revenue target for a quarter, for a person (userId) or the whole workspace (userId null).
model SalesTarget {
  id        String   @id @default(uuid()) @map("_id")
  tenantId  String   @map("tenant_id")
  userId    String?  @map("user_id")
  period    String
  amount    Float
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, period, userId])
  @@map("sales_targets")
}

enum EscalationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EscalationStatus {
  OPEN
  RESOLVED
}

model Escalation {
  id             String             @id @default(uuid()) @map("_id")
  tenantId       String             @map("tenant_id")
  companyId      String             @map("company_id")
  contractId     String?            @map("contract_id")
  title          String
  description    String?
  severity       EscalationSeverity @default(MEDIUM)
  status         EscalationStatus   @default(OPEN)
  ownerId        String?            @map("owner_id")
  openedById     String?            @map("opened_by_id")
  resolution     String?
  resolvedAt     DateTime?          @map("resolved_at")
  /// Client concerns (ADR 0063): CONCERN_CATEGORIES; null for customer-success escalations.
  category       String?
  contactId      String?            @map("contact_id")
  /// The manager responsible for resolving it (the owner's reporting manager unless chosen).
  managerId      String?            @map("manager_id")
  /// Resolution deadline.
  deadlineAt     DateTime?          @map("deadline_at")
  /// Escalated to a senior person: who, when, by whom and why.
  escalatedToId  String?            @map("escalated_to_id")
  escalatedById  String?            @map("escalated_by_id")
  escalatedAt    DateTime?          @map("escalated_at")
  escalationNote String?            @map("escalation_note")
  resolvedById   String?            @map("resolved_by_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([tenantId, status, severity])
  @@index([tenantId, companyId])
  @@index([tenantId, escalatedToId, status])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([companyId])
  @@index([contractId])
  @@map("escalations")
}

/// Latest rule-based health score per customer, kept so a drop can raise one churn alert.
model CompanyHealth {
  companyId  String    @id @map("_id")
  tenantId   String    @map("tenant_id")
  score      Int
  band       String
  signals    Json
  computedAt DateTime  @map("computed_at")
  alertedAt  DateTime? @map("alerted_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, band])
  @@map("company_health")
}

/// One score per customer per day, for churn-risk trends (enhancement feature 13).
model CompanyHealthDaily {
  id        String   @id @default(uuid()) @map("_id")
  companyId String   @map("company_id")
  day       DateTime
  tenantId  String   @map("tenant_id")
  score     Int
  band      String

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([companyId, day])
  @@index([tenantId, day])
  @@map("company_health_daily")
}

// ───────────── Phase 6: billing, operators, support access ─────────────

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

/// Invoices as reported by the billing provider. Amounts in the smallest currency unit.
model Invoice {
  id                String           @id @default(uuid()) @map("_id")
  tenantId          String           @map("tenant_id")
  provider          BillingProvider
  providerInvoiceId String           @map("provider_invoice_id")
  number            String?
  status            InvoiceStatus
  currency          String
  subtotalCents     Int              @map("subtotal_cents")
  taxCents          Int              @default(0) @map("tax_cents")
  totalCents        Int              @map("total_cents")
  amountPaidCents   Int              @default(0) @map("amount_paid_cents")
  periodStart       DateTime?        @map("period_start")
  periodEnd         DateTime?        @map("period_end")
  hostedUrl         String?          @map("hosted_url")
  pdfUrl            String?          @map("pdf_url")
  issuedAt          DateTime         @map("issued_at")
  paidAt            DateTime?        @map("paid_at")
  /// Offline invoices only: what the workspace asked for, applied when an operator records the payment.
  planCode          String?          @map("plan_code")
  billingInterval   BillingInterval? @map("billing_interval")
  seats             Int?
  requestedById     String?          @map("requested_by_id")
  /// The bank or transfer reference an operator entered when recording the payment.
  paymentReference  String?          @map("payment_reference")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, providerInvoiceId])
  @@index([tenantId, issuedAt])
  // The Console activity feed (ADR 0074, C3) reads invoices across clients by these times.
  @@index([issuedAt])
  @@index([paidAt])
  @@map("invoices")
}

/// Provider webhook events already applied (idempotency). Stores the event type, not the payload.
model BillingEvent {
  id              String          @id @default(uuid()) @map("_id")
  tenantId        String          @map("tenant_id")
  provider        BillingProvider
  providerEventId String          @map("provider_event_id")
  type            String
  createdAt       DateTime        @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, providerEventId])
  @@map("billing_events")
}

/// A workspace owner's time-boxed permission for platform support to look inside the workspace.
model SupportGrant {
  id          String    @id @default(uuid()) @map("_id")
  tenantId    String    @map("tenant_id")
  grantedById String    @map("granted_by_id")
  reason      String
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, expiresAt])
  @@map("support_grants")
}

enum OperatorRole {
  ADMIN
  SUPPORT
}

enum OperatorStatus {
  ACTIVE
  DISABLED
}

/// Platform staff. A separate realm from workspace users: own table, own sign-in, own token secret.
model PlatformOperator {
  id               String         @id @default(uuid()) @map("_id")
  email            String         @unique
  name             String
  passwordHash     String         @map("password_hash")
  /// Kept in step with consoleRole: ADMIN for Super Admins, SUPPORT for every other role (the CLI and last-admin guard use it).
  role             OperatorRole   @default(SUPPORT)
  /// The Console role (ADR 0074): a built-in key (super_admin, finance, support, sales, operations, read_only) or an OperatorConsoleRole id. Null = from `role`.
  consoleRole      String?        @map("console_role")
  status           OperatorStatus @default(ACTIVE)
  lastLoginAt      DateTime?      @map("last_login_at")
  /// Two-step verification (ADR 0074): the TOTP secret sealed with SecretBox, when it was turned on, the last step used.
  mfaSecretEnc     String?        @map("mfa_secret_enc")
  mfaEnabledAt     DateTime?      @map("mfa_enabled_at")
  mfaLastStep      BigInt?        @map("mfa_last_step")
  /// Failed sign-ins in a row; the fifth pauses sign-in until lockedUntil.
  failedLoginCount Int            @default(0) @map("failed_login_count")
  lockedUntil      DateTime?      @map("locked_until")
  /// Console palette, colour mode, sidebar and sound (ADR 0074, ConsolePreferences in @dealflow/types); null = defaults.
  preferences      Json?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  auditLogs PlatformAuditLog[]

  notifications     OperatorNotification[]
  notificationPrefs OperatorNotificationPref[]

  @@index([consoleRole])
  @@map("platform_operators")
}

/// One-time recovery codes for an operator's two-step verification; only hashes are kept.
model OperatorRecoveryCode {
  id         String    @id @default(uuid()) @map("_id")
  operatorId String    @map("operator_id")
  codeHash   String    @map("code_hash")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([operatorId])
  @@map("operator_recovery_codes")
}

/// A signed-in Console session (ADR 0074). The session cookie names it, so it can be listed, ended and timed out when idle.
model OperatorSession {
  id         String    @id @default(uuid()) @map("_id")
  operatorId String    @map("operator_id")
  ip         String?
  userAgent  String?   @map("user_agent")
  remember   Boolean   @default(false)
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  @@index([operatorId, revokedAt])
  @@map("operator_sessions")
}

/// Every Console sign-in attempt, kept for the login history and suspicious sign-in alerts.
model OperatorLoginEvent {
  id         String   @id @default(uuid()) @map("_id")
  operatorId String?  @map("operator_id")
  email      String
  ip         String?
  userAgent  String?  @map("user_agent")
  /// success, wrong_password, wrong_code, locked, disabled
  outcome    String
  suspicious Boolean  @default(false)
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([operatorId, createdAt])
  @@index([createdAt])
  @@index([suspicious, createdAt])
  @@map("operator_login_events")
}

/// A custom Console role (ADR 0074): a name and any set of operator permissions. The six built-in roles live in code.
model OperatorConsoleRole {
  id          String   @id @default(uuid()) @map("_id")
  name        String   @unique
  description String   @default("")
  permissions String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("operator_console_roles")
}

/// One-time links to choose an operator password: an invitation (72 hours) or a reset (1 hour). Only a hash is kept.
model OperatorPasswordToken {
  id         String    @id @default(uuid()) @map("_id")
  operatorId String    @map("operator_id")
  purpose    String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([operatorId])
  @@map("operator_password_tokens")
}

/// Append-only log of everything operators do. The application role may insert and read, never change.
model PlatformAuditLog {
  id             String   @id @default(uuid()) @map("_id")
  operatorId     String?  @map("operator_id")
  action         String
  targetTenantId String?  @map("target_tenant_id")
  metadata       Json     @default("{}")
  ip             String?
  /// What the entry is about (ADR 0074, C3): client, operator, role, plan, provider, setting, ticket, help_article...
  targetType     String?  @map("target_type")
  targetId       String?  @map("target_id")
  /// The target's name when it was written, so the entry still reads well after a rename or delete.
  targetLabel    String?  @map("target_label")
  /// The changed fields before and after, with secrets removed (platform-audit.ts redact()).
  before         Json?
  after          Json?
  /// The Console session the change came from, and its browser.
  sessionId      String?  @map("session_id")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  operator PlatformOperator? @relation(fields: [operatorId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([targetTenantId, createdAt])
  @@index([createdAt])
  @@index([operatorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("platform_audit_logs")
}

/// A Console notification for one operator (ADR 0074, C3b), written by the worker's notification sweep.
model OperatorNotification {
  id             String    @id @default(uuid()) @map("_id")
  operatorId     String    @map("operator_id")
  type           String
  title          String
  body           String?
  link           String?
  /// The client it is about. Named like platform_audit_logs so the workspace guard does not treat the row as a workspace's.
  targetTenantId String?   @map("target_tenant_id")
  /// One notification per operator per event: the sweep may see an event twice.
  dedupeKey      String    @map("dedupe_key")
  /// False when the operator chose email only: the row only keeps the event from being sent twice.
  inApp          Boolean   @default(true) @map("in_app")
  emailedAt      DateTime? @map("emailed_at")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  operator PlatformOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([operatorId, dedupeKey])
  @@index([operatorId, inApp, createdAt])
  @@index([operatorId, inApp, readAt])
  @@map("operator_notifications")
}

/// How one operator wants one type of Console notification: in the Console, by email, both or neither.
model OperatorNotificationPref {
  id         String  @id @default(uuid()) @map("_id")
  operatorId String  @map("operator_id")
  type       String
  inApp      Boolean @map("in_app")
  email      Boolean

  operator PlatformOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([operatorId, type])
  @@map("operator_notification_prefs")
}

/// Deployment-wide settings that platform admins edit in the operator console (not per workspace).
/// A client's health score for one day (ADR 0074, C5), with every signal's points and the figure behind it
/// (ClientHealthSignal[] in @dealflow/types). Written by the worker once a day per client; advisory only.
model ClientHealthDaily {
  id        String   @id @default(uuid()) @map("_id")
  tenantId  String   @map("tenant_id")
  /// UTC day, YYYY-MM-DD.
  day       String
  score     Int
  band      String
  signals   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, day])
  @@index([day])
  @@map("client_health_daily")
}

/// The Console Overview's figures for one UTC day (ADR 0074, C5b): every KPI value (ConsoleKpiKey -> number), so the
/// cards can show the change against 30 days ago and a 30-day line. Written once a day by the worker.
model PlatformMetricDaily {
  /// YYYY-MM-DD.
  day       String   @id @map("_id")
  metrics   Json
  currency  String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("platform_metrics_daily")
}

model PlatformSetting {
  key         String   @id @map("_id")
  value       String
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

/// Provider keys entered in the operator console (ADR 0051). Values are sealed with ENCRYPTION_KEY (SecretBox) and
/// override the environment variable of the same name; clearing a row falls back to that variable.
model PlatformSecret {
  /// The environment variable name, e.g. SLACK_CLIENT_SECRET.
  name        String   @id @map("_id")
  valueEnc    String   @map("value_enc")
  /// What the console shows after saving: the last four characters of a secret, or the full non-secret value.
  hint        String?
  /// First 12 hex characters of the value's SHA-256, so the audit log can tell keys apart without holding them.
  fingerprint String
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_secrets")
}

// ───────────────────────────── Reports and immersive views (Phase 7) ─────────────────────────────

enum ReportVisibility {
  PRIVATE
  WORKSPACE
}

/// A saved report definition (see reportDefinitionSchema). Only catalogue field keys are stored, never SQL.
model Report {
  id          String           @id @default(uuid()) @map("_id")
  tenantId    String           @map("tenant_id")
  name        String
  description String?
  visibility  ReportVisibility @default(PRIVATE)
  definition  Json
  createdById String?          @map("created_by_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, createdById])
  @@map("reports")
}

/// An ordered grid of report widgets: [{ reportId, size }]. Widgets whose report is gone or hidden are skipped.
model Dashboard {
  id          String           @id @default(uuid()) @map("_id")
  tenantId    String           @map("tenant_id")
  name        String
  description String?
  visibility  ReportVisibility @default(PRIVATE)
  widgets     Json             @default("[]")
  createdById String?          @map("created_by_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, createdById])
  @@map("dashboards")
}

/// Every stage a deal enters, with when. Written on create and on each move; the source of flow and replay views.
/// `reconstructed` rows were back-filled from the audit log when the table was introduced.
model DealStageEvent {
  id            String   @id @default(uuid()) @map("_id")
  tenantId      String   @map("tenant_id")
  opportunityId String   @map("opportunity_id")
  pipelineId    String   @map("pipeline_id")
  fromStageId   String?  @map("from_stage_id")
  toStageId     String   @map("to_stage_id")
  actorUserId   String?  @map("actor_user_id")
  reconstructed Boolean  @default(false)
  occurredAt    DateTime @default(now()) @map("occurred_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, pipelineId, occurredAt])
  @@index([opportunityId, occurredAt])
  @@map("deal_stage_events")
}

// ───────────────────────────── Enterprise identity (Phase 8) ─────────────────────────────

/// A workspace's OpenID Connect identity provider. One per workspace.
model SsoConnection {
  id              String    @id @default(uuid()) @map("_id")
  tenantId        String    @unique @map("tenant_id")
  /// Globally unique name people type on the sign-in page ("Sign in with SSO").
  loginSlug       String    @unique @map("login_slug")
  issuer          String
  clientId        String    @map("client_id")
  clientSecretEnc String    @map("client_secret_enc")
  /// Lower-case email domains the provider may sign in. Empty = any domain the provider asserts.
  allowedDomains  String[]  @default([]) @map("allowed_domains")
  /// Create a membership on first sign-in for people the workspace has not invited.
  jitProvisioning Boolean   @default(false) @map("jit_provisioning")
  defaultRoleId   String?   @map("default_role_id")
  enabled         Boolean   @default(false)
  /// Password sign-in no longer opens this workspace (owners keep it as a break-glass route).
  enforced        Boolean   @default(false)
  /// Last successful test or sign-in, for the settings page.
  lastVerifiedAt  DateTime? @map("last_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  identities SsoIdentity[]

  @@map("sso_connections")
}

/// Links an identity-provider subject to a SampForce user, per workspace.
model SsoIdentity {
  id           String   @id @default(uuid()) @map("_id")
  tenantId     String   @map("tenant_id")
  connectionId String   @map("connection_id")
  userId       String   @map("user_id")
  subject      String
  lastLoginAt  DateTime @default(now()) @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  connection SsoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([connectionId, subject])
  @@index([tenantId, userId])
  @@map("sso_identities")
}

/// Bearer tokens for SCIM 2.0 provisioning. Only SHA-256 hashes are stored.
model ScimToken {
  id          String    @id @default(uuid()) @map("_id")
  tenantId    String    @map("tenant_id")
  name        String
  tokenHash   String    @unique @map("token_hash")
  /// First characters of the token, shown so admins can tell tokens apart.
  prefix      String
  createdById String?   @map("created_by_id")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId])
  @@map("scim_tokens")
}

// ───────────── Email templates and sequences (Phase 9) ─────────────

enum SequenceStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  REPLIED
  BOUNCED
  UNSUBSCRIBED
  STOPPED
  MOVED
  FAILED
}

enum EmailEventType {
  REPLIED
  OPENED
  CLICKED
  BOUNCED
  UNSUBSCRIBED
}

enum SuppressionReason {
  UNSUBSCRIBED
  BOUNCED
  MANUAL
}

/// Reusable email text with merge fields. Personal unless shared.
model EmailTemplate {
  id         String   @id @default(uuid()) @map("_id")
  tenantId   String   @map("tenant_id")
  name       String
  subject    String
  body       String
  /// Blocks for a designed (HTML) email (ADR 0050); null for plain text. `body` holds its plain-text version.
  design     Json?
  shared     Boolean  @default(false)
  category   String?
  campaignId String?  @map("campaign_id")
  ownerId    String?  @map("owner_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([tenantId, ownerId])
  @@index([tenantId, category])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([campaignId])
  @@map("email_templates")
}

/// Workspace email variables: {{var.key}} in templates and sequences.
model EmailVariable {
  id          String   @id @default(uuid()) @map("_id")
  tenantId    String   @map("tenant_id")
  key         String
  label       String
  value       String   @default("")
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, key])
  @@map("email_variables")
}

/// A person-built series of emails, tasks and checks, sent one-to-one from each sender's own mailbox.
model Sequence {
  id          String         @id @default(uuid()) @map("_id")
  tenantId    String         @map("tenant_id")
  name        String
  description String?
  status      SequenceStatus @default(DRAFT)
  ownerId     String?        @map("owner_id")
  steps       Json           @default("[]")
  rules       Json           @default("[]")
  settings    Json           @default("{}")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  enrollments      SequenceEnrollment[]
  prospectOutreach ProspectOutreach[]

  @@index([tenantId, status])
  @@map("sequences")
}

/// One person's run through a sequence. The worker claims due rows by next_run_at.
model SequenceEnrollment {
  id           String           @id @default(uuid()) @map("_id")
  tenantId     String           @map("tenant_id")
  sequenceId   String           @map("sequence_id")
  leadId       String?          @map("lead_id")
  contactId    String?          @map("contact_id")
  email        String
  senderId     String           @map("sender_id")
  enrolledById String?          @map("enrolled_by_id")
  status       EnrollmentStatus @default(ACTIVE)
  stepIndex    Int              @default(0) @map("step_index")
  nextRunAt    DateTime?        @map("next_run_at")
  attempts     Int              @default(0)
  lastError    String?          @map("last_error")
  repliedAt    DateTime?        @map("replied_at")
  openedAt     DateTime?        @map("opened_at")
  clickedAt    DateTime?        @map("clicked_at")
  finishedAt   DateTime?        @map("finished_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sequence Sequence          @relation(fields: [sequenceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages SequenceMessage[]

  @@index([status, nextRunAt])
  @@index([tenantId, sequenceId, status])
  @@index([tenantId, email])
  @@index([tenantId, leadId])
  @@index([tenantId, contactId])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([sequenceId])
  @@map("sequence_enrollments")
}

/// An email a sequence sent, with what SampForce saw happen to it.
model SequenceMessage {
  id             String    @id @default(uuid()) @map("_id")
  tenantId       String    @map("tenant_id")
  enrollmentId   String    @map("enrollment_id")
  stepId         String    @map("step_id")
  /// "A" or "B" for A/B-tested steps; "A" otherwise.
  variant        String    @default("A")
  senderId       String    @map("sender_id")
  emailMessageId String?   @map("email_message_id")
  toAddress      String    @map("to_address")
  subject        String
  sentAt         DateTime  @default(now()) @map("sent_at")
  openedAt       DateTime? @map("opened_at")
  openCount      Int       @default(0) @map("open_count")
  clickedAt      DateTime? @map("clicked_at")
  clickCount     Int       @default(0) @map("click_count")
  repliedAt      DateTime? @map("replied_at")
  bouncedAt      DateTime? @map("bounced_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  enrollment SequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  events     EmailEvent[]

  @@index([tenantId, senderId, sentAt])
  @@index([tenantId, toAddress, sentAt])
  @@index([enrollmentId])
  @@map("sequence_messages")
}

/// Opens, clicks, replies, bounces and unsubscribes, as SampForce observed them. No IP addresses are stored.
model EmailEvent {
  id        String         @id @default(uuid()) @map("_id")
  tenantId  String         @map("tenant_id")
  messageId String         @map("message_id")
  type      EmailEventType
  url       String?
  createdAt DateTime       @default(now()) @map("created_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  message SequenceMessage @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, messageId])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([messageId])
  @@map("email_events")
}

/// The workspace's do-not-email list. Sequences never send to these addresses.
model EmailSuppression {
  id          String            @id @default(uuid()) @map("_id")
  tenantId    String            @map("tenant_id")
  email       String
  reason      SuppressionReason
  createdById String?           @map("created_by_id")
  createdAt   DateTime          @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, email])
  @@map("email_suppressions")
}

/// Email finder lookups (Phase 9): history for the person and the daily limit.
model FinderLookup {
  id          String   @id @default(uuid()) @map("_id")
  tenantId    String   @map("tenant_id")
  userId      String   @map("user_id")
  companyName String   @map("company_name")
  domain      String?
  person      String?
  found       Int      @default(0)
  result      Json
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, userId, createdAt])
  @@map("finder_lookups")
}

// ───────────── Enhancement Phase 1: sales intelligence ─────────────

/**
 * Latest rule-based health of an open deal, kept by the worker's hourly sweep.
 */
model DealHealthScore {
  dealId     String    @id @map("_id")
  tenantId   String    @map("tenant_id")
  health     Int
  risk       String
  signals    Json
  computedAt DateTime  @map("computed_at")
  /**
   * Set when the owner was told the deal turned high risk; cleared when it recovers.
   */
  alertedAt  DateTime? @map("alerted_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  deal   Opportunity @relation(fields: [dealId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, risk])
  @@map("deal_health_scores")
}

/**
 * One score per deal per day (the last of the day wins), for trends.
 */
model DealHealthDaily {
  id       String   @id @default(uuid()) @map("_id")
  dealId   String   @map("deal_id")
  day      DateTime
  tenantId String   @map("tenant_id")
  health   Int
  risk     String

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  deal   Opportunity @relation(fields: [dealId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([dealId, day])
  @@index([tenantId, day])
  @@map("deal_health_daily")
}

/**
 * What a person did with one item of their next best action list; accepted items keep the task they created.
 */
model NextActionDecision {
  id         String    @id @default(uuid()) @map("_id")
  tenantId   String    @map("tenant_id")
  userId     String    @map("user_id")
  key        String
  kind       String
  recordType String    @map("record_type")
  recordId   String    @map("record_id")
  /**
   * accepted, dismissed or snoozed.
   */
  decision   String
  /**
   * Snoozed until; null with "dismissed" hides it until the situation behind the key changes.
   */
  until      DateTime?
  taskId     String?   @map("task_id")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, userId, key])
  @@index([tenantId, userId, createdAt])
  @@map("next_action_decisions")
}

/// Inbox conversation (feature 8): stored messages grouped by provider thread. Created when the first email of the thread is stored.
model EmailThread {
  id            String   @id @default(uuid()) @map("_id")
  tenantId      String   @map("tenant_id")
  connectionId  String   @map("connection_id")
  threadKey     String   @map("thread_key")
  subject       String
  /// OPEN, WAITING or CLOSED
  status        String   @default("OPEN")
  category      String?
  assignedToId  String?  @map("assigned_to_id")
  contactId     String?  @map("contact_id")
  leadId        String?  @map("lead_id")
  dealId        String?  @map("deal_id")
  messageCount  Int      @default(0) @map("message_count")
  lastMessageAt DateTime @map("last_message_at")
  lastDirection String   @map("last_direction")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  deal       Opportunity?          @relation(fields: [dealId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  messages   EmailMessage[]
  notes      EmailThreadNote[]

  @@unique([connectionId, threadKey])
  @@index([tenantId, lastMessageAt(sort: Desc)])
  @@index([tenantId, assignedToId])
  @@index([tenantId, dealId])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([dealId])
  @@map("email_threads")
}

model EmailThreadNote {
  id        String   @id @default(uuid()) @map("_id")
  tenantId  String   @map("tenant_id")
  threadId  String   @map("thread_id")
  authorId  String?  @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  thread EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([threadId, createdAt])
  @@map("email_thread_notes")
}

/// One row per mailbox sync attempt, kept for the connection log.
model IntegrationSyncLog {
  id           String   @id @default(uuid()) @map("_id")
  tenantId     String   @map("tenant_id")
  connectionId String   @map("connection_id")
  /// manual or scheduled
  trigger      String
  ok           Boolean
  emails       Int      @default(0)
  meetings     Int      @default(0)
  error        String?
  startedAt    DateTime @map("started_at")
  finishedAt   DateTime @default(now()) @map("finished_at")

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([connectionId, startedAt(sort: Desc)])
  @@index([tenantId])
  @@map("integration_sync_logs")
}

/// Meeting intelligence (feature 7): transcript or notes, the AI reading, the reviewed version, and what was created from it.
model MeetingRecord {
  id                    String    @id @default(uuid()) @map("_id")
  tenantId              String    @map("tenant_id")
  meetingId             String?   @unique @map("meeting_id")
  title                 String
  occurredAt            DateTime  @map("occurred_at")
  contactId             String?   @map("contact_id")
  leadId                String?   @map("lead_id")
  dealId                String?   @map("deal_id")
  /// notes, transcript or recording
  source                String    @default("notes")
  transcript            String?
  segments              Json?
  /// none, processing, done or failed
  transcriptionStatus   String    @default("none") @map("transcription_status")
  transcriptionProvider String?   @map("transcription_provider")
  transcriptionError    String?   @map("transcription_error")
  recordingConsentById  String?   @map("recording_consent_by_id")
  recordingConsentAt    DateTime? @map("recording_consent_at")
  analysis              Json?
  aiRunId               String?   @map("ai_run_id")
  analysedAt            DateTime? @map("analysed_at")
  reviewedById          String?   @map("reviewed_by_id")
  reviewedAt            DateTime? @map("reviewed_at")
  activityId            String?   @map("activity_id")
  taskIds               String[]  @default([]) @map("task_ids")
  createdById           String?   @map("created_by_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  meeting Meeting?     @relation(fields: [meetingId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deal    Opportunity? @relation(fields: [dealId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, dealId])
  @@index([tenantId, contactId])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([dealId])
  @@map("meeting_records")
}

// ───────────── Enhancement feature 11: client self-service portal ─────────────

model PortalSettings {
  tenantId       String   @id @map("_id")
  enabled        Boolean  @default(false)
  slug           String   @unique
  title          String?
  welcome        String?
  showDeals      Boolean  @default(true) @map("show_deals")
  showQuotes     Boolean  @default(true) @map("show_quotes")
  showContracts  Boolean  @default(true) @map("show_contracts")
  showTasks      Boolean  @default(true) @map("show_tasks")
  showDocuments  Boolean  @default(true) @map("show_documents")
  allowRequests  Boolean  @default(true) @map("allow_requests")
  allowMessages  Boolean  @default(true) @map("allow_messages")
  allowUploads   Boolean  @default(true) @map("allow_uploads")
  allowApprovals Boolean  @default(false) @map("allow_approvals")
  updatedById    String?  @map("updated_by_id")
  updatedAt      DateTime @default(now()) @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("portal_settings")
}

model PortalUser {
  id              String    @id @default(uuid()) @map("_id")
  tenantId        String    @map("tenant_id")
  companyId       String    @map("company_id")
  contactId       String?   @map("contact_id")
  email           String
  name            String
  role            String    @default("viewer")
  status          String    @default("invited")
  passwordHash    String?   @map("password_hash")
  inviteTokenHash String?   @map("invite_token_hash")
  inviteExpiresAt DateTime? @map("invite_expires_at")
  resetTokenHash  String?   @map("reset_token_hash")
  resetExpiresAt  DateTime? @map("reset_expires_at")
  failedLogins    Int       @default(0) @map("failed_logins")
  lockedUntil     DateTime? @map("locked_until")
  lastLoginAt     DateTime? @map("last_login_at")
  updatesSeenAt   DateTime? @map("updates_seen_at")
  createdById     String?   @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contact  Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  sessions PortalSession[]

  @@unique([tenantId, email])
  @@index([tenantId, companyId], map: "portal_users_company_idx")
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([companyId])
  @@index([contactId])
  @@map("portal_users")
}

model PortalSession {
  id           String   @id @default(uuid()) @map("_id")
  tenantId     String   @map("tenant_id")
  portalUserId String   @map("portal_user_id")
  tokenHash    String   @unique @map("token_hash")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")
  ip           String?
  userAgent    String?  @map("user_agent")

  user PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([portalUserId], map: "portal_sessions_user_idx")
  @@map("portal_sessions")
}

model PortalRequest {
  id           String    @id @default(uuid()) @map("_id")
  tenantId     String    @map("tenant_id")
  companyId    String    @map("company_id")
  portalUserId String?   @map("portal_user_id")
  number       Int
  subject      String
  category     String    @default("question")
  status       String    @default("open")
  assignedToId String?   @map("assigned_to_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @map("updated_at")
  resolvedAt   DateTime? @map("resolved_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, number])
  @@index([tenantId, status, updatedAt(sort: Desc)], map: "portal_requests_status_idx")
  @@index([tenantId, companyId], map: "portal_requests_company_idx")
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([companyId])
  @@map("portal_requests")
}

model PortalMessage {
  id                 String   @id @default(uuid()) @map("_id")
  tenantId           String   @map("tenant_id")
  companyId          String   @map("company_id")
  requestId          String?  @map("request_id")
  authorPortalUserId String?  @map("author_portal_user_id")
  authorUserId       String?  @map("author_user_id")
  body               String
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([tenantId, companyId, requestId, createdAt], map: "portal_messages_thread_idx")
  @@map("portal_messages")
}

model PortalDocument {
  id                     String   @id @default(uuid()) @map("_id")
  tenantId               String   @map("tenant_id")
  companyId              String   @map("company_id")
  name                   String
  contentType            String   @map("content_type")
  sizeBytes              Int      @map("size_bytes")
  data                   Bytes
  sha256                 String
  uploadedByUserId       String?  @map("uploaded_by_user_id")
  uploadedByPortalUserId String?  @map("uploaded_by_portal_user_id")
  createdAt              DateTime @default(now()) @map("created_at")

  @@index([tenantId, companyId, createdAt(sort: Desc)], map: "portal_documents_company_idx")
  @@map("portal_documents")
}

model PortalUpdate {
  id        String   @id @default(uuid()) @map("_id")
  tenantId  String   @map("tenant_id")
  companyId String   @map("company_id")
  kind      String
  title     String
  body      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, companyId, createdAt(sort: Desc)], map: "portal_updates_company_idx")
  @@map("portal_updates")
}

/// Enhancement feature 12: a dictated or recorded voice note and the CRM actions proposed from it (ADR 0026).
model VoiceNote {
  id                    String    @id @default(uuid()) @map("_id")
  tenantId              String    @map("tenant_id")
  userId                String    @map("user_id")
  leadId                String?   @map("lead_id")
  contactId             String?   @map("contact_id")
  dealId                String?   @map("deal_id")
  companyId             String?   @map("company_id")
  /// typed or recording
  source                String    @default("typed")
  language              String    @default("auto")
  transcript            String?
  detectedLanguage      String?   @map("detected_language")
  durationSeconds       Float?    @map("duration_seconds")
  /// none, processing, done or failed
  transcriptionStatus   String    @default("none") @map("transcription_status")
  transcriptionProvider String?   @map("transcription_provider")
  transcriptionError    String?   @map("transcription_error")
  interpretation        Json?
  aiRunId               String?   @map("ai_run_id")
  interpretedAt         DateTime? @map("interpreted_at")
  appliedAt             DateTime? @map("applied_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, userId, createdAt(sort: Desc)], map: "voice_notes_user_idx")
  @@index([tenantId, leadId, contactId, dealId, companyId], map: "voice_notes_record_idx")
  @@map("voice_notes")
}

/// Enhancement feature 14: how points are earned, and who sees leaderboards.
model GamificationSettings {
  tenantId    String   @id @map("_id")
  enabled     Boolean  @default(false)
  visibility  String   @default("everyone")
  rules       Json
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @default(now()) @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("gamification_settings")
}

model GamificationBadge {
  id          String   @id @default(uuid()) @map("_id")
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  icon        String   @default("medal")
  metric      String
  threshold   Float
  window      String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  awards GamificationAward[]

  @@unique([tenantId, name])
  @@map("gamification_badges")
}

model GamificationAward {
  id        String   @id @default(uuid()) @map("_id")
  tenantId  String   @map("tenant_id")
  badgeId   String   @map("badge_id")
  userId    String   @map("user_id")
  period    String
  value     Float
  awardedAt DateTime @default(now()) @map("awarded_at")

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  badge  GamificationBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([badgeId, userId, period])
  @@index([tenantId, userId])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([userId])
  @@map("gamification_awards")
}

model GamificationCompetition {
  id          String    @id @default(uuid()) @map("_id")
  tenantId    String    @map("tenant_id")
  name        String
  description String?
  kind        String
  metric      String
  startDate   DateTime  @map("start_date")
  endDate     DateTime  @map("end_date")
  goal        Float?
  reward      String?
  teamIds     String[]  @default([]) @map("team_ids")
  rules       Json
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  cancelledAt DateTime? @map("cancelled_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, endDate])
  @@map("gamification_competitions")
}

// ───────────── Website Enquiry (ADR 0095) ─────────────

/// One enquiry, download, live chat lead, newsletter sign-up or review sent on the company website, received from the
/// website's "Sampforce API" by its signed webhook or the pull sync. Upserted by (tenant, record, external id), so the
/// same lead arriving both ways is one row. The website's own fields are kept as sent; the SampForce fields (who
/// opened it, the sales status, the company or employee it became) are this workspace's own.
model WebsiteEnquiry {
  id                String    @id @default(uuid()) @map("_id")
  tenantId          String    @map("tenant_id")
  /// lead, contact (newsletter sign-ups) or review: the website's `object`.
  record            String
  /// The website's id: l_... for leads, r_... for reviews, the email address for contacts.
  externalId        String    @map("external_id")
  /// enquiry, download, resource-download, case-study-download, chat, careers, newsletter or review.
  type              String
  /// service, rfq, partnership, contact, download, chat, careers, other, newsletter or review.
  category          String
  /// new, contacted, qualified, won, lost or spam. Reviews and sign-ups start as new too.
  status            String    @default("new")
  /// The status on the website (for reviews: published, pending or hidden; for contacts: subscribed or unsubscribed).
  websiteStatus     String?   @map("website_status")
  formKey           String?   @map("form_key")
  formName          String?   @map("form_name")
  name              String?
  email             String?
  phone             String?
  country           String?
  company           String?
  designation       String?
  service           String?
  timeline          String?
  message           String?
  /// The resource, case study or title asked for on a download form, or the interest of a chat lead.
  resource          String?
  rating            Int?
  page              String?
  consent           Boolean   @default(false)
  /// Newsletter: still subscribed (false = unsubscribed from marketing email).
  subscribed        Boolean?
  /// Extra and other form fields, label to value.
  fields            Json?
  /// Who the lead is assigned to on the website, and the website team's note.
  websiteOwner      String?   @map("website_owner")
  websiteNote       String?   @map("website_note")
  /// The whole record as the website last sent it, so nothing is lost.
  raw               Json
  /// Lower-case text of name, email, company, phone, country, service, message and form, for search.
  searchText        String    @map("search_text")
  submittedAt       DateTime  @map("submitted_at")
  websiteUpdatedAt  DateTime  @map("website_updated_at")
  receivedAt        DateTime  @default(now()) @map("received_at")
  lastSyncedAt      DateTime  @default(now()) @map("last_synced_at")
  /// webhook or pull: how it first arrived.
  source            String
  backfill          Boolean   @default(false)
  /// First opened in SampForce; until then it is highlighted as new.
  seenAt            DateTime? @map("seen_at")
  seenById          String?   @map("seen_by_id")
  starred           Boolean   @default(false)
  assigneeId        String?   @map("assignee_id")
  stage             String?
  note              String?
  /// The company and employee this enquiry became or was linked to.
  companyId         String?   @map("company_id")
  contactId         String?   @map("contact_id")
  convertedAt       DateTime? @map("converted_at")
  convertedById     String?   @map("converted_by_id")
  /// Status, stage, owner and note waiting to be sent back to the website (PATCH /leads/:id); null when nothing waits.
  writeBackAt       DateTime? @map("write_back_at")
  writeBackTries    Int       @default(0) @map("write_back_tries")
  writeBackError    String?   @map("write_back_error")
  writtenBackAt     DateTime? @map("written_back_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, record, externalId])
  @@index([tenantId, submittedAt])
  @@index([tenantId, status])
  @@index([tenantId, seenAt])
  @@index([tenantId, email])
  @@index([tenantId, contactId])
  @@index([tenantId, companyId])
  @@index([writeBackAt])
  @@map("website_enquiries")
}

// ───────────── Enhancement Part 2: Prospect Lists and prospect discovery ─────────────

/// A named list of prospects: people the team may contact, kept out of the CRM until someone adds them.
model ProspectList {
  id          String   @id @default(uuid()) @map("_id")
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  ownerId     String?  @map("owner_id")
  /// The team member who works this list.
  assigneeId  String?  @map("assignee_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  prospects Prospect[]
  outreach  ProspectOutreach[]
  imports   ProspectImport[]

  @@unique([tenantId, name])
  @@map("prospect_lists")
}

model Prospect {
  id             String    @id @default(uuid()) @map("_id")
  tenantId       String    @map("tenant_id")
  listId         String    @map("list_id")
  fullName       String    @map("full_name")
  firstName      String?   @map("first_name")
  lastName       String?   @map("last_name")
  /// Lower-cased.
  email          String?
  /// verified | unverified | risky | invalid; null when no address.
  emailStatus    String?   @map("email_status")
  emailCheckedAt DateTime? @map("email_checked_at")
  title          String?
  companyName    String?   @map("company_name")
  domain         String?
  industry       String?
  country        String?
  companySize    String?   @map("company_size")
  phone          String?
  notes          String?
  source         String
  /// The provider's own id, to reveal or refresh the record.
  sourceRef      String?   @map("source_ref")
  /// Mock Mode sample person on a reserved .example domain; never added to the CRM, enrolled or exported.
  sample         Boolean   @default(false)
  leadId         String?   @map("lead_id")
  contactId      String?   @map("contact_id")
  createdById    String?   @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  list    ProspectList @relation(fields: [listId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lead    Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  contact Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([tenantId, listId, createdAt])
  @@index([listId, email])
  @@index([tenantId, email])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([leadId])
  @@index([contactId])
  @@map("prospects")
}

/// A list sent to a sequence, so list-level outreach results can be reported.
model ProspectOutreach {
  id          String   @id @default(uuid()) @map("_id")
  tenantId    String   @map("tenant_id")
  listId      String   @map("list_id")
  sequenceId  String   @map("sequence_id")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  list     ProspectList @relation(fields: [listId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sequence Sequence     @relation(fields: [sequenceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([listId, sequenceId])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([sequenceId])
  @@map("prospect_outreach")
}

/// A parsed CSV or Excel file waiting for its column mapping. Deleted once imported or after a day.
model ProspectImport {
  id        String   @id @default(uuid()) @map("_id")
  tenantId  String   @map("tenant_id")
  listId    String   @map("list_id")
  userId    String   @map("user_id")
  fileName  String   @map("file_name")
  kind      String
  headers   Json
  rows      Json
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  list   ProspectList @relation(fields: [listId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, createdAt])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([listId])
  @@map("prospect_imports")
}

/// Each provider call (search, email reveal, verification) a person makes, for the daily allowance and history.
model ProviderUsage {
  id        String   @id @default(uuid()) @map("_id")
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  provider  String
  kind      String
  units     Int      @default(1)
  /// False in Mock Mode: nothing was sent to a provider.
  live      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, userId, createdAt])
  @@map("provider_usage")
}

/// Per-workspace provider allowance: a default number of provider calls per person per 24 hours, with overrides.
model ProspectSettings {
  tenantId     String    @id @map("_id")
  dailyLimit   Int       @map("daily_limit")
  userLimits   Json      @default("{}") @map("user_limits")
  /// When a provider call last succeeded with a real key, so the integration can be shown as live.
  apolloLiveAt DateTime? @map("apollo_live_at")
  hunterLiveAt DateTime? @map("hunter_live_at")
  updatedById  String?   @map("updated_by_id")
  updatedAt    DateTime  @default(now()) @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("prospect_settings")
}

enum AppProvider {
  SLACK
  TEAMS
  ZOOM
  DOCUSIGN
  /// Card payments on quotes, into the workspace's own Stripe or Razorpay account.
  PAYMENTS
  /// The workspace's own WhatsApp Business Platform (Cloud API) number.
  WHATSAPP
  /// The workspace's own Twilio account and SMS number.
  TWILIO
  /// The workspace's own SampBidx bidding tool (ADR 0061): an API address and key, plus a callback signing secret.
  SAMPBIDX
  /// The workspace's own AI keys or AI server (ADR 0068), tried before the deployment's shared providers.
  AI
  /// The workspace's own email server (SMTP) for the email SampForce sends on the workspace's behalf (ADR 0068).
  SMTP
}

/// A workspace-level connection to an outside app (one per app per workspace), made by an admin through the
/// provider's OAuth. Tokens are envelope-encrypted (AES-256-GCM). Settings hold non-secret choices such as a channel.
model AppConnection {
  id                   String           @id @default(uuid()) @map("_id")
  tenantId             String           @map("tenant_id")
  provider             AppProvider
  /// The provider's id for the connected account (Slack team id), used to route inbound events.
  externalAccountId    String           @map("external_account_id")
  accountName          String           @map("account_name")
  scopes               String[]
  credentialsEncrypted String           @map("credentials_encrypted")
  settings             Json             @default("{}")
  status               ConnectionStatus @default(CONNECTED)
  lastError            String?          @map("last_error")
  lastUsedAt           DateTime?        @map("last_used_at")
  connectedById        String           @map("connected_by_id")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  events           AppEvent[]
  zoomMeetings     ZoomMeeting[]
  envelopes        SignatureEnvelope[]
  payments         QuotePayment[]
  whatsappMessages WhatsappMessage[]
  smsMessages      SmsMessage[]

  @@unique([tenantId, provider])
  @@index([provider, externalAccountId])
  @@map("app_connections")
}

/// What SampForce sent to or received from a connected app: one row per message, meeting, envelope or payment event.
model AppEvent {
  id           String      @id @default(uuid()) @map("_id")
  tenantId     String      @map("tenant_id")
  connectionId String?     @map("connection_id")
  provider     AppProvider
  /// e.g. message.sent, message.failed
  kind         String
  ok           Boolean
  /// The provider's id for the thing (message ts, meeting id, envelope id).
  externalId   String?     @map("external_id")
  summary      String
  detail       Json?
  entityType   String?     @map("entity_type")
  entityId     String?     @map("entity_id")
  actorUserId  String?     @map("actor_user_id")
  createdAt    DateTime    @default(now()) @map("created_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  connection AppConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([tenantId, provider, createdAt(sort: Desc)])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([connectionId])
  @@map("app_events")
}

/// A Zoom meeting scheduled from SampForce. Only these meetings' transcripts are ever imported.
model ZoomMeeting {
  id                 String   @id @default(uuid()) @map("_id")
  tenantId           String   @map("tenant_id")
  connectionId       String?  @map("connection_id")
  /// Zoom's numeric meeting id, as text.
  zoomMeetingId      String   @map("zoom_meeting_id")
  hostEmail          String   @map("host_email")
  topic              String
  startsAt           DateTime @map("starts_at")
  durationMinutes    Int      @map("duration_minutes")
  joinUrl            String   @map("join_url")
  /// The organiser chose cloud recording with the transcript imported afterwards.
  recordToCloud      Boolean  @default(false) @map("record_to_cloud")
  leadId             String?  @map("lead_id")
  contactId          String?  @map("contact_id")
  dealId             String?  @map("deal_id")
  createdById        String   @map("created_by_id")
  activityId         String?  @map("activity_id")
  meetingRecordId    String?  @map("meeting_record_id")
  /// none, waiting (recording on), ready (Zoom sent the transcript), imported, failed
  transcriptStatus   String   @default("none") @map("transcript_status")
  transcriptError    String?  @map("transcript_error")
  /// Sealed {url, token} from Zoom's recording.transcript_completed event, cleared after import.
  transcriptSource   String?  @map("transcript_source")
  transcriptAttempts Int      @default(0) @map("transcript_attempts")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  connection AppConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([tenantId, zoomMeetingId])
  @@index([tenantId, startsAt])
  @@index([transcriptStatus])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([connectionId])
  @@map("zoom_meetings")
}

/// A contract sent for e-signature through DocuSign. Status follows DocuSign Connect events.
model SignatureEnvelope {
  id             String    @id @default(uuid()) @map("_id")
  tenantId       String    @map("tenant_id")
  connectionId   String?   @map("connection_id")
  contractId     String    @map("contract_id")
  /// DocuSign's envelope id.
  envelopeId     String    @map("envelope_id")
  /// sent, delivered, completed, declined, voided
  status         String
  signerName     String    @map("signer_name")
  signerEmail    String    @map("signer_email")
  sentById       String    @map("sent_by_id")
  sentAt         DateTime  @default(now()) @map("sent_at")
  completedAt    DateTime? @map("completed_at")
  declinedReason String?   @map("declined_reason")
  voidedReason   String?   @map("voided_reason")
  lastEventAt    DateTime? @map("last_event_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  connection AppConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  contract   Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, envelopeId])
  @@index([tenantId, contractId])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([connectionId])
  @@index([contractId])
  @@map("signature_envelopes")
}

/// A card payment request for an accepted quote, in the workspace's own Stripe or Razorpay account.
model QuotePayment {
  id                String    @id @default(uuid()) @map("_id")
  tenantId          String    @map("tenant_id")
  connectionId      String?   @map("connection_id")
  quoteId           String    @map("quote_id")
  /// stripe or razorpay
  provider          String
  /// Stripe Checkout Session id or Razorpay payment link id.
  providerRef       String?   @map("provider_ref")
  /// pending, paid, expired, failed
  status            String    @default("pending")
  amount            Float
  currency          String
  payerEmail        String?   @map("payer_email")
  providerPaymentId String?   @map("provider_payment_id")
  paidAt            DateTime? @map("paid_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  connection AppConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  quote      Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, quoteId])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([connectionId])
  @@index([quoteId])
  @@map("quote_payments")
}

/// WhatsApp messages to and from the workspace's own WhatsApp Business number. Outbound rows are created when
/// Meta accepts the send; status moves forward only through the signed webhook. Inbound rows come from the webhook
/// and are matched to a contact by phone number when one matches exactly.
model WhatsappMessage {
  id           String    @id @default(uuid()) @map("_id")
  tenantId     String    @map("tenant_id")
  connectionId String?   @map("connection_id")
  contactId    String?   @map("contact_id")
  /// in or out
  direction    String
  /// International number, digits only.
  phone        String
  /// Meta's message id (wamid.…).
  waMessageId  String    @map("wa_message_id")
  /// template, text or other
  kind         String
  body         String
  templateName String?   @map("template_name")
  /// accepted, sent, delivered, read, failed (outbound) or received (inbound)
  status       String
  error        String?
  sentById     String?   @map("sent_by_id")
  /// manual, workflow or webhook
  source       String
  statusAt     DateTime? @map("status_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  connection AppConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  contact    Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([tenantId, waMessageId])
  @@index([tenantId, contactId, createdAt])
  @@index([tenantId, phone, createdAt])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([connectionId])
  @@index([contactId])
  @@map("whatsapp_messages")
}

/// A contact's agreement to receive WhatsApp messages, recorded by a person with how they agreed. Required before
/// any business-initiated (template) message. A STOP reply or a person revoking it sets revokedAt.
model WhatsappConsent {
  id           String    @id @default(uuid()) @map("_id")
  tenantId     String    @map("tenant_id")
  contactId    String    @map("contact_id")
  phone        String
  source       String
  recordedById String?   @map("recorded_by_id")
  revokedAt    DateTime? @map("revoked_at")
  revokedBy    String?   @map("revoked_by")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, contactId, createdAt])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([contactId])
  @@map("whatsapp_consents")
}

/// One SMS to or from the workspace's Twilio number. Status beyond "accepted" comes only from Twilio's signed callbacks.
model SmsMessage {
  id           String    @id @default(uuid()) @map("_id")
  tenantId     String    @map("tenant_id")
  connectionId String?   @map("connection_id")
  contactId    String?   @map("contact_id")
  /// in or out
  direction    String
  /// The other party's number in E.164 (+447700900123).
  phone        String
  /// Twilio's message SID (SM… or MM…).
  twilioSid    String    @map("twilio_sid")
  body         String
  /// How many SMS segments Twilio bills for this message (estimated before sending, from Twilio after).
  segments     Int       @default(1)
  /// accepted, sent, delivered, undelivered, failed (outbound) or received (inbound)
  status       String
  error        String?
  sentById     String?   @map("sent_by_id")
  /// manual, workflow or webhook
  source       String
  statusAt     DateTime? @map("status_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  connection AppConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  contact    Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([tenantId, twilioSid])
  @@index([tenantId, phone, createdAt])
  @@index([tenantId, contactId, createdAt])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([connectionId])
  @@index([contactId])
  @@map("sms_messages")
}

/// A contact's recorded agreement to receive SMS from the workspace. Every outbound SMS needs an active one.
model SmsConsent {
  id           String    @id @default(uuid()) @map("_id")
  tenantId     String    @map("tenant_id")
  contactId    String    @map("contact_id")
  phone        String
  source       String
  recordedById String?   @map("recorded_by_id")
  revokedAt    DateTime? @map("revoked_at")
  revokedBy    String?   @map("revoked_by")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, contactId, createdAt])
  @@index([tenantId, phone])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([contactId])
  @@map("sms_consents")
}

/// A workspace API key (Zapier, Make, n8n, scripts). Only the SHA-256 hash is stored. A key acts as its creator,
/// limited to its scopes and to the creator's current role; it stops working when revoked, expired, or when the
/// creator leaves the workspace.
model ApiKey {
  id          String    @id @default(uuid()) @map("_id")
  tenantId    String    @map("tenant_id")
  name        String
  prefix      String
  keyHash     String    @unique @map("key_hash")
  scopes      String[]
  createdById String    @map("created_by_id")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  webhooks Webhook[]

  @@index([tenantId, createdAt])
  @@map("api_keys")
}

/// A plan feature granted (enabled = true) or withheld (false) for one workspace by a platform operator, whatever its
/// plan includes (ADR 0057). Removing the row hands the decision back to the plan.
model TenantFeatureOverride {
  id        String   @id @default(uuid()) @map("_id")
  tenantId  String   @map("tenant_id")
  feature   String
  enabled   Boolean
  reason    String
  updatedBy String   @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, feature])
  @@map("tenant_feature_overrides")
}

/// One per won deal, or per won RFQ that never became a deal (ADR 0063). Voided when the deal is reopened, lost or
/// deleted, so revenue always matches the won records.
model RevenueRecord {
  id               String    @id @default(uuid()) @map("_id")
  tenantId         String    @map("tenant_id")
  /// DEAL or RFQ.
  source           String
  opportunityId    String?   @map("opportunity_id")
  rfqId            String?   @map("rfq_id")
  companyId        String?   @map("company_id")
  project          String
  amount           Float
  currency         String
  closedAt         DateTime  @map("closed_at")
  closerId         String?   @map("closer_id")
  leadCreatorId    String?   @map("lead_creator_id")
  accountOwnerId   String?   @map("account_owner_id")
  managerId        String?   @map("manager_id")
  departmentId     String?   @map("department_id")
  /// Credits entered by hand; a rule change leaves them alone.
  manual           Boolean   @default(false)
  recognisedAmount Float?    @map("recognised_amount")
  collectedAmount  Float?    @map("collected_amount")
  paymentStatus    String?   @map("payment_status")
  voidedAt         DateTime? @map("voided_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, voidedAt, closedAt])
  @@index([tenantId, opportunityId])
  @@index([tenantId, rfqId])
  @@index([tenantId, companyId])
  @@map("revenue_records")
}

/// A person's share of a revenue record; the shares of a record sum to 100.
model RevenueCredit {
  id        String   @id @default(uuid()) @map("_id")
  tenantId  String   @map("tenant_id")
  recordId  String   @map("record_id")
  userId    String?  @map("user_id")
  roles     String[]
  percent   Float
  /// Copied from the record so totals per person and period need one query.
  closedAt  DateTime @map("closed_at")
  voided    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, recordId])
  @@index([tenantId, userId, voided, closedAt])
  @@map("revenue_credits")
}

/// A request to move a lead to a manager or senior person (section 16), decided by someone above the requester.
model LeadTransfer {
  id               String    @id @default(uuid()) @map("_id")
  tenantId         String    @map("tenant_id")
  companyId        String    @map("company_id")
  contactId        String?   @map("contact_id")
  fromUserId       String?   @map("from_user_id")
  toUserId         String?   @map("to_user_id")
  requestedById    String    @map("requested_by_id")
  reason           String
  opportunityValue Float?    @map("opportunity_value")
  currency         String?
  remarks          String?
  fileIds          String[]  @map("file_ids")
  /// TRANSFER_STATUSES.
  status           String    @default("PENDING")
  decidedById      String?   @map("decided_by_id")
  decidedAt        DateTime? @map("decided_at")
  decisionNote     String?   @map("decision_note")
  instructions     String?
  newOwnerId       String?   @map("new_owner_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  /// When the requester last changed the pending request.
  editedAt         DateTime? @map("edited_at")

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, requestedById, createdAt(sort: Desc)])
  @@index([tenantId, companyId])
  @@map("lead_transfers")
}

/// An instruction or remark a manager or senior person sends to someone below them (ADR 0063, spec 15.2). The
/// recipient acknowledges it and marks it done.
model Instruction {
  id             String    @id @default(uuid()) @map("_id")
  tenantId       String    @map("tenant_id")
  fromId         String    @map("from_id")
  toId           String    @map("to_id")
  /// INSTRUCTION or REMARK.
  kind           String    @default("INSTRUCTION")
  message        String
  companyId      String?   @map("company_id")
  contactId      String?   @map("contact_id")
  /// LOW, NORMAL, HIGH or URGENT.
  priority       String    @default("NORMAL")
  dueAt          DateTime? @map("due_at")
  /// OPEN, ACKNOWLEDGED, DONE or CANCELLED.
  status         String    @default("OPEN")
  acknowledgedAt DateTime? @map("acknowledged_at")
  completedAt    DateTime? @map("completed_at")
  completionNote String?   @map("completion_note")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  /// When the sender last changed the message or its details.
  editedAt       DateTime? @map("edited_at")

  @@index([tenantId, toId, status])
  @@index([tenantId, fromId, createdAt(sort: Desc)])
  @@index([tenantId, companyId])
  @@map("instructions")
}

/// A person's order and hidden sections of one tier dashboard, and their own My Work categories.
model CommandCenterLayout {
  id        String   @id @default(uuid()) @map("_id")
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  tier      String
  layout    Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, userId, tier])
  @@map("command_center_layouts")
}

// ───────────── ADR 0062: custom fields and CRM administration ─────────────

/// A file uploaded into a FILE custom field. Kept until the record that holds it is deleted or the value is cleared.
model CustomFieldFile {
  id           String            @id @default(uuid()) @map("_id")
  tenantId     String            @map("tenant_id")
  entity       CustomFieldEntity
  fieldKey     String            @map("field_key")
  /// The record holding it; null between upload and the record being saved.
  recordId     String?           @map("record_id")
  name         String
  contentType  String            @map("content_type")
  sizeBytes    Int               @map("size_bytes")
  data         Bytes
  sha256       String
  uploadedById String            @map("uploaded_by_id")
  createdAt    DateTime          @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, entity, recordId])
  @@map("custom_field_files")
}

/// A label, colour, description, order and on/off switch for an RFQ status, deal status or follow-up category.
/// Built-in values without a row use their defaults (BUILT_IN_OPTIONS in packages/types/src/crm-admin.ts).
model CrmOption {
  id          String   @id @default(uuid()) @map("_id")
  tenantId    String   @map("tenant_id")
  kind        String
  value       String
  label       String
  color       String
  description String?
  position    Int      @default(0)
  active      Boolean  @default(true)
  builtIn     Boolean  @default(true) @map("built_in")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, kind, value])
  @@map("crm_options")
}

/// One per workspace: notification settings, export permissions, dashboard policies and enabled currencies.
/// Null means the default (DEFAULT_NOTIFICATION_SETTINGS, no export limits, DEFAULT_DASHBOARD_POLICY).
model CrmSettings {
  id                String   @id @default(uuid()) @map("_id")
  tenantId          String   @unique @map("tenant_id")
  notifications     Json?
  exportPolicy      Json?    @map("export_policy")
  dashboardPolicies Json?    @map("dashboard_policies")
  enabledCurrencies String[] @default([]) @map("enabled_currencies")
  /// Redesign R3 (ADR 0083): the workspace's local date of the last morning follow-up summary, so it goes out once a day.
  digestDate        String?  @map("digest_date")
  /// { followUps, intervalDays, updatedAt, updatedById } (ADR 0083); null = 5 follow-ups 7 days apart.
  followUpCadence   Json?    @map("follow_up_cadence")
  /// Journey stage names, colours and hidden flags set by the Super Workspace (ADR 0085).
  journeyStages     Json?    @map("journey_stages")
  /// The company's own special days shown on the home dashboards: [{ id, title, emoji, date, yearly, note }].
  companyEvents     Json?    @map("company_events")
  updatedById       String?  @map("updated_by_id")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("crm_settings")
}

// ───────────── Team chat (ADR 0064) ─────────────

enum ChatKind {
  DIRECT
  CHANNEL
  SUPPORT
  /// With the SampBidx bidding team (ADR 0078): directKey "sampbidx" for the general line, "sampbidx:<transfer id>"
  /// for one RFQ sent to SampBidx.
  SAMPBIDX
}

enum ChatMemberRole {
  OWNER
  MEMBER
}

enum ChatLinkType {
  COMPANY
  RFQ
  DEAL
}

/// A direct message between two people, a group channel, or the workspace's support line to super admins.
model ChatConversation {
  id                 String        @id @default(uuid()) @map("_id")
  tenantId           String        @map("tenant_id")
  kind               ChatKind
  name               String?
  topic              String?
  /// Direct messages only: the two user ids, sorted and joined, so a pair has one conversation. "support" for the
  /// support line, of which a workspace has one.
  directKey          String?       @map("direct_key")
  createdById        String?       @map("created_by_id")
  linkType           ChatLinkType? @map("link_type")
  linkId             String?       @map("link_id")
  linkLabel          String?       @map("link_label")
  archivedAt         DateTime?     @map("archived_at")
  lastMessageAt      DateTime?     @map("last_message_at")
  lastMessagePreview String?       @map("last_message_preview")
  /// SAMPBIDX conversations about one RFQ: the transfer it is about.
  sampbidxTransferId String?       @map("sampbidx_transfer_id")
  /// SAMPBIDX conversations: the SampBidx people who have written in it ({id, name, email, role}[], latest first).
  sampbidxPeople     Json?         @map("sampbidx_people")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  members  ChatMember[]
  messages ChatMessage[]

  @@unique([tenantId, directKey])
  @@index([tenantId, lastMessageAt(sort: Desc)])
  @@map("chat_conversations")
}

/// One person in a conversation: a workspace user, or (support line) a super admin from the operator console.
model ChatMember {
  id              String         @id @default(uuid()) @map("_id")
  tenantId        String         @map("tenant_id")
  conversationId  String         @map("conversation_id")
  userId          String?        @map("user_id")
  operatorId      String?        @map("operator_id")
  role            ChatMemberRole @default(MEMBER)
  /// Everything up to this time has been read (read receipts and unread counts).
  lastReadAt      DateTime?      @map("last_read_at")
  /// Everything up to this time has reached one of this person's devices ("Delivered" ticks).
  lastDeliveredAt DateTime?      @map("last_delivered_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([conversationId, userId])
  @@unique([conversationId, operatorId])
  @@index([tenantId, userId])
  @@index([operatorId])
  @@map("chat_members")
}

model ChatMessage {
  id               String        @id @default(uuid()) @map("_id")
  tenantId         String        @map("tenant_id")
  conversationId   String        @map("conversation_id")
  authorUserId     String?       @map("author_user_id")
  authorOperatorId String?       @map("author_operator_id")
  /// Chosen by the sender's browser; a message sent twice from an outbox is stored once.
  clientId         String        @map("client_id")
  body             String
  /// When it was written, if it waited in the browser's outbox before reaching the server.
  writtenAt        DateTime?     @map("written_at")
  linkType         ChatLinkType? @map("link_type")
  linkId           String?       @map("link_id")
  linkLabel        String?       @map("link_label")
  editedAt         DateTime?     @map("edited_at")
  deletedAt        DateTime?     @map("deleted_at")
  /// Written in SampBidx (ADR 0078): {id, name, email, role}. clientId is then "sampbidx:<SampBidx's message id>".
  externalAuthor   Json?         @map("external_author")
  /// A line from SampBidx about the RFQ (a status change), not a person's message.
  system           Boolean?
  /// Written in SampForce in a SAMPBIDX conversation: SENDING, SENT or FAILED, and the tries so far.
  remoteDelivery   String?       @map("remote_delivery")
  remoteAttempts   Int?          @map("remote_attempts")
  remoteError      String?       @map("remote_error")
  remoteId         String?       @map("remote_id")
  /// When the worker may try again.
  remoteRetryAt    DateTime?     @map("remote_retry_at")
  /// Emoji reactions (redesign R9): { "👍": ["<user or operator id>", ...] }, at most CHAT_REACTIONS_MAX emoji.
  reactions        Json?
  createdAt        DateTime      @default(now()) @map("created_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([conversationId, clientId])
  @@index([remoteDelivery, remoteRetryAt])
  @@index([tenantId, conversationId, createdAt(sort: Desc)])
  @@map("chat_messages")
}

/// A file sent in a chat. Uploaded first, then attached to the message that sends it.
model ChatAttachment {
  id                   String   @id @default(uuid()) @map("_id")
  tenantId             String   @map("tenant_id")
  conversationId       String   @map("conversation_id")
  messageId            String?  @map("message_id")
  uploadedByUserId     String?  @map("uploaded_by_user_id")
  uploadedByOperatorId String?  @map("uploaded_by_operator_id")
  name                 String
  contentType          String   @map("content_type")
  sizeBytes            Int      @map("size_bytes")
  data                 Bytes
  sha256               String
  createdAt            DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, messageId])
  @@index([tenantId, conversationId, createdAt(sort: Desc)])
  @@map("chat_attachments")
}

/// Live chat events, so every API server delivers them to the people connected to it. Kept for a few minutes.
model ChatSignal {
  id             String   @id @default(uuid()) @map("_id")
  tenantId       String   @map("tenant_id")
  conversationId String   @map("conversation_id")
  /// The API server that wrote it (that server has already delivered it).
  instance       String
  event          Json
  /// Workspace users to tell, and whether the deployment's super admins are told too.
  userIds        String[] @map("user_ids")
  operators      Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@map("chat_signals")
}

// ───────────────────────────── Mobile app (ADR 0072) ─────────────────────────────

/// Mobile app access of one organisation: the Console Admin's decision and the Super Workspace's activation.
model MobileAccess {
  id                  String    @id @default(uuid()) @map("_id")
  tenantId            String    @unique @map("tenant_id")
  /// OFF, REQUESTED, APPROVED, REJECTED, SUSPENDED or REVOKED (MOBILE_ACCESS_STATUSES).
  status              String    @default("OFF")
  requestMessage      String?   @map("request_message")
  requestedAt         DateTime? @map("requested_at")
  requestedById       String?   @map("requested_by_id")
  /// The Console's last decision: why, when and by which operator.
  decisionStatus      String?   @map("decision_status")
  decisionReason      String?   @map("decision_reason")
  decidedAt           DateTime? @map("decided_at")
  decidedByOperatorId String?   @map("decided_by_operator_id")
  /// Set while the Super Workspace has mobile access switched on for its people.
  activatedAt         DateTime? @map("activated_at")
  activatedById       String?   @map("activated_by_id")
  /// Phones signed in at once across the organisation; null = no limit.
  maxDevices          Int?      @map("max_devices")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("mobile_access")
}

/// A phone (or the app's web build) signed in to an organisation. One row per person, organisation and app install.
model MobileDevice {
  id          String    @id @default(uuid()) @map("_id")
  tenantId    String    @map("tenant_id")
  userId      String    @map("user_id")
  /// Random id the app keeps in secure storage, so signing in again on the same phone reuses the row.
  installId   String    @map("install_id")
  /// IOS, ANDROID or WEB.
  platform    String
  model       String?
  osVersion   String?   @map("os_version")
  appVersion  String?   @map("app_version")
  name        String?
  /// Push token for this phone (M8); null until the person allows notifications.
  pushToken   String?   @map("push_token")
  /// Null while the phone is signed in.
  signedOutAt DateTime? @map("signed_out_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, userId, installId])
  @@index([tenantId, signedOutAt])
  @@map("mobile_devices")
}

/// ADR 0072 (M8): a push notification waiting to go to one person's phones through Expo's push service. Written in the
/// same transaction as the event; the worker checks the person's Mobile Configuration and sends it.
model MobilePush {
  id            String    @id @default(uuid()) @map("_id")
  tenantId      String    @map("tenant_id")
  userId        String    @map("user_id")
  /// One of MOBILE_NOTIFICATION_TYPES.
  type          String
  title         String
  body          String?
  /// Where a tap opens the app ("/companies/…"), or null for the notifications screen.
  route         String?   @map("route")
  /// PENDING, SENT, SKIPPED (no phone, or switched off) or FAILED.
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  /// How many phones it went to.
  sentTo        Int       @default(0) @map("sent_to")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")
  sentAt        DateTime? @map("sent_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status, nextAttemptAt])
  @@index([tenantId, userId, createdAt])
  @@map("mobile_pushes")
}

/// ADR 0072 (M8): a notice from the Super Workspace to everyone in the organisation, shown on the web and the phone
/// and sent as a notification.
model Announcement {
  id          String   @id @default(uuid()) @map("_id")
  tenantId    String   @map("tenant_id")
  title       String
  body        String
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, createdAt])
  @@map("announcements")
}

/// ADR 0072 (M2): the Super Workspace's Mobile Configuration Center. One draft per organisation; publishing copies it
/// into a numbered MobileConfigVersion, which is what phones get. Rolling back publishes an older version again.
model MobileConfig {
  id               String    @id @default(uuid()) @map("_id")
  tenantId         String    @unique @map("tenant_id")
  /// The draft, normalised (see normalizeMobileConfig in @dealflow/types).
  draft            Json
  draftUpdatedAt   DateTime? @map("draft_updated_at")
  draftUpdatedById String?   @map("draft_updated_by_id")
  /// The version phones get; null until the first publish (phones then get the built-in default).
  publishedVersion Int?      @map("published_version")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("mobile_configs")
}

model MobileConfigVersion {
  id            String   @id @default(uuid()) @map("_id")
  tenantId      String   @map("tenant_id")
  version       Int
  config        Json
  note          String?
  /// Set when this version republished an older one (a rollback).
  restoredFrom  Int?     @map("restored_from")
  publishedById String?  @map("published_by_id")
  publishedAt   DateTime @default(now()) @map("published_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, version])
  @@map("mobile_config_versions")
}

// ───────────── Help Center support tickets (ADR 0073) ─────────────

enum SupportTicketStatus {
  SUBMITTED
  UNDER_REVIEW
  IN_PROGRESS
  AWAITING_USER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
}

/// Who is answering a ticket now. Every ticket goes to the Console today; workspace routing (ADR 0071 part 5) starts
/// Executive tickets at their manager and escalates upwards.
enum SupportHandlerLevel {
  MANAGER
  SUPER
  CONSOLE
}

enum SupportAuthorKind {
  /// The person who raised the ticket, or a colleague in the same workspace.
  USER
  /// A manager or Super Workspace administrator answering from above.
  WORKSPACE
  /// A SampForce operator in the Console.
  OPERATOR
}

/// A query raised from Help ("Other: raise a query"), in the web app or the mobile app.
model SupportTicket {
  id                   String                @id @default(uuid()) @map("_id")
  tenantId             String                @map("tenant_id")
  /// Per organisation, for "#12" references.
  number               Int
  /// The raiser's workspace in the hierarchy; null = the Super Workspace.
  workspaceNodeId      String?               @map("workspace_node_id")
  raisedByUserId       String                @map("raised_by_user_id")
  raisedByMembershipId String                @map("raised_by_membership_id")
  subject              String
  /// A Help Center category id, such as "deals" or "billing".
  category             String
  featureKey           String?               @map("feature_key")
  /// The page the person was on when they asked.
  pagePath             String?               @map("page_path")
  /// "web" or "mobile".
  source               String                @default("web")
  priority             SupportTicketPriority @default(NORMAL)
  status               SupportTicketStatus   @default(SUBMITTED)
  handlerLevel         SupportHandlerLevel   @default(CONSOLE) @map("handler_level")
  handlerNodeId        String?               @map("handler_node_id")
  /// The SampForce operator looking after a Console ticket.
  assignedOperatorId   String?               @map("assigned_operator_id")
  /// How it was resolved, written by whoever closes or answers it last.
  resolutionNote       String?               @map("resolution_note")
  escalatedAt          DateTime?             @map("escalated_at")
  lastMessageAt        DateTime              @default(now()) @map("last_message_at")
  answeredAt           DateTime?             @map("answered_at")
  closedAt             DateTime?             @map("closed_at")
  resolvedAt           DateTime?             @map("resolved_at")
  /// With category "other": the raiser's own name for the kind of problem.
  categoryOther        String?               @map("category_other")
  /// lead, contact, company or deal; the label is the record's name when the query was raised.
  relatedRecordType    String?               @map("related_record_type")
  relatedRecordId      String?               @map("related_record_id")
  relatedRecordLabel   String?               @map("related_record_label")
  /// IN_APP, EMAIL or PHONE.
  contactMethod        String                @default("IN_APP") @map("contact_method")
  contactPhone         String?               @map("contact_phone")
  appVersion           String?               @map("app_version")
  /// Captured by the server when raised: workspace name and level, role name, email.
  context              Json?
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages SupportTicketMessage[]

  @@unique([tenantId, number])
  @@index([tenantId, raisedByUserId, lastMessageAt(sort: Desc)])
  @@index([status, lastMessageAt(sort: Desc)])
  @@index([tenantId, handlerLevel, handlerNodeId, lastMessageAt(sort: Desc)])
  @@index([handlerLevel, createdAt])
  @@index([handlerLevel, escalatedAt])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id                 String            @id @default(uuid()) @map("_id")
  tenantId           String            @map("tenant_id")
  ticketId           String            @map("ticket_id")
  authorKind         SupportAuthorKind @map("author_kind")
  authorUserId       String?           @map("author_user_id")
  authorMembershipId String?           @map("author_membership_id")
  operatorId         String?           @map("operator_id")
  body               String
  createdAt          DateTime          @default(now()) @map("created_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, ticketId, createdAt])
  /// Relation lookups (counts, "has any" filters) match on this field alone, so it needs its own index.
  @@index([ticketId])
  @@map("support_ticket_messages")
}

/// Screenshots and files on a support ticket's messages (ADR 0073). Uploaded first, then sent with a message.
model SupportTicketAttachment {
  id                   String   @id @default(uuid()) @map("_id")
  tenantId             String   @map("tenant_id")
  ticketId             String?  @map("ticket_id")
  messageId            String?  @map("message_id")
  uploadedByUserId     String?  @map("uploaded_by_user_id")
  uploadedByOperatorId String?  @map("uploaded_by_operator_id")
  name                 String
  contentType          String   @map("content_type")
  sizeBytes            Int      @map("size_bytes")
  data                 Bytes
  sha256               String
  createdAt            DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, ticketId, messageId])
  @@map("support_ticket_attachments")
}

/// When a workspace user was last connected to team chat (online/offline dots). One per person and workspace.
model ChatPresence {
  id         String    @id @default(uuid()) @map("_id")
  tenantId   String    @map("tenant_id")
  userId     String    @map("user_id")
  /// Refreshed about every 30 seconds while the person has SampForce open on any device.
  lastSeenAt DateTime  @map("last_seen_at")
  /// Set when their last connection to this server closed; a later lastSeenAt means they came back.
  offlineAt  DateTime? @map("offline_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, userId])
  @@map("chat_presence")
}

// ── Help Center content managed in the Console (ADR 0073) ──────────────────────────────────────────────────────────
// Built-in help lives in packages/help; the Console adds articles, edits or hides built-in ones, and reads feedback.

enum HelpArticleKind {
  FAQ
  GUIDE
  ANNOUNCEMENT
  /// A brief about a part of SampForce, its offering or a facility (Explore SampForce).
  FEATURE
}

enum HelpArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// A help article the Console writes, or its edit of a built-in answer or guide (builtinKey "faq:…" or "guide:…").
/// Text fields hold { en, es?, fr?, de?, ar? }; a missing language falls back to English.
model HelpArticle {
  id                  String            @id @default(uuid()) @map("_id")
  kind                HelpArticleKind
  builtinKey          String?           @unique @map("builtin_key")
  /// "workspace" or "console".
  audience            String            @default("workspace")
  categoryId          String            @map("category_id")
  title               Json
  /// The short answer (FAQs) or what it is for (guides).
  summary             Json
  /// The full article: paragraphs, "1." steps, "-" points, "## " headings and media:<id> images.
  body                Json
  featureKey          String?           @map("feature_key")
  /// Empty = every level. SUPER, MANAGER, EXECUTIVE.
  levels              String[]
  /// Empty = every role. Role keys, such as owner, admin, member.
  roleKeys            String[]          @map("role_keys")
  /// Empty = every client. Otherwise only these organisations see it.
  tenantIds           String[]          @map("tenant_ids")
  videoUrl            String?           @map("video_url")
  /// Shown first: an announcement banner, or an important article at the top of its topic.
  pinned              Boolean           @default(false)
  status              HelpArticleStatus @default(DRAFT)
  version             Int               @default(1)
  publishedAt         DateTime?         @map("published_at")
  createdByOperatorId String?           @map("created_by_operator_id")
  updatedByOperatorId String?           @map("updated_by_operator_id")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@index([status, audience])
  @@map("help_articles")
}

/// Each saved version of an article, so the Console can see what changed and restore an earlier one.
model HelpArticleVersion {
  id         String   @id @default(uuid()) @map("_id")
  articleId  String   @map("article_id")
  version    Int
  snapshot   Json
  operatorId String?  @map("operator_id")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([articleId, version])
  @@map("help_article_versions")
}

/// Topics and subtopics the Console adds next to the built-in ones.
model HelpCategoryEntry {
  id          String    @id @map("_id")
  parentId    String?   @map("parent_id")
  audience    String    @default("workspace")
  title       Json
  description Json
  icon        String    @default("book-open")
  tone        Int       @default(1)
  sortOrder   Int       @default(100) @map("sort_order")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("help_categories")
}

/// Images, screenshots and files used in help articles. Public to signed-in readers once an article uses them.
model HelpMedia {
  id          String   @id @default(uuid()) @map("_id")
  name        String
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  data        Bytes
  sha256      String
  operatorId  String?  @map("operator_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("help_media")
}

/// How often each article is read and found helpful, across everyone. No one's own reading history is kept.
model HelpArticleStat {
  id         String   @id @default(uuid()) @map("_id")
  articleKey String   @unique @map("article_key")
  views      Int      @default(0)
  helpful    Int      @default(0)
  notHelpful Int      @default(0) @map("not_helpful")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("help_article_stats")
}

/// "Was this helpful?" at the end of an article, one answer per person and article, with an optional comment.
/// A message sent from Help & Support on the public website by someone who is not signed in (ADR 0078). Global: it
/// belongs to no workspace. The Console reads it under Support tickets > Website messages.
model SiteSupportRequest {
  id                  String    @id @default(uuid()) @map("_id")
  /// Short reference shown to the visitor, such as "SF-7K2M9Q".
  reference           String    @unique
  name                String
  email               String
  /// SIGN_IN, SIGN_UP, BILLING, SALES or OTHER.
  topic               String
  message             String
  pagePath            String?   @map("page_path")
  language            String?
  /// NEW or HANDLED.
  status              String    @default("NEW")
  handledAt           DateTime? @map("handled_at")
  handledByOperatorId String?   @map("handled_by_operator_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt(sort: Desc)])
  @@map("site_support_requests")
}

model HelpFeedback {
  id         String    @id @default(uuid()) @map("_id")
  tenantId   String    @map("tenant_id")
  userId     String    @map("user_id")
  articleKey String    @map("article_key")
  helpful    Boolean
  comment    String?
  /// Set when the Console has read it and acted.
  reviewedAt DateTime? @map("reviewed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, userId, articleKey])
  @@index([articleKey, createdAt(sort: Desc)])
  @@map("help_feedback")
}

/// Help & Support settings of one organisation (ADR 0073): what the Console allows and what the Super Workspace chose.
/// Raising and following queries is never switched off by these.
model HelpSettings {
  id                String   @id @default(uuid()) @map("_id")
  tenantId          String   @unique @map("tenant_id")
  /// Set by the Console: the Help Center's answers and guides for this client.
  helpEnabled       Boolean  @default(true) @map("help_enabled")
  /// Set by the Super Workspace: the Help icon in the top bar.
  menuVisible       Boolean  @default(true) @map("menu_visible")
  /// Set by the Super Workspace: list features people cannot use, with why and who can grant them.
  explainRestricted Boolean  @default(true) @map("explain_restricted")
  /// Set by the Super Workspace: a note shown in Help, such as who to ask inside the company first.
  supportNote       String?  @map("support_note")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("help_settings")
}

/// A person's working day (redesign R1, ADR 0081): from check-in to check-out, with its breaks. At most one open
/// session per person; one left open for a whole day is closed at the person's last sign of life.
model WorkSession {
  id              String    @id @default(uuid()) @map("_id")
  tenantId        String    @map("tenant_id")
  userId          String    @map("user_id")
  /// The workspace the person was in when they checked in (for the team boards).
  workspaceNodeId String?   @map("workspace_node_id")
  checkedInAt     DateTime  @map("checked_in_at")
  checkedOutAt    DateTime? @map("checked_out_at")
  /// [{ start, end }] as ISO strings; the last one has end null while the break runs.
  breaks          Json      @default("[]")
  /// The status the person chose while checked in: AVAILABLE, WORKING or AWAY.
  chosenStatus    String    @default("WORKING") @map("chosen_status")
  /// When the shown status last changed (check-in, break, resume, choice).
  statusSince     DateTime  @map("status_since")
  /// Refreshed while the person has a SampForce page open; Away shows when it gets old.
  lastSeenAt      DateTime  @map("last_seen_at")
  /// Set when SampForce closed a forgotten session by itself.
  autoClosed      Boolean   @default(false) @map("auto_closed")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, userId, checkedInAt(sort: Desc)])
  @@index([tenantId, checkedOutAt])
  @@map("work_sessions")
}

/// Append-only log of check-ins, breaks, status changes and check-outs (ADR 0081).
model AvailabilityEvent {
  id        String   @id @default(uuid()) @map("_id")
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  sessionId String   @map("session_id")
  /// CHECK_IN, BREAK_START, BREAK_END, STATUS, CHECK_OUT or AUTO_CHECK_OUT.
  kind      String
  /// The status shown after the event.
  status    String
  at        DateTime @default(now())

  @@index([tenantId, userId, at(sort: Desc)])
  @@index([tenantId, sessionId])
  @@map("availability_events")
}

/// A real achievement of one person (ADR 0090): recorded once, in the same transaction as the business change that
/// earned it, so a refresh, an edit or a sync can never record or celebrate it twice.
model Achievement {
  id          String    @id @default(uuid()) @map("_id")
  tenantId    String    @map("tenant_id")
  userId      String    @map("user_id")
  /// DEAL_CONVERTED, PROSPECT_CONVERTED, RFQ_SUBMITTED, TASK_IMPORTANT, ALL_TASKS_DONE, LEAD_MILESTONE, LEAD_TARGET,
  /// SALES_TARGET, DEALS_WON_MILESTONE, MAJOR_DEAL or CONSISTENCY.
  kind        String
  /// deals, rfqs, tasks, leads, sales or consistency (what the person can switch off).
  category    String
  /// ROUTINE, DAILY, MAJOR or EXCEPTIONAL: how big the celebration is.
  level       String
  /// What makes it unique for the person, e.g. "company-won:<companyId>" or "leads:DAY:2026-11-26:50".
  dedupeKey   String    @map("dedupe_key")
  /// The figures shown: company, deal value, RFQ number, target and actual. Read from the records, never typed.
  details     Json      @default("{}")
  entityType  String?   @map("entity_type")
  entityId    String?   @map("entity_id")
  link        String?
  achievedAt  DateTime  @default(now()) @map("achieved_at")
  /// Whether the person's settings asked for a pop-up when it was earned.
  celebrate   Boolean   @default(true)
  /// When a browser tab took it to show (once, so a second tab or a refresh never replays it).
  shownAt     DateTime? @map("shown_at")

  @@unique([tenantId, userId, dedupeKey])
  @@index([tenantId, userId, achievedAt(sort: Desc)])
  @@index([tenantId, userId, shownAt])
  @@map("achievements")
}

/// A person's celebration settings and personal targets (ADR 0090).
model AchievementSettings {
  id                   String   @id @default(uuid()) @map("_id")
  tenantId             String   @map("tenant_id")
  userId               String   @map("user_id")
  enabled              Boolean  @default(true)
  /// SUBTLE or EXPRESSIVE.
  style                String   @default("EXPRESSIVE")
  sound                Boolean  @default(false)
  reduceMotion         Boolean  @default(false) @map("reduce_motion")
  /// Categories switched off (deals, rfqs, tasks, leads, sales, consistency).
  mutedCategories      String[] @map("muted_categories")
  /// Personal targets, used when no manager or Super Workspace target covers the period.
  dailyLeadTarget      Int?     @map("daily_lead_target")
  weeklyLeadTarget     Int?     @map("weekly_lead_target")
  monthlyLeadTarget    Int?     @map("monthly_lead_target")
  monthlyRevenueTarget Float?   @map("monthly_revenue_target")
  /// A won deal at least this big (workspace currency) counts as a major deal.
  majorDealAmount      Float?   @map("major_deal_amount")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, userId])
  @@map("achievement_settings")
}

/// A person's own dialer for the Calls section (ADR 0088): a link it opens (tel:, callto:, sip:, an app scheme or a
/// web dialer, with {placeholders} for the call details) or the workspace's Twilio number ringing their phone first.
/// Optionally every call's details are also posted, signed, to the dialer's webhook.
model Dialer {
  id                     String    @id @default(uuid()) @map("_id")
  tenantId               String    @map("tenant_id")
  userId                 String    @map("user_id")
  name                   String
  /// LINK or TWILIO
  kind                   String
  urlTemplate            String?   @map("url_template")
  webhookUrl             String?   @map("webhook_url")
  /// HMAC-SHA256 key for the webhook's X-SampForce-Signature, sealed with ENCRYPTION_KEY.
  webhookSecretEncrypted String?   @map("webhook_secret_encrypted")
  /// TWILIO: the person's own phone, rung first.
  agentPhone             String?   @map("agent_phone")
  isDefault              Boolean   @default(false) @map("is_default")
  lastUsedAt             DateTime? @map("last_used_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")

  @@index([tenantId, userId])
  @@map("dialers")
}

/// One call placed from the Calls section (ADR 0088), with the details handed to the dialer, what happened, the
/// remarks and talk time. Logging it writes a call interaction on the company (activityId) and, when a next call is
/// chosen, a call follow-up (followUpId).
model PhoneCall {
  id            String    @id @default(uuid()) @map("_id")
  tenantId      String    @map("tenant_id")
  userId        String    @map("user_id")
  companyId     String?   @map("company_id")
  contactId     String?   @map("contact_id")
  /// The number as dialled, and EMPLOYEE, COMPANY or OTHER (typed on the keypad).
  number        String
  numberSource  String    @map("number_source")
  dialerId      String?   @map("dialer_id")
  dialerName    String    @map("dialer_name")
  dialerKind    String    @map("dialer_kind")
  /// OPEN, RINGING, IN_PROGRESS, ENDED, FAILED or LOGGED
  status        String
  /// CALL_OUTCOMES in packages/types/src/calls.ts; null until logged.
  outcome       String?
  /// The details handed to the dialer: { companyName, companyPhone, employeeName, designation, email, employeePhone }.
  details       Json
  /// Lower-case company name, employee name and number, for the history search.
  searchText    String    @map("search_text")
  startedAt     DateTime  @default(now()) @map("started_at")
  answeredAt    DateTime? @map("answered_at")
  endedAt       DateTime? @map("ended_at")
  durationSec   Int?      @map("duration_sec")
  remarks       String?
  sentiment     String?
  activityId    String?   @map("activity_id")
  followUpId    String?   @map("follow_up_id")
  /// The webhook delivery: SENT or FAILED, when, and why it failed.
  webhookStatus String?   @map("webhook_status")
  webhookAt     DateTime? @map("webhook_at")
  webhookError  String?   @map("webhook_error")
  /// Twilio's call SID and its last status (queued, ringing, in-progress, completed, busy, no-answer, failed, canceled).
  twilioSid     String?   @map("twilio_sid")
  twilioStatus  String?   @map("twilio_status")
  error         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@index([tenantId, userId, startedAt(sort: Desc)])
  @@index([tenantId, startedAt(sort: Desc)])
  @@index([tenantId, contactId, startedAt(sort: Desc)])
  @@index([tenantId, companyId, startedAt(sort: Desc)])
  @@index([tenantId, twilioSid])
  @@map("phone_calls")
}
