model ProspectSettings {
  tenantId     String    @id @map("tenant_id") @db.Uuid
  dailyLimit   Int       @map("daily_limit")
  userLimits   Json      @default("{}") @map("user_limits")
  /// When a provider call last succeeded with a real key, so the integration can be shown as live.
  apolloLiveAt DateTime? @map("apollo_live_at") @db.Timestamptz(3)
  hunterLiveAt DateTime? @map("hunter_live_at") @db.Timestamptz(3)
  updatedById  String?   @map("updated_by_id") @db.Uuid
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("prospect_settings")
}

enum AppProvider {
  SLACK
  TEAMS
  ZOOM
  DOCUSIGN
  /// Card payments on quotes, into the workspace's own Stripe or Razorpay account.
  PAYMENTS
  /// The workspace's own WhatsApp Business Platform (Cloud API) number.
  WHATSAPP
  /// The workspace's own Twilio account and SMS number.
  TWILIO
}

/// A workspace-level connection to an outside app (one per app per workspace), made by an admin through the
/// provider's OAuth. Tokens are envelope-encrypted (AES-256-GCM). Settings hold non-secret choices such as a channel.
model AppConnection {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String           @map("tenant_id") @db.Uuid
  provider             AppProvider
  /// The provider's id for the connected account (Slack team id), used to route inbound events.
  externalAccountId    String           @map("external_account_id")
  accountName          String           @map("account_name")
  scopes               String[]
  credentialsEncrypted String           @map("credentials_encrypted")
  settings             Json             @default("{}")
  status               ConnectionStatus @default(CONNECTED)
  lastError            String?          @map("last_error")
  lastUsedAt           DateTime?        @map("last_used_at") @db.Timestamptz(3)
  connectedById        String           @map("connected_by_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events           AppEvent[]
  zoomMeetings     ZoomMeeting[]
  envelopes        SignatureEnvelope[]
  payments         QuotePayment[]
  whatsappMessages WhatsappMessage[]
  smsMessages      SmsMessage[]

  @@unique([tenantId, provider])
  @@index([provider, externalAccountId])
  @@map("app_connections")
}

/// What DealFlow sent to or received from a connected app: one row per message, meeting, envelope or payment event.
model AppEvent {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  connectionId String?     @map("connection_id") @db.Uuid
  provider     AppProvider
  /// e.g. message.sent, message.failed
  kind         String
  ok           Boolean
  /// The provider's id for the thing (message ts, meeting id, envelope id).
  externalId   String?     @map("external_id")
  summary      String
  detail       Json?
  entityType   String?     @map("entity_type")
  entityId     String?     @map("entity_id") @db.Uuid
  actorUserId  String?     @map("actor_user_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection AppConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([tenantId, provider, createdAt(sort: Desc)])
  @@map("app_events")
}

/// A Zoom meeting scheduled from DealFlow. Only these meetings' transcripts are ever imported.
model ZoomMeeting {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  connectionId       String?  @map("connection_id") @db.Uuid
  /// Zoom's numeric meeting id, as text.
  zoomMeetingId      String   @map("zoom_meeting_id")
  hostEmail          String   @map("host_email")
  topic              String
  startsAt           DateTime @map("starts_at") @db.Timestamptz(3)
  durationMinutes    Int      @map("duration_minutes")
  joinUrl            String   @map("join_url")
  /// The organiser chose cloud recording with the transcript imported afterwards.
  recordToCloud      Boolean  @default(false) @map("record_to_cloud")
  leadId             String?  @map("lead_id") @db.Uuid
  contactId          String?  @map("contact_id") @db.Uuid
  dealId             String?  @map("deal_id") @db.Uuid
  createdById        String   @map("created_by_id") @db.Uuid
  activityId         String?  @map("activity_id") @db.Uuid
  meetingRecordId    String?  @map("meeting_record_id") @db.Uuid
  /// none, waiting (recording on), ready (Zoom sent the transcript), imported, failed
  transcriptStatus   String   @default("none") @map("transcript_status")
  transcriptError    String?  @map("transcript_error")
  /// Sealed {url, token} from Zoom's recording.transcript_completed event, cleared after import.
  transcriptSource   String?  @map("transcript_source")
  transcriptAttempts Int      @default(0) @map("transcript_attempts")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection AppConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, zoomMeetingId])
  @@index([tenantId, startsAt])
  @@index([transcriptStatus])
  @@map("zoom_meetings")
}

/// A contract sent for e-signature through DocuSign. Status follows DocuSign Connect events.
model SignatureEnvelope {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  connectionId   String?   @map("connection_id") @db.Uuid
  contractId     String    @map("contract_id") @db.Uuid
  /// DocuSign's envelope id.
  envelopeId     String    @map("envelope_id")
  /// sent, delivered, completed, declined, voided
  status         String
  signerName     String    @map("signer_name")
  signerEmail    String    @map("signer_email")
  sentById       String    @map("sent_by_id") @db.Uuid
  sentAt         DateTime  @default(now()) @map("sent_at") @db.Timestamptz(3)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)
  declinedReason String?   @map("declined_reason")
  voidedReason   String?   @map("voided_reason")
  lastEventAt    DateTime? @map("last_event_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection AppConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  contract   Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([tenantId, envelopeId])
  @@index([tenantId, contractId])
  @@map("signature_envelopes")
}

/// A card payment request for an accepted quote, in the workspace's own Stripe or Razorpay account.
model QuotePayment {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  connectionId      String?   @map("connection_id") @db.Uuid
  quoteId           String    @map("quote_id") @db.Uuid
  /// stripe or razorpay
  provider          String
  /// Stripe Checkout Session id or Razorpay payment link id.
  providerRef       String?   @map("provider_ref")
  /// pending, paid, expired, failed
  status            String    @default("pending")
  amount            Decimal   @db.Decimal(18, 2)
  currency          String    @db.Char(3)
  payerEmail        String?   @map("payer_email")
  providerPaymentId String?   @map("provider_payment_id")
  paidAt            DateTime? @map("paid_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection AppConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  quote      Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([tenantId, quoteId])
  @@map("quote_payments")
}

/// WhatsApp messages to and from the workspace's own WhatsApp Business number. Outbound rows are created when
/// Meta accepts the send; status moves forward only through the signed webhook. Inbound rows come from the webhook
/// and are matched to a contact by phone number when one matches exactly.
model WhatsappMessage {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  connectionId String?   @map("connection_id") @db.Uuid
  contactId    String?   @map("contact_id") @db.Uuid
  /// in or out
  direction    String
  /// International number, digits only.
  phone        String
  /// Meta's message id (wamid.…).
  waMessageId  String    @map("wa_message_id")
  /// template, text or other
  kind         String
  body         String
  templateName String?   @map("template_name")
  /// accepted, sent, delivered, read, failed (outbound) or received (inbound)
  status       String
  error        String?
  sentById     String?   @map("sent_by_id") @db.Uuid
  /// manual, workflow or webhook
  source       String
  statusAt     DateTime? @map("status_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection AppConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  contact    Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([tenantId, waMessageId])
  @@index([tenantId, contactId, createdAt])
  @@index([tenantId, phone, createdAt])
  @@map("whatsapp_messages")
}

/// A contact's agreement to receive WhatsApp messages, recorded by a person with how they agreed. Required before
/// any business-initiated (template) message. A STOP reply or a person revoking it sets revokedAt.
model WhatsappConsent {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  contactId    String    @map("contact_id") @db.Uuid
  phone        String
  source       String
  recordedById String?   @map("recorded_by_id") @db.Uuid
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy    String?   @map("revoked_by")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, contactId, createdAt])
  @@map("whatsapp_consents")
}

/// One SMS to or from the workspace's Twilio number. Status beyond "accepted" comes only from Twilio's signed callbacks.
model SmsMessage {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  connectionId String?   @map("connection_id") @db.Uuid
  contactId    String?   @map("contact_id") @db.Uuid
  /// in or out
  direction    String
  /// The other party's number in E.164 (+447700900123).
  phone        String
  /// Twilio's message SID (SM… or MM…).
  twilioSid    String    @map("twilio_sid")
  body         String
  /// How many SMS segments Twilio bills for this message (estimated before sending, from Twilio after).
  segments     Int       @default(1)
  /// accepted, sent, delivered, undelivered, failed (outbound) or received (inbound)
  status       String
  error        String?
  sentById     String?   @map("sent_by_id") @db.Uuid
  /// manual, workflow or webhook
  source       String
  statusAt     DateTime? @map("status_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection AppConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  contact    Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([tenantId, twilioSid])
  @@index([tenantId, phone, createdAt])
  @@index([tenantId, contactId, createdAt])
  @@map("sms_messages")
}

/// A contact's recorded agreement to receive SMS from the workspace. Every outbound SMS needs an active one.
model SmsConsent {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  contactId    String    @map("contact_id") @db.Uuid
  phone        String
  source       String
  recordedById String?   @map("recorded_by_id") @db.Uuid
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy    String?   @map("revoked_by")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, contactId, createdAt])
  @@index([tenantId, phone])
  @@map("sms_consents")
}

/// A workspace API key (Zapier, Make, n8n, scripts). Only the SHA-256 hash is stored. A key acts as its creator,
/// limited to its scopes and to the creator's current role; it stops working when revoked, expired, or when the
/// creator leaves the workspace.
model ApiKey {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  prefix      String
  keyHash     String    @unique @map("key_hash")
  scopes      String[]
  createdById String    @map("created_by_id") @db.Uuid
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhooks Webhook[]

  @@index([tenantId, createdAt])
  @@map("api_keys")
}
