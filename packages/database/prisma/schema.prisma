// DealFlow database schema.
// Conventions:
//   * Every tenant-owned table has a non-null tenant_id and is protected by PostgreSQL
//     row-level security (see migrations/*/migration.sql and docs/SECURITY_MODEL.md).
//   * Global tables (users, sessions, plans) are only touched by the auth and billing services.
//   * Soft deletion uses deleted_at; hard deletion is reserved for data-deletion workflows.
//   * Money is stored as NUMERIC(18,2) alongside an ISO-4217 currency code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}

// ───────────────────────────── Platform (global) ─────────────────────────────

model Plan {
  code                    String   @id
  name                    String
  monthlyPriceCents       Int?     @map("monthly_price_cents")
  annualMonthlyPriceCents Int?     @map("annual_monthly_price_cents")
  entitlements            Json
  isPublic                Boolean  @default(true) @map("is_public")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscriptions Subscription[]

  @@map("plans")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String     @unique
  name             String
  passwordHash     String     @map("password_hash")
  status           UserStatus @default(ACTIVE)
  emailVerifiedAt  DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz(3)
  /// Consecutive failed sign-in attempts (password or second factor); reset on success.
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz(3)
  /// TOTP shared secret, sealed with SecretBox. Set during enrolment; active once mfaEnabledAt is set.
  mfaSecretEnc     String?    @map("mfa_secret_enc")
  mfaEnabledAt     DateTime?  @map("mfa_enabled_at") @db.Timestamptz(3)
  /// Last accepted TOTP time step, so a code cannot be replayed.
  mfaLastStep      BigInt?    @map("mfa_last_step")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions      Session[]
  memberships   Membership[]
  recoveryCodes MfaRecoveryCode[]

  @@map("users")
}

/// Refresh-token sessions. Tokens are stored as SHA-256 hashes and rotated on every refresh.
model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  activeTenantId   String    @map("active_tenant_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById     String?   @map("replaced_by_id") @db.Uuid
  /// "password", "mfa" (password + second factor) or "sso".
  authMethod       String    @default("password") @map("auth_method")
  /// Set for single sign-on sessions: the session can only ever act in this workspace.
  ssoTenantId      String?   @map("sso_tenant_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// One-time recovery codes for a user's second factor. Only SHA-256 hashes are stored.
model MfaRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("mfa_recovery_codes")
}

// ───────────────────────────── Tenancy ─────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
}

model Tenant {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  slug                  String       @unique
  status                TenantStatus @default(ACTIVE)
  brandColor            String?      @map("brand_color")
  defaultCurrency       String       @default("USD") @map("default_currency") @db.Char(3)
  defaultTimezone       String       @default("UTC") @map("default_timezone")
  defaultLocale         String       @default("en-US") @map("default_locale")
  /// True only for development/demo workspaces populated by the seed script.
  isDemo                Boolean      @default(false) @map("is_demo")
  /// Set when an owner hides the getting-started checklist.
  onboardingDismissedAt DateTime?    @map("onboarding_dismissed_at") @db.Timestamptz(3)
  /// Members must turn on two-step verification before they can use the workspace.
  requireMfa            Boolean      @default(false) @map("require_mfa")
  /// Mirrors sso_connections.enabled AND enforced, readable wherever the tenant row is (sign-in, switcher).
  ssoEnforced           Boolean      @default(false) @map("sso_enforced")
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?    @map("deleted_at") @db.Timestamptz(3)

  subscription           Subscription?
  roles                  Role[]
  memberships            Membership[]
  teams                  Team[]
  auditLogs              AuditLog[]
  companies              Company[]
  contacts               Contact[]
  leads                  Lead[]
  pipelines              Pipeline[]
  stages                 PipelineStage[]
  opportunities          Opportunity[]
  activities             Activity[]
  tasks                  Task[]
  customFields           CustomField[]
  invitations            Invitation[]
  domainEvents           DomainEvent[]
  workflows              Workflow[]
  workflowVersions       WorkflowVersion[]
  workflowExecutions     WorkflowExecution[]
  workflowSteps          WorkflowStep[]
  approvals              ApprovalRequest[]
  notifications          Notification[]
  webhooks               Webhook[]
  webhookDeliveries      WebhookDelivery[]
  integrationConnections IntegrationConnection[]
  emailMessages          EmailMessage[]
  meetings               Meeting[]
  aiSettings             AiSettings?
  aiRuns                 AiRun[]
  aiUsage                AiUsage[]
  aiRecommendations      AiRecommendation[]
  forecastSnapshots      ForecastSnapshot[]
  commercialSettings     CommercialSettings?
  products               Product[]
  priceBooks             PriceBook[]
  priceBookEntries       PriceBookEntry[]
  taxRates               TaxRate[]
  quotes                 Quote[]
  quoteLines             QuoteLine[]
  contracts              Contract[]
  campaigns              Campaign[]
  segments               Segment[]
  leadForms              LeadForm[]
  formSubmissions        FormSubmission[]
  exchangeRates          ExchangeRate[]
  salesTargets           SalesTarget[]
  escalations            Escalation[]
  companyHealth          CompanyHealth[]
  invoices               Invoice[]
  billingEvents          BillingEvent[]
  supportGrants          SupportGrant[]
  reports                Report[]
  dashboards             Dashboard[]
  dealStageEvents        DealStageEvent[]
  ssoConnection          SsoConnection?
  ssoIdentities          SsoIdentity[]
  scimTokens             ScimToken[]

  @@map("tenants")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  /// Payment failed and the grace period ended: paid allowances fall back to Free until paid.
  UNPAID
}

enum BillingProvider {
  NONE
  STRIPE
  RAZORPAY
}

enum BillingInterval {
  MONTH
  YEAR
}

model Subscription {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String             @unique @map("tenant_id") @db.Uuid
  planCode               String             @map("plan_code")
  status                 SubscriptionStatus @default(ACTIVE)
  billingInterval        BillingInterval    @default(MONTH) @map("billing_interval")
  seats                  Int                @default(1)
  currentPeriodStart     DateTime           @default(now()) @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd       DateTime?          @map("current_period_end") @db.Timestamptz(3)
  trialEndsAt            DateTime?          @map("trial_ends_at") @db.Timestamptz(3)
  /// A workspace gets one free trial of a paid plan.
  trialUsedAt            DateTime?          @map("trial_used_at") @db.Timestamptz(3)
  provider               BillingProvider    @default(NONE)
  /// Provider references only. Card and bank details stay with the provider and never reach DealFlow.
  providerCustomerId     String?            @map("provider_customer_id")
  providerSubscriptionId String?            @unique @map("provider_subscription_id")
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  pastDueSince           DateTime?          @map("past_due_since") @db.Timestamptz(3)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planCode], references: [code])

  @@index([provider, providerCustomerId])
  @@map("subscriptions")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String
  name        String
  description String?
  permissions String[]
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]
  invitations Invitation[]

  @@unique([tenantId, key])
  @@map("roles")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

model Membership {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  roleId     String           @map("role_id") @db.Uuid
  status     MembershipStatus @default(ACTIVE)
  /// SCIM externalId from the workspace's identity provider, when provisioned through SCIM.
  externalId String?          @map("external_id")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role         @relation(fields: [roleId], references: [id])
  teamMembers TeamMember[]

  @@unique([tenantId, userId])
  @@unique([tenantId, externalId])
  @@index([userId])
  @@map("memberships")
}

model Team {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members TeamMember[]

  @@unique([tenantId, name])
  @@map("teams")
}

model TeamMember {
  tenantId     String @map("tenant_id") @db.Uuid
  teamId       String @map("team_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid

  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([teamId, membershipId])
  @@index([tenantId])
  @@map("team_members")
}

enum ActorType {
  USER
  SYSTEM
  AI_AGENT
  PLATFORM_ADMIN
}

/// Append-only. The application role is granted INSERT and SELECT only.
model AuditLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  actorType   ActorType @default(USER) @map("actor_type")
  actorUserId String?   @map("actor_user_id") @db.Uuid
  action      String
  entityType  String?   @map("entity_type")
  entityId    String?   @map("entity_id")
  metadata    Json      @default("{}")
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  requestId   String?   @map("request_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

// ───────────────────────────── Core CRM ─────────────────────────────

model Company {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  name            String
  domain          String?
  industry        String?
  country         String?   @db.Char(2)
  ownerId         String?   @map("owner_id") @db.Uuid
  parentCompanyId String?   @map("parent_company_id") @db.Uuid
  customFields    Json      @default("{}") @map("custom_fields")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent        Company?       @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id])
  children      Company[]      @relation("CompanyHierarchy")
  contacts      Contact[]
  opportunities Opportunity[]
  activities    Activity[]
  contracts     Contract[]
  escalations   Escalation[]
  health        CompanyHealth?

  @@index([tenantId, name])
  @@index([tenantId, domain])
  @@map("companies")
}

model Contact {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  companyId        String?          @map("company_id") @db.Uuid
  firstName        String           @map("first_name")
  lastName         String?          @map("last_name")
  email            String?
  phone            String?
  jobTitle         String?          @map("job_title")
  country          String?          @db.Char(2)
  timezone         String?
  ownerId          String?          @map("owner_id") @db.Uuid
  marketingConsent MarketingConsent @default(UNKNOWN) @map("marketing_consent")
  consentSource    String?          @map("consent_source")
  consentUpdatedAt DateTime?        @map("consent_updated_at") @db.Timestamptz(3)
  customFields     Json             @default("{}") @map("custom_fields")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(3)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company       Company?      @relation(fields: [companyId], references: [id])
  opportunities Opportunity[]
  activities    Activity[]
  tasks         Task[]

  @@index([tenantId, email])
  @@index([tenantId, lastName, firstName])
  @@map("contacts")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

model Lead {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String           @map("tenant_id") @db.Uuid
  fullName               String           @map("full_name")
  companyName            String?          @map("company_name")
  jobTitle               String?          @map("job_title")
  industry               String?
  email                  String?
  phone                  String?
  country                String?          @db.Char(2)
  city                   String?
  timezone               String?
  website                String?
  source                 String?
  campaignSource         String?          @map("campaign_source")
  /// First-touch campaign, set by hosted forms or by hand.
  campaignId             String?          @map("campaign_id") @db.Uuid
  marketingConsent       MarketingConsent @default(UNKNOWN) @map("marketing_consent")
  consentSource          String?          @map("consent_source")
  consentUpdatedAt       DateTime?        @map("consent_updated_at") @db.Timestamptz(3)
  estimatedValue         Decimal?         @map("estimated_value") @db.Decimal(18, 2)
  currency               String?          @db.Char(3)
  status                 LeadStatus       @default(NEW)
  engagementScore        Int?             @map("engagement_score")
  aiScore                Int?             @map("ai_score")
  tags                   String[]
  customFields           Json             @default("{}") @map("custom_fields")
  ownerId                String?          @map("owner_id") @db.Uuid
  convertedAt            DateTime?        @map("converted_at") @db.Timestamptz(3)
  convertedContactId     String?          @map("converted_contact_id") @db.Uuid
  convertedOpportunityId String?          @map("converted_opportunity_id") @db.Uuid
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt              DateTime?        @map("deleted_at") @db.Timestamptz(3)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign   Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  activities Activity[]
  tasks      Task[]

  @@index([tenantId, status])
  @@index([tenantId, campaignId])
  @@index([tenantId, createdAt])
  @@index([tenantId, email])
  @@index([tenantId, ownerId])
  @@map("leads")
}

model Pipeline {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  isDefault Boolean   @default(false) @map("is_default")
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages        PipelineStage[]
  opportunities Opportunity[]

  @@unique([tenantId, name])
  @@map("pipelines")
}

enum StageCategory {
  OPEN
  WON
  LOST
}

model PipelineStage {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  pipelineId  String        @map("pipeline_id") @db.Uuid
  name        String
  position    Int
  /// Default win probability (0-100) used for weighted pipeline value.
  probability Int
  category    StageCategory @default(OPEN)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([pipelineId, position])
  @@index([tenantId])
  @@map("pipeline_stages")
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

model Opportunity {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  pipelineId        String            @map("pipeline_id") @db.Uuid
  stageId           String            @map("stage_id") @db.Uuid
  name              String
  amount            Decimal           @default(0) @db.Decimal(18, 2)
  currency          String            @db.Char(3)
  /// Overrides the stage probability when set.
  probability       Int?
  status            OpportunityStatus @default(OPEN)
  expectedCloseDate DateTime?         @map("expected_close_date") @db.Date
  closedAt          DateTime?         @map("closed_at") @db.Timestamptz(3)
  lossReason        String?           @map("loss_reason")
  ownerId           String?           @map("owner_id") @db.Uuid
  companyId         String?           @map("company_id") @db.Uuid
  contactId         String?           @map("contact_id") @db.Uuid
  sourceLeadId      String?           @map("source_lead_id") @db.Uuid
  customFields      Json              @default("{}") @map("custom_fields")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline    Pipeline         @relation(fields: [pipelineId], references: [id])
  stage       PipelineStage    @relation(fields: [stageId], references: [id])
  company     Company?         @relation(fields: [companyId], references: [id])
  contact     Contact?         @relation(fields: [contactId], references: [id])
  activities  Activity[]
  tasks       Task[]
  quotes      Quote[]
  contracts   Contract[]
  stageEvents DealStageEvent[]

  @@index([tenantId, status])
  @@index([tenantId, stageId])
  @@index([tenantId, closedAt])
  @@index([tenantId, ownerId])
  @@map("opportunities")
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
}

model Activity {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  type          ActivityType
  subject       String
  body          String?
  occurredAt    DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  ownerId       String?      @map("owner_id") @db.Uuid
  /// Set when an AI agent drafted or performed the activity (with human approval where required).
  aiAssisted    Boolean      @default(false) @map("ai_assisted")
  leadId        String?      @map("lead_id") @db.Uuid
  contactId     String?      @map("contact_id") @db.Uuid
  companyId     String?      @map("company_id") @db.Uuid
  opportunityId String?      @map("opportunity_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@index([tenantId, leadId])
  @@index([tenantId, contactId])
  @@index([tenantId, companyId])
  @@index([tenantId, opportunityId])
  @@map("activities")
}

enum TaskStatus {
  OPEN
  DONE
  CANCELED
}

model Task {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  title         String
  description   String?
  status        TaskStatus @default(OPEN)
  dueAt         DateTime?  @map("due_at") @db.Timestamptz(3)
  completedAt   DateTime?  @map("completed_at") @db.Timestamptz(3)
  assigneeId    String?    @map("assignee_id") @db.Uuid
  leadId        String?    @map("lead_id") @db.Uuid
  contactId     String?    @map("contact_id") @db.Uuid
  opportunityId String?    @map("opportunity_id") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, dueAt])
  @@index([tenantId, assigneeId])
  @@map("tasks")
}

// ───────────────────────────── Extensibility & onboarding ─────────────────────────────

enum CustomFieldEntity {
  LEAD
  CONTACT
  COMPANY
  OPPORTUNITY
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

/// Typed definition for values stored in a record's custom_fields JSON under `key`.
model CustomField {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  entity     CustomFieldEntity
  key        String
  label      String
  type       CustomFieldType
  options    String[]
  required   Boolean           @default(false)
  position   Int               @default(0)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt DateTime?         @map("archived_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entity, key])
  @@map("custom_fields")
}

/// Workspace invitation. Only the SHA-256 of the token is stored.
model Invitation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  email       String
  roleId      String    @map("role_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  invitedById String    @map("invited_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  @@index([tenantId, email])
  @@map("invitations")
}

// ───────────────────────────── Automation & communication (Phase 3) ─────────────────────────────

/// Transactional outbox. Written in the same transaction as the change it describes (via the audit
/// service), then processed by the worker: workflow triggers, notifications and webhooks.
model DomainEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  type        String
  entityType  String?   @map("entity_type")
  entityId    String?   @map("entity_id")
  actorUserId String?   @map("actor_user_id") @db.Uuid
  payload     Json      @default("{}")
  /// Automation depth that produced this event (0 = a person). Used for loop protection.
  depth       Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([processedAt, createdAt])
  @@index([tenantId, createdAt])
  @@map("domain_events")
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
}

model Workflow {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  name            String
  description     String?
  status          WorkflowStatus @default(DRAFT)
  triggerType     String         @map("trigger_type")
  activeVersionId String?        @map("active_version_id") @db.Uuid
  createdById     String         @map("created_by_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz(3)

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions   WorkflowVersion[]
  executions WorkflowExecution[]

  @@index([tenantId, status, triggerType])
  @@map("workflows")
}

/// Immutable. Editing a workflow creates a new version; running executions finish on theirs.
model WorkflowVersion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  workflowId  String   @map("workflow_id") @db.Uuid
  version     Int
  definition  Json
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow   Workflow            @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  executions WorkflowExecution[]

  @@unique([workflowId, version])
  @@map("workflow_versions")
}

enum ExecutionStatus {
  RUNNING
  WAITING
  AWAITING_APPROVAL
  SUCCEEDED
  FAILED
  CANCELED
}

model WorkflowExecution {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  workflowId  String          @map("workflow_id") @db.Uuid
  versionId   String          @map("version_id") @db.Uuid
  /// Idempotency: one execution per (event, version).
  eventId     String          @map("event_id") @db.Uuid
  status      ExecutionStatus @default(RUNNING)
  simulation  Boolean         @default(false)
  currentNode String?         @map("current_node")
  context     Json            @default("{}")
  depth       Int             @default(0)
  resumeAt    DateTime?       @map("resume_at") @db.Timestamptz(3)
  attempts    Int             @default(0)
  lockedUntil DateTime?       @map("locked_until") @db.Timestamptz(3)
  error       String?
  startedAt   DateTime        @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt  DateTime?       @map("finished_at") @db.Timestamptz(3)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow  Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version   WorkflowVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  steps     WorkflowStep[]
  approvals ApprovalRequest[]

  @@unique([versionId, eventId])
  @@index([status, resumeAt])
  @@index([tenantId, workflowId, startedAt(sort: Desc)])
  @@map("workflow_executions")
}

model WorkflowStep {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  executionId String    @map("execution_id") @db.Uuid
  nodeId      String    @map("node_id")
  nodeType    String    @map("node_type")
  status      String
  output      Json      @default("{}")
  error       String?
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(3)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, startedAt])
  @@map("workflow_steps")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELED
}

/// Human-in-the-loop decision for an automation (and, from Phase 4, AI) action.
model ApprovalRequest {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  executionId  String?        @map("execution_id") @db.Uuid
  nodeId       String?        @map("node_id")
  kind         String
  title        String
  summary      String?
  payload      Json           @default("{}")
  /// Permission an approver must hold.
  permission   String
  status       ApprovalStatus @default(PENDING)
  decidedById  String?        @map("decided_by_id") @db.Uuid
  decidedAt    DateTime?      @map("decided_at") @db.Timestamptz(3)
  decisionNote String?        @map("decision_note")
  expiresAt    DateTime       @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  execution WorkflowExecution? @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("approval_requests")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String?
  link      String?
  /// Source event, so a retried event never notifies twice.
  eventId   String?   @map("event_id") @db.Uuid
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId, type])
  @@index([tenantId, userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Outbound webhook subscription. The signing secret is stored encrypted.
model Webhook {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  url                 String
  events              String[]
  secretEncrypted     String    @map("secret_encrypted")
  active              Boolean   @default(true)
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  disabledReason      String?   @map("disabled_reason")
  createdById         String    @map("created_by_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([tenantId, active])
  @@map("webhooks")
}

enum DeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model WebhookDelivery {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  webhookId     String         @map("webhook_id") @db.Uuid
  eventId       String         @map("event_id") @db.Uuid
  eventType     String         @map("event_type")
  status        DeliveryStatus @default(PENDING)
  attempts      Int            @default(0)
  nextAttemptAt DateTime       @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  responseCode  Int?           @map("response_code")
  lastError     String?        @map("last_error")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  deliveredAt   DateTime?      @map("delivered_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@unique([webhookId, eventId])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

enum IntegrationProvider {
  GOOGLE
  MICROSOFT
}

enum ConnectionStatus {
  CONNECTED
  ERROR
  DISCONNECTED
}

/// A user's mailbox and calendar connection. Tokens are envelope-encrypted (AES-256-GCM).
model IntegrationConnection {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String              @map("tenant_id") @db.Uuid
  userId               String              @map("user_id") @db.Uuid
  provider             IntegrationProvider
  accountEmail         String              @map("account_email")
  scopes               String[]
  credentialsEncrypted String              @map("credentials_encrypted")
  status               ConnectionStatus    @default(CONNECTED)
  mailCursor           String?             @map("mail_cursor")
  calendarCursor       String?             @map("calendar_cursor")
  lastSyncAt           DateTime?           @map("last_sync_at") @db.Timestamptz(3)
  nextSyncAt           DateTime            @default(now()) @map("next_sync_at") @db.Timestamptz(3)
  consecutiveFailures  Int                 @default(0) @map("consecutive_failures")
  lastError            String?             @map("last_error")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  emails   EmailMessage[]
  meetings Meeting[]

  @@unique([tenantId, userId, provider])
  @@index([status, nextSyncAt])
  @@map("integration_connections")
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

model EmailMessage {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  connectionId      String         @map("connection_id") @db.Uuid
  providerMessageId String         @map("provider_message_id")
  threadId          String?        @map("thread_id")
  direction         EmailDirection
  fromAddress       String         @map("from_address")
  toAddresses       String[]       @map("to_addresses")
  ccAddresses       String[]       @map("cc_addresses")
  subject           String
  snippet           String?
  bodyText          String?        @map("body_text")
  sentAt            DateTime       @map("sent_at") @db.Timestamptz(3)
  contactId         String?        @map("contact_id") @db.Uuid
  leadId            String?        @map("lead_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, providerMessageId])
  @@index([tenantId, contactId, sentAt(sort: Desc)])
  @@index([tenantId, leadId, sentAt(sort: Desc)])
  @@map("email_messages")
}

model Meeting {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  connectionId    String   @map("connection_id") @db.Uuid
  providerEventId String   @map("provider_event_id")
  title           String
  startsAt        DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime @map("ends_at") @db.Timestamptz(3)
  location        String?
  attendees       String[]
  organizer       String?
  canceled        Boolean  @default(false)
  contactIds      String[] @map("contact_ids") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, providerEventId])
  @@index([tenantId, startsAt])
  @@map("meetings")
}

// ───────────── Phase 4: AI intelligence ─────────────

/// Tenant AI policy: the tenant-wide kill switch, per-agent switches, redaction and an optional credit cap.
model AiSettings {
  tenantId         String   @id @map("tenant_id") @db.Uuid
  enabled          Boolean  @default(true)
  disabledAgents   String[] @default([]) @map("disabled_agents")
  autoQualifyLeads Boolean  @default(false) @map("auto_qualify_leads")
  redactPii        Boolean  @default(false) @map("redact_pii")
  /// Optional tenant-set ceiling below the plan allowance.
  monthlyCreditCap Int?     @map("monthly_credit_cap")
  updatedById      String?  @map("updated_by_id") @db.Uuid
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

enum AiRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  BLOCKED
}

/// One Copilot turn or agent run, with every model call and tool call in `trace`.
model AiRun {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  /// Requesting user; null for automatic runs (they act with no user and can only propose).
  userId         String?     @map("user_id") @db.Uuid
  agent          String
  status         AiRunStatus @default(QUEUED)
  entityType     String?     @map("entity_type")
  entityId       String?     @map("entity_id") @db.Uuid
  conversationId String?     @map("conversation_id") @db.Uuid
  input          Json        @default("{}")
  output         Json?
  trace          Json        @default("[]")
  promptVersion  String      @map("prompt_version")
  model          String?
  creditsUsed    Int         @default(0) @map("credits_used")
  error          String?
  attempts       Int         @default(0)
  runAt          DateTime    @default(now()) @map("run_at") @db.Timestamptz(3)
  leaseUntil     DateTime?   @map("lease_until") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt     DateTime?   @map("finished_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, conversationId, createdAt])
  @@index([status, runAt])
  @@map("ai_runs")
}

/// Metering: one row per model call, converted to DealFlow AI credits.
model AiUsage {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  runId         String?  @map("run_id") @db.Uuid
  agent         String
  provider      String
  model         String
  inputTokens   Int      @map("input_tokens")
  outputTokens  Int      @map("output_tokens")
  credits       Int
  status        String
  latencyMs     Int      @map("latency_ms")
  promptVersion String   @map("prompt_version")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("ai_usage")
}

enum RecommendationStatus {
  PROPOSED
  ACCEPTED
  DISMISSED
}

/// A stored, explainable agent result: the signals and prompt version that produced it.
model AiRecommendation {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  runId         String?              @map("run_id") @db.Uuid
  agent         String
  kind          String
  entityType    String               @map("entity_type")
  entityId      String               @map("entity_id") @db.Uuid
  payload       Json
  promptVersion String               @map("prompt_version")
