model TaxRate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  /// Percentage, e.g. 18.000 for 18 %.
  rate      Decimal  @db.Decimal(6, 3)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("tax_rates")
}

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  ACCEPTED
  DECLINED
}

/// One version of a quote. Revising creates a new row with the same number and version + 1.
model Quote {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String      @map("tenant_id") @db.Uuid
  number                Int
  version               Int         @default(1)
  isLatest              Boolean     @default(true) @map("is_latest")
  opportunityId         String      @map("opportunity_id") @db.Uuid
  priceBookId           String      @map("price_book_id") @db.Uuid
  title                 String
  currency              String      @db.Char(3)
  status                QuoteStatus @default(DRAFT)
  validUntil            DateTime?   @map("valid_until") @db.Date
  notes                 String?
  terms                 String?
  subtotal              Decimal     @default(0) @db.Decimal(18, 2)
  discountTotal         Decimal     @default(0) @map("discount_total") @db.Decimal(18, 2)
  taxTotal              Decimal     @default(0) @map("tax_total") @db.Decimal(18, 2)
  total                 Decimal     @default(0) @db.Decimal(18, 2)
  maxDiscountPercent    Decimal     @default(0) @map("max_discount_percent") @db.Decimal(5, 2)
  approvalId            String?     @map("approval_id") @db.Uuid
  createdById           String?     @map("created_by_id") @db.Uuid
  sentAt                DateTime?   @map("sent_at") @db.Timestamptz(3)
  decidedAt             DateTime?   @map("decided_at") @db.Timestamptz(3)
  /// Proposal sections ([{heading, body}]) shown above the price table.
  sections              Json        @default("[]")
  /// Whether the online proposal link works. Turning it off revokes every link to this version.
  shareEnabled          Boolean     @default(false) @map("share_enabled")
  /// Set when the customer approved or declined in the client portal.
  decidedByPortalUserId String?     @map("decided_by_portal_user_id") @db.Uuid
  decisionNote          String?     @map("decision_note")
  firstViewedAt         DateTime?   @map("first_viewed_at") @db.Timestamptz(3)
  lastViewedAt          DateTime?   @map("last_viewed_at") @db.Timestamptz(3)
  viewCount             Int         @default(0) @map("view_count")
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunity Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  priceBook   PriceBook      @relation(fields: [priceBookId], references: [id])
  lines       QuoteLine[]
  contracts   Contract[]
  payments    QuotePayment[]

  @@unique([tenantId, number, version])
  @@index([tenantId, opportunityId])
  @@index([tenantId, status, isLatest])
  @@map("quotes")
}

model QuoteLine {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  quoteId         String  @map("quote_id") @db.Uuid
  productId       String  @map("product_id") @db.Uuid
  position        Int
  name            String
  description     String?
  quantity        Decimal @db.Decimal(12, 2)
  /// Copied from the price book when the line is saved; never typed in.
  unitPrice       Decimal @map("unit_price") @db.Decimal(18, 2)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxRateId       String? @map("tax_rate_id") @db.Uuid
  taxPercent      Decimal @default(0) @map("tax_percent") @db.Decimal(6, 3)
  netTotal        Decimal @map("net_total") @db.Decimal(18, 2)
  taxTotal        Decimal @map("tax_total") @db.Decimal(18, 2)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([quoteId, position])
  @@map("quote_lines")
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

model Contract {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  number            Int
  name              String
  companyId         String?        @map("company_id") @db.Uuid
  opportunityId     String?        @map("opportunity_id") @db.Uuid
  quoteId           String?        @map("quote_id") @db.Uuid
  ownerId           String?        @map("owner_id") @db.Uuid
  status            ContractStatus @default(DRAFT)
  value             Decimal        @default(0) @db.Decimal(18, 2)
  currency          String         @db.Char(3)
  startDate         DateTime       @map("start_date") @db.Date
  endDate           DateTime?      @map("end_date") @db.Date
  autoRenew         Boolean        @default(false) @map("auto_renew")
  renewalNoticeDays Int            @default(30) @map("renewal_notice_days")
  /// How the signature was captured. No e-signature provider is connected yet.
  signatureMethod   String?        @map("signature_method")
  signedBy          String?        @map("signed_by")
  signedAt          DateTime?      @map("signed_at") @db.Date
  terms             String?
  renewedFromId     String?        @unique @map("renewed_from_id") @db.Uuid
  reminderSentAt    DateTime?      @map("reminder_sent_at") @db.Timestamptz(3)
  terminatedAt      DateTime?      @map("terminated_at") @db.Timestamptz(3)
  terminationReason String?        @map("termination_reason")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company?            @relation(fields: [companyId], references: [id])
  opportunity Opportunity?        @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  quote       Quote?              @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  renewedFrom Contract?           @relation("ContractRenewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewal     Contract?           @relation("ContractRenewal")
  escalations Escalation[]
  envelopes   SignatureEnvelope[]

  @@unique([tenantId, number])
  @@index([tenantId, status, endDate])
  @@index([tenantId, companyId])
  @@map("contracts")
}

