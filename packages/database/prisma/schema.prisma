  tenantId   String    @map("tenant_id") @db.Uuid
  score      Int
  band       String
  signals    Json
  computedAt DateTime  @map("computed_at") @db.Timestamptz(3)
  alertedAt  DateTime? @map("alerted_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([tenantId, band])
  @@map("company_health")
}

/// One score per customer per day, for churn-risk trends (enhancement feature 13).
model CompanyHealthDaily {
  companyId String   @map("company_id") @db.Uuid
  day       DateTime @db.Date
  tenantId  String   @map("tenant_id") @db.Uuid
  score     Int
  band      String

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, day])
  @@index([tenantId, day])
  @@map("company_health_daily")
}

// ───────────── Phase 6: billing, operators, support access ─────────────

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

/// Invoices as reported by the billing provider. Amounts in the smallest currency unit.
model Invoice {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  provider          BillingProvider
  providerInvoiceId String           @map("provider_invoice_id")
  number            String?
  status            InvoiceStatus
  currency          String           @db.Char(3)
  subtotalCents     Int              @map("subtotal_cents")
  taxCents          Int              @default(0) @map("tax_cents")
  totalCents        Int              @map("total_cents")
  amountPaidCents   Int              @default(0) @map("amount_paid_cents")
  periodStart       DateTime?        @map("period_start") @db.Timestamptz(3)
  periodEnd         DateTime?        @map("period_end") @db.Timestamptz(3)
  hostedUrl         String?          @map("hosted_url")
  pdfUrl            String?          @map("pdf_url")
  issuedAt          DateTime         @map("issued_at") @db.Timestamptz(3)
  paidAt            DateTime?        @map("paid_at") @db.Timestamptz(3)
  /// Offline invoices only: what the workspace asked for, applied when an operator records the payment.
  planCode          String?          @map("plan_code")
  billingInterval   BillingInterval? @map("billing_interval")
  seats             Int?
  requestedById     String?          @map("requested_by_id") @db.Uuid
  /// The bank or transfer reference an operator entered when recording the payment.
  paymentReference  String?          @map("payment_reference")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([provider, providerInvoiceId])
  @@index([tenantId, issuedAt])
  @@map("invoices")
}

/// Provider webhook events already applied (idempotency). Stores the event type, not the payload.
model BillingEvent {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  provider        BillingProvider
  providerEventId String          @map("provider_event_id")
  type            String
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@map("billing_events")
}

/// A workspace owner's time-boxed permission for platform support to look inside the workspace.
model SupportGrant {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  grantedById String    @map("granted_by_id") @db.Uuid
  reason      String
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, expiresAt])
  @@map("support_grants")
}

enum OperatorRole {
  ADMIN
  SUPPORT
}

enum OperatorStatus {
  ACTIVE
  DISABLED
}

/// Platform staff. A separate realm from workspace users: own table, own sign-in, own token secret.
model PlatformOperator {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String         @unique
  name         String
  passwordHash String         @map("password_hash")
  role         OperatorRole   @default(SUPPORT)
  status       OperatorStatus @default(ACTIVE)
  lastLoginAt  DateTime?      @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  auditLogs PlatformAuditLog[]

  @@map("platform_operators")
}

/// Append-only log of everything operators do. The application role may insert and read, never change.
model PlatformAuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operatorId     String?  @map("operator_id") @db.Uuid
  action         String
  targetTenantId String?  @map("target_tenant_id") @db.Uuid
  metadata       Json     @default("{}")
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  operator PlatformOperator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([targetTenantId, createdAt])
  @@index([createdAt])
  @@map("platform_audit_logs")
}

/// Deployment-wide settings that platform admins edit in the operator console (not per workspace).
model PlatformSetting {
  key         String   @id
  value       String
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_settings")
}

// ───────────────────────────── Reports and immersive views (Phase 7) ─────────────────────────────

enum ReportVisibility {
  PRIVATE
  WORKSPACE
}

/// A saved report definition (see reportDefinitionSchema). Only catalogue field keys are stored, never SQL.
model Report {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  name        String
  description String?
  visibility  ReportVisibility @default(PRIVATE)
  definition  Json
  createdById String?          @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdById])
  @@map("reports")
}

/// An ordered grid of report widgets: [{ reportId, size }]. Widgets whose report is gone or hidden are skipped.
model Dashboard {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  name        String
  description String?
  visibility  ReportVisibility @default(PRIVATE)
  widgets     Json             @default("[]")
  createdById String?          @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdById])
  @@map("dashboards")
}

/// Every stage a deal enters, with when. Written on create and on each move; the source of flow and replay views.
/// `reconstructed` rows were back-filled from the audit log when the table was introduced.
model DealStageEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  opportunityId String   @map("opportunity_id") @db.Uuid
  pipelineId    String   @map("pipeline_id") @db.Uuid
  fromStageId   String?  @map("from_stage_id") @db.Uuid
  toStageId     String   @map("to_stage_id") @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  reconstructed Boolean  @default(false)
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([tenantId, pipelineId, occurredAt])
  @@index([opportunityId, occurredAt])
  @@map("deal_stage_events")
}

// ───────────────────────────── Enterprise identity (Phase 8) ─────────────────────────────

/// A workspace's OpenID Connect identity provider. One per workspace.
model SsoConnection {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @unique @map("tenant_id") @db.Uuid
  /// Globally unique name people type on the sign-in page ("Sign in with SSO").
  loginSlug       String    @unique @map("login_slug")
  issuer          String
  clientId        String    @map("client_id")
  clientSecretEnc String    @map("client_secret_enc")
  /// Lower-case email domains the provider may sign in. Empty = any domain the provider asserts.
  allowedDomains  String[]  @default([]) @map("allowed_domains")
  /// Create a membership on first sign-in for people the workspace has not invited.
  jitProvisioning Boolean   @default(false) @map("jit_provisioning")
  defaultRoleId   String?   @map("default_role_id") @db.Uuid
  enabled         Boolean   @default(false)
  /// Password sign-in no longer opens this workspace (owners keep it as a break-glass route).
  enforced        Boolean   @default(false)
  /// Last successful test or sign-in, for the settings page.
  lastVerifiedAt  DateTime? @map("last_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  identities SsoIdentity[]

  @@map("sso_connections")
}

/// Links an identity-provider subject to a DealFlow user, per workspace.
model SsoIdentity {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  connectionId String   @map("connection_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  subject      String
  lastLoginAt  DateTime @default(now()) @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection SsoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, subject])
  @@index([tenantId, userId])
  @@map("sso_identities")
}

/// Bearer tokens for SCIM 2.0 provisioning. Only SHA-256 hashes are stored.
model ScimToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  tokenHash   String    @unique @map("token_hash")
  /// First characters of the token, shown so admins can tell tokens apart.
  prefix      String
  createdById String?   @map("created_by_id") @db.Uuid
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("scim_tokens")
}

// ───────────── Email templates and sequences (Phase 9) ─────────────

enum SequenceStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  REPLIED
  BOUNCED
  UNSUBSCRIBED
  STOPPED
  MOVED
  FAILED
}

enum EmailEventType {
  REPLIED
  OPENED
  CLICKED
  BOUNCED
  UNSUBSCRIBED
}

enum SuppressionReason {
  UNSUBSCRIBED
  BOUNCED
  MANUAL
}

/// Reusable email text with merge fields. Personal unless shared.
model EmailTemplate {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String
  subject    String
  body       String
  shared     Boolean  @default(false)
  category   String?
  campaignId String?  @map("campaign_id") @db.Uuid
  ownerId    String?  @map("owner_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([tenantId, ownerId])
  @@index([tenantId, category])
  @@map("email_templates")
}

/// Workspace email variables: {{var.key}} in templates and sequences.
model EmailVariable {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String
  label       String
  value       String   @default("")
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("email_variables")
}

/// A person-built series of emails, tasks and checks, sent one-to-one from each sender's own mailbox.
model Sequence {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  name        String
  description String?
  status      SequenceStatus @default(DRAFT)
  ownerId     String?        @map("owner_id") @db.Uuid
  steps       Json           @default("[]")
  rules       Json           @default("[]")
  settings    Json           @default("{}")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments      SequenceEnrollment[]
  prospectOutreach ProspectOutreach[]

  @@index([tenantId, status])
  @@map("sequences")
}

/// One person's run through a sequence. The worker claims due rows by next_run_at.
model SequenceEnrollment {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  sequenceId   String           @map("sequence_id") @db.Uuid
  leadId       String?          @map("lead_id") @db.Uuid
  contactId    String?          @map("contact_id") @db.Uuid
  email        String
  senderId     String           @map("sender_id") @db.Uuid
  enrolledById String?          @map("enrolled_by_id") @db.Uuid
  status       EnrollmentStatus @default(ACTIVE)
  stepIndex    Int              @default(0) @map("step_index")
  nextRunAt    DateTime?        @map("next_run_at") @db.Timestamptz(3)
  attempts     Int              @default(0)
  lastError    String?          @map("last_error")
  repliedAt    DateTime?        @map("replied_at") @db.Timestamptz(3)
  openedAt     DateTime?        @map("opened_at") @db.Timestamptz(3)
  clickedAt    DateTime?        @map("clicked_at") @db.Timestamptz(3)
  finishedAt   DateTime?        @map("finished_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sequence Sequence          @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  messages SequenceMessage[]

  @@index([status, nextRunAt])
  @@index([tenantId, sequenceId, status])
  @@index([tenantId, email])
  @@index([tenantId, leadId])
  @@index([tenantId, contactId])
  @@map("sequence_enrollments")
}

/// An email a sequence sent, with what DealFlow saw happen to it.
model SequenceMessage {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  enrollmentId   String    @map("enrollment_id") @db.Uuid
  stepId         String    @map("step_id")
  /// "A" or "B" for A/B-tested steps; "A" otherwise.
  variant        String    @default("A")
  senderId       String    @map("sender_id") @db.Uuid
  emailMessageId String?   @map("email_message_id") @db.Uuid
  toAddress      String    @map("to_address")
  subject        String
  sentAt         DateTime  @default(now()) @map("sent_at") @db.Timestamptz(3)
  openedAt       DateTime? @map("opened_at") @db.Timestamptz(3)
  openCount      Int       @default(0) @map("open_count")
  clickedAt      DateTime? @map("clicked_at") @db.Timestamptz(3)
  clickCount     Int       @default(0) @map("click_count")
  repliedAt      DateTime? @map("replied_at") @db.Timestamptz(3)
  bouncedAt      DateTime? @map("bounced_at") @db.Timestamptz(3)

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollment SequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  events     EmailEvent[]

  @@index([tenantId, senderId, sentAt])
  @@index([tenantId, toAddress, sentAt])
  @@index([enrollmentId])
  @@map("sequence_messages")
}

/// Opens, clicks, replies, bounces and unsubscribes, as DealFlow observed them. No IP addresses are stored.
model EmailEvent {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  messageId String         @map("message_id") @db.Uuid
  type      EmailEventType
  url       String?
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  message SequenceMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([tenantId, messageId])
  @@map("email_events")
}

/// The workspace's do-not-email list. Sequences never send to these addresses.
model EmailSuppression {
  tenantId    String            @map("tenant_id") @db.Uuid
  email       String
  reason      SuppressionReason
  createdById String?           @map("created_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, email])
  @@map("email_suppressions")
}

/// Email finder lookups (Phase 9): history for the person and the daily limit.
model FinderLookup {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  companyName String   @map("company_name")
  domain      String?
  person      String?
  found       Int      @default(0)
  result      Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, createdAt])
  @@map("finder_lookups")
}

// ───────────── Enhancement Phase 1: sales intelligence ─────────────

/**
 * Latest rule-based health of an open deal, kept by the worker's hourly sweep.
 */
model DealHealthScore {
  dealId     String    @id @map("deal_id") @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  health     Int
  risk       String
  signals    Json
  computedAt DateTime  @map("computed_at") @db.Timestamptz(3)
  /**
   * Set when the owner was told the deal turned high risk; cleared when it recovers.
   */
  alertedAt  DateTime? @map("alerted_at") @db.Timestamptz(3)

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal   Opportunity @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([tenantId, risk])
  @@map("deal_health_scores")
}

/**
 * One score per deal per day (the last of the day wins), for trends.
 */
model DealHealthDaily {
  dealId   String   @map("deal_id") @db.Uuid
  day      DateTime @db.Date
  tenantId String   @map("tenant_id") @db.Uuid
  health   Int
  risk     String

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal   Opportunity @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@id([dealId, day])
  @@index([tenantId, day])
  @@map("deal_health_daily")
}

/**
 * What a person did with one item of their next best action list; accepted items keep the task they created.
 */
model NextActionDecision {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  key        String
  kind       String
  recordType String    @map("record_type")
  recordId   String    @map("record_id") @db.Uuid
  /**
   * accepted, dismissed or snoozed.
   */
  decision   String
  /**
   * Snoozed until; null with "dismissed" hides it until the situation behind the key changes.
   */
  until      DateTime? @db.Timestamptz(3)
  taskId     String?   @map("task_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, key])
  @@index([tenantId, userId, createdAt])
  @@map("next_action_decisions")
}

/// Inbox conversation (feature 8): stored messages grouped by provider thread. Rows are created by a trigger on email_messages.
model EmailThread {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  connectionId  String   @map("connection_id") @db.Uuid
  threadKey     String   @map("thread_key")
  subject       String
  /// OPEN, WAITING or CLOSED
  status        String   @default("OPEN")
  category      String?
  assignedToId  String?  @map("assigned_to_id") @db.Uuid
  contactId     String?  @map("contact_id") @db.Uuid
  leadId        String?  @map("lead_id") @db.Uuid
  dealId        String?  @map("deal_id") @db.Uuid
  messageCount  Int      @default(0) @map("message_count")
  lastMessageAt DateTime @map("last_message_at") @db.Timestamptz(3)
  lastDirection String   @map("last_direction")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  deal       Opportunity?          @relation(fields: [dealId], references: [id], onDelete: SetNull)
  messages   EmailMessage[]
  notes      EmailThreadNote[]

  @@unique([connectionId, threadKey])
  @@index([tenantId, lastMessageAt(sort: Desc)])
  @@index([tenantId, assignedToId])
  @@index([tenantId, dealId])
  @@map("email_threads")
}

model EmailThreadNote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  threadId  String   @map("thread_id") @db.Uuid
  authorId  String?  @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  thread EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("email_thread_notes")
}

/// One row per mailbox sync attempt, kept for the connection log.
model IntegrationSyncLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  connectionId String   @map("connection_id") @db.Uuid
  /// manual or scheduled
