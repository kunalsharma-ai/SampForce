# SampForce application settings for the API and the worker (docker-compose.prod.yml passes this file to both).
# scripts/generate-secrets.sh copies it to sampforce.env. Every line is optional: a commented line uses the default
# shown. Uncomment a line to change it, then run:  docker compose -f docker-compose.prod.yml up -d
#
# Do not leave a value empty (KEY=): comment the line out instead. Some settings reject an empty value.
#
# Set in docker-compose.prod.yml from .env, so not here: NODE_ENV, DATABASE_URL, JWT_ACCESS_SECRET, ENCRYPTION_KEY,
# OPERATOR_JWT_SECRET, COOKIE_SECURE, PUBLIC_WEB_URL, WEB_ORIGINS, METRICS_PORT.

# ───── Plans and payments ─────
# These can also be changed in the operator console under Providers > Plans and online checkout (ADR 0053),
# and a value saved there wins over this file.
# The rate card was approved on 2026-10-31, so production shows final prices.
PRICING_PUBLISHED=true
# Offline payments only: workspaces request an invoice and an operator marks it paid (ADR 0013).
ONLINE_PAYMENTS_ENABLED=false
# Bank details are entered in the operator console under Settings. This is only a fallback (use \n for new lines).
# OFFLINE_PAYMENT_INSTRUCTIONS=
# Shown for Enterprise Plus and custom quotes.
# SALES_CONTACT_EMAIL=sales@example.com
# TRIAL_DAYS=14
# BILLING_GRACE_DAYS=14

# ───── Account email (password reset links) ─────
# Can also be entered in the operator console under Providers > SMTP. MAIL_FROM is required with SMTP_URL.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=SampForce <no-reply@example.com>
# PASSWORD_RESET_TTL_MINUTES=30

# ───── Sessions and limits ─────
# LOG_LEVEL=info
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# AUTH_RATE_LIMIT_PER_MINUTE=10
# API_RATE_LIMIT_PER_MINUTE=300
# WORKER_POLL_MS=2000
# WEBHOOK_MAX_ATTEMPTS=6
# WEBHOOK_DISABLE_AFTER_FAILURES=15
# EMAIL_DAILY_SEND_LIMIT=200
# FINDER_DAILY_LIMIT=50
# PROSPECT_DAILY_LIMIT=100
# VISITOR_ENQUIRIES_PER_DAY=500
# MEETING_UPLOAD_MAX_MB=100
# AI_USER_CALLS_PER_MINUTE=30
# AI_REQUEST_TIMEOUT_MS=90000
# AI_MODEL=claude-opus-5-5
# AI_SERVER_FALLBACKS=true
# Seconds between reloads of the provider keys saved in the operator console.
# PROVIDER_KEYS_REFRESH_SECONDS=10

# ───── Sequence tracking links ─────
# Default: PUBLIC_WEB_URL and a key derived from JWT_ACCESS_SECRET. A separate subdomain needs its own Caddy site.
# TRACKING_BASE_URL=https://track.example.com
# TRACKING_SECRET=<at least 32 random characters>

# ───── Provider keys ─────
# Normally entered in the operator console under Providers (sealed with ENCRYPTION_KEY, applied without a restart,
# ADR 0051), so leave these commented. A value saved in the console wins over a value here. Each provider there has
# a setup guide with the redirect and webhook URLs to paste into the provider's own console (ADR 0053).
# ANTHROPIC_API_KEY=
# APOLLO_API_KEY=
# HUNTER_API_KEY=
# DEEPGRAM_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_WEBHOOK_SECRET_TOKEN=
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_SECRET_KEY=
# DOCUSIGN_CONNECT_HMAC_KEY=
# DocuSign developer (demo) accounts use https://account-d.docusign.com.
# DOCUSIGN_AUTH_BASE_URL=https://account.docusign.com
# ZAPIER_INVITE_URL=
# Online checkout only (ONLINE_PAYMENTS_ENABLED=true). Each secret key needs its webhook secret.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICES=launch:MONTH=price_123,launch:YEAR=price_456
# STRIPE_AUTOMATIC_TAX=false
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLANS=

# ───── Key rotation only ─────
# The ENCRYPTION_KEY being retired, while docs/runbooks/key-rotation.md is in progress. Remove it afterwards.
# ENCRYPTION_KEY_PREVIOUS=

# ───── Observability ─────
# Prometheus metrics are served on port 9464 inside the containers (not published). Tracing is off unless set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=sampforce-api

# Not listed on purpose: *_API_BASE_URL / *_AUTH_BASE_URL overrides (they point tests at local fixtures),
# FINDER_FIXTURE_URL and ALLOW_PRIVATE_NETWORK_TARGETS (refused in production), RUN_WORKER_IN_PROCESS (the
# worker runs as its own container), DEMO_USER_PASSWORD (the demo seed refuses to run in production), REDIS_URL
# (not used by the current code).
