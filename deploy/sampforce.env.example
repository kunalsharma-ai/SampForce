# SampForce optional limits and tuning for the API and the worker (docker-compose.prod.yml passes this file to both).
# scripts/generate-secrets.sh copies it to sampforce.env. Every line is optional: a commented line uses the default
# shown. Uncomment a line to change it, then run:  docker compose -f docker-compose.prod.yml up -d
#
# Do not leave a value empty (KEY=): comment the line out instead. Some settings reject an empty value.
#
# NO API KEYS GO IN THIS FILE (ADR 0059). Every provider key and integration setting (Anthropic, SMTP email, Stripe,
# Razorpay, Google, Microsoft, Slack, Zoom, DocuSign, Apollo, Hunter, Deepgram, Zapier) and the plan and checkout
# settings (final prices shown, online payments, Stripe prices, Razorpay plans, sales contact, AI model) are entered
# in the operator console under Providers and stored in the database, encrypted. A production server ignores them
# here: a value left over from an older install is copied into the database once at start-up, then ignored.
#
# Set in docker-compose.prod.yml from .env, so not here: NODE_ENV, DATABASE_URL, COOKIE_SECURE, PUBLIC_WEB_URL,
# WEB_ORIGINS, METRICS_PORT. ENCRYPTION_KEY and the session signing secrets are created in the database.

# ───── Billing ─────
# Bank details for offline invoices are entered in the operator console under Settings.
# TRIAL_DAYS=14
# BILLING_GRACE_DAYS=14

# ───── Account email ─────
# PASSWORD_RESET_TTL_MINUTES=30

# ───── Sessions and limits ─────
# LOG_LEVEL=info
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# AUTH_RATE_LIMIT_PER_MINUTE=10
# API_RATE_LIMIT_PER_MINUTE=300
# WORKER_POLL_MS=2000
# CONSOLE_NOTIFY_INTERVAL_MS=60000
# CONSOLE_OVERVIEW_CACHE_MS=60000
# WEBHOOK_MAX_ATTEMPTS=6
# WEBHOOK_DISABLE_AFTER_FAILURES=15
# EMAIL_DAILY_SEND_LIMIT=200
# FINDER_DAILY_LIMIT=50
# PROSPECT_DAILY_LIMIT=100
# VISITOR_ENQUIRIES_PER_DAY=500
# MEETING_UPLOAD_MAX_MB=100
# AI_USER_CALLS_PER_MINUTE=30
# AI_REQUEST_TIMEOUT_MS=90000
# AI_SERVER_FALLBACKS=true
# Seconds between reloads of the provider keys saved in the operator console.
# PROVIDER_KEYS_REFRESH_SECONDS=10

# ───── Sequence tracking links ─────
# Default: PUBLIC_WEB_URL, signed with a key derived from the session signing secret. A separate subdomain needs its
# own Caddy site.
# TRACKING_BASE_URL=https://track.example.com

# ───── Key rotation ─────
# ENCRYPTION_KEY is kept in the database: rotate it with scripts/rotate-encryption-key.sh, not here.

# ───── Observability ─────
# Prometheus metrics are served on port 9464 inside the containers (not published). Tracing is off unless set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=sampforce-api

# Not listed on purpose: *_API_BASE_URL / *_AUTH_BASE_URL overrides (they point tests at local fixtures),
# FINDER_FIXTURE_URL and ALLOW_PRIVATE_NETWORK_TARGETS (refused in production), RUN_WORKER_IN_PROCESS (the
# worker runs as its own container), DEMO_USER_PASSWORD (the demo seed refuses to run in production), REDIS_URL
# (not used by the current code), OFFLINE_PAYMENT_INSTRUCTIONS and TRACKING_SECRET (the console and the derived key
# cover them).
