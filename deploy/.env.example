# SampForce server settings, read by docker compose for docker-compose.prod.yml.
# Create the real file with:  scripts/generate-secrets.sh   (copies this file to .env and fills every blank secret)
# Keep .env readable by root only (chmod 600). Never commit it.

# ───── Required: where people reach SampForce ─────
# The DNS name pointing at this server, without https://. Caddy requests its TLS certificate for this name.
DOMAIN=crm.example.com
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=admin@example.com

# ───── Required secrets (generate-secrets.sh fills these with random values) ─────
# MongoDB root user. Used only for restores and maintenance, never by the app.
MONGO_ROOT_PASSWORD=
# readWrite and dbAdmin: the set-up job that creates the indexes.
SAMPFORCE_ADMIN_PASSWORD=
# readWrite only: the API and the worker. Workspace isolation is enforced by SampForce's database client (ADR 0058).
SAMPFORCE_APP_PASSWORD=
# The built-in backup role: used only by mongodump.
SAMPFORCE_BACKUP_PASSWORD=
# Signs user sessions. At least 32 characters.
JWT_ACCESS_SECRET=
# Seals MFA secrets, SSO client secrets, webhook secrets, mailbox tokens and the provider keys you enter in the
# operator console. 32 bytes, hex or base64. LOSING IT MAKES THOSE UNREADABLE: keep a copy outside this server.
# To rotate it, see docs/runbooks/key-rotation.md.
ENCRYPTION_KEY=
# Signs operator-console sessions. Must differ from JWT_ACCESS_SECRET.
OPERATOR_JWT_SECRET=

# ───── Optional ─────
# Extra origins allowed to call the API with cookies, comma-separated. Default: https://DOMAIN only.
# WEB_ORIGINS=https://crm.example.com
# Database connections per API or worker process (the MongoDB driver's maxPoolSize).
# DB_CONNECTION_LIMIT=10
# The database SampForce uses. scripts/restore.sh --switch changes it to the restored copy; leave it otherwise.
SAMPFORCE_DB=sampforce
# Where scripts/backup.sh writes backups (relative to deploy/), and how many days of them it keeps.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# Use prebuilt images from a registry instead of building on this server, e.g. ghcr.io/you/sampforce-api:<git-sha>.
# SAMPFORCE_API_IMAGE=
# SAMPFORCE_WEB_IMAGE=
# SAMPFORCE_MIGRATE_IMAGE=
