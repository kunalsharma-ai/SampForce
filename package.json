{
  "name": "dealflow",
  "private": true,
  "description": "DealFlow by Sampledge: AI-native revenue platform",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @dealflow/api --filter @dealflow/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @dealflow/web test:e2e",
    "db:setup": "bash scripts/db-setup.sh",
    "db:migrate": "pnpm --filter @dealflow/database migrate:deploy",
    "db:seed": "pnpm --filter @dealflow/api seed:demo",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "15.5.28",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "3.2.7"
  }
}