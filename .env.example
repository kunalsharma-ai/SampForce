# DealFlow environment template. Copy to .env and adjust. Never commit real secrets.

NODE_ENV=development

# Runtime connection: dealflow_app has NO BYPASSRLS, so row-level security always applies.
DATABASE_URL=postgresql://dealflow_app:dealflow_app_dev@localhost:5432/dealflow
# Migration connection: schema owner.
MIGRATION_DATABASE_URL=postgresql://dealflow_owner:dealflow_owner_dev@localhost:5432/dealflow
REDIS_URL=redis://localhost:6379

API_PORT=4000
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
WEB_ORIGINS=http://localhost:3000
LOG_LEVEL=info
AUTH_RATE_LIMIT_PER_MINUTE=10

# Web app: where the Next.js server proxies /api/* requests.
API_INTERNAL_URL=http://localhost:4000

# Demo seed (development only). The seed refuses to run when NODE_ENV=production.
DEMO_USER_PASSWORD=DealFlowDemo2026
