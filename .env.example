# DealFlow environment template. Copy to .env and adjust. Never commit real secrets.

NODE_ENV=development

# Runtime connection: dealflow_app has NO BYPASSRLS, so row-level security always applies.
DATABASE_URL=postgresql://dealflow_app:dealflow_app_dev@localhost:5432/dealflow
# Migration connection: schema owner.
MIGRATION_DATABASE_URL=postgresql://dealflow_owner:dealflow_owner_dev@localhost:5432/dealflow
REDIS_URL=redis://localhost:6379

API_PORT=4000
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
WEB_ORIGINS=http://localhost:3000
LOG_LEVEL=info
AUTH_RATE_LIMIT_PER_MINUTE=10
# Requests per minute per client IP for all other API routes.
API_RATE_LIMIT_PER_MINUTE=300

# Encrypts webhook secrets, mailbox tokens, TOTP secrets and SSO client secrets. Required in production.
# Generate with: openssl rand -base64 32. To rotate, see docs/runbooks/key-rotation.md.
ENCRYPTION_KEY=
# Only during a key rotation: the key being retired.
ENCRYPTION_KEY_PREVIOUS=
# Public URL of the web app (OAuth redirect URIs and links).
PUBLIC_WEB_URL=http://localhost:3000

# Background worker. In development the API can run it in-process; production runs `node dist/worker.js`.
RUN_WORKER_IN_PROCESS=true
WORKER_POLL_MS=2000
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_DISABLE_AFTER_FAILURES=15
# Sequence tracking and unsubscribe links (defaults: PUBLIC_WEB_URL and a key derived from JWT_ACCESS_SECRET)
TRACKING_BASE_URL=
TRACKING_SECRET=
# Email finder (Phase 9). Website lookups per person per day, and an optional Hunter.io key.
FINDER_DAILY_LIMIT=50
HUNTER_API_KEY=
# Meeting recordings (enhancement feature 7). Deepgram speech-to-text with your own key; audio is not stored.
DEEPGRAM_API_KEY=
MEETING_UPLOAD_MAX_MB=100
EMAIL_DAILY_SEND_LIMIT=200
# Account email (password reset links). smtp:// or smtps:// with credentials, e.g.
# smtps://user:pass@smtp.example.com:465. Without it, "Forgot your password?" says email is not set up.
SMTP_URL=
MAIL_FROM=
PASSWORD_RESET_TTL_MINUTES=30

# Mailbox and calendar providers (optional). Leave empty until you have registered OAuth apps;
# see docs/INTEGRATIONS.md. Without them the app shows these integrations as not set up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# AI (optional). Without a key every agent reports "not configured"; rule-based scores and forecasts still work.
# Calls are metered against each workspace's AI credits. See docs/adr/0008-ai-gateway.md.
ANTHROPIC_API_KEY=
AI_API_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-opus-5-5
AI_REQUEST_TIMEOUT_MS=90000
AI_SERVER_FALLBACKS=true
AI_USER_CALLS_PER_MINUTE=30

# Billing (optional). With no keys, the Billing page shows plans but says checkout is not configured.
# Prices live in the provider dashboard; map them here. Never put card details anywhere in DealFlow.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false
# e.g. launch:MONTH=price_123,launch:YEAR=price_456,growth:MONTH=price_789
STRIPE_PRICES=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLANS=
BILLING_GRACE_DAYS=14
TRIAL_DAYS=14
PRICING_PUBLISHED=false
# Stripe/Razorpay checkout for new subscriptions. Off: workspaces pay offline against an invoice an operator marks paid.
ONLINE_PAYMENTS_ENABLED=false
# Fallback for the bank details on open offline invoices (use \n for line breaks). Normally entered in the operator console under Settings instead.
OFFLINE_PAYMENT_INSTRUCTIONS=
SALES_CONTACT_EMAIL=

# Operator console (platform staff). Unset disables it. Create operators with `pnpm --filter @dealflow/api operator:create`.
OPERATOR_JWT_SECRET=

# Observability (optional). METRICS_PORT serves Prometheus /metrics (and /healthz for the worker) on a
# separate port that should not be exposed publicly. Tracing is off unless an OTLP/HTTP endpoint is set.
METRICS_PORT=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=dealflow-api

# Backups (scripts/backup.sh): the read-only dealflow_backup role, which has BYPASSRLS.
BACKUP_DATABASE_URL=postgresql://dealflow_backup:dealflow_backup_dev@localhost:5432/dealflow

# Web app: where the Next.js server proxies /api/* requests.
API_INTERNAL_URL=http://localhost:4000

# Demo seed (development only). The seed refuses to run when NODE_ENV=production.
DEMO_USER_PASSWORD=DealFlowDemo2026
