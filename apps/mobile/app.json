{
  "expo": {
    "name": "SampForce",
    "slug": "sampforce",
    "scheme": "sampforce",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.sampledge.sampforce",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sampledge.sampforce",
      "allowBackup": false
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "SampForce uses your photos so you can choose a profile picture.",
          "cameraPermission": "SampForce uses the camera so you can take a profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://app.sampforce.com"
    }
  }
}
