{
  "expo": {
    "name": "SampForce",
    "slug": "sampforce",
    "scheme": "sampforce",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.sampledge.sampforce",
      "supportsTablet": true,
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.sampledge.sampforce",
      "allowBackup": false
    },
    "web": { "output": "single", "bundler": "metro" },
    "plugins": ["expo-router", "expo-secure-store", "expo-localization"],
    "experiments": { "typedRoutes": false },
    "extra": {
      "apiUrl": "https://app.sampforce.com"
    }
  }
}
