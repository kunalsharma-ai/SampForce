{
  "name": "@dealflow/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "SampForce for iOS and Android (Expo). Same backend, sign-in and permissions as the web app (ADR 0072).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "build": "expo export --platform web --output-dir dist-web",
    "serve:web": "node scripts/serve-web.mjs",
    "lint": "eslint src app test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dealflow/types": "workspace:*",
    "@expo/metro-runtime": "58.0.17",
    "@expo/vector-icons": "15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "58.0.26",
    "expo-application": "58.1.2",
    "expo-constants": "58.0.16",
    "expo-crypto": "58.0.8",
    "expo-device": "58.0.5",
    "expo-font": "58.0.12",
    "expo-image-manipulator": "58.0.16",
    "expo-image-picker": "58.0.10",
    "expo-linking": "58.0.17",
    "expo-localization": "58.0.5",
    "expo-notifications": "58.1.9",
    "expo-router": "58.0.32",
    "expo-secure-store": "58.0.3",
    "expo-splash-screen": "58.0.14",
    "expo-status-bar": "58.0.5",
    "expo-system-ui": "58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "vitest": "3.2.7"
  }
}
