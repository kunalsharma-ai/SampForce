{
  "name": "@dealflow/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env -r @swc-node/register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test scripts evals",
    "test": "vitest run",
    "operator:create": "node --env-file-if-exists=../../.env -r @swc-node/register scripts/create-operator.ts",
    "seed:demo": "node --env-file-if-exists=../../.env -r @swc-node/register scripts/seed-demo.ts",
    "seed:load": "node --env-file-if-exists=../../.env -r @swc-node/register scripts/seed-load.ts",
    "secrets:reseal": "node --env-file-if-exists=../../.env -r @swc-node/register scripts/reseal-secrets.ts",
    "openapi": "node -r @swc-node/register scripts/export-openapi.ts",
    "eval": "tsx evals/run-evals.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@dealflow/config": "workspace:*",
    "@dealflow/database": "workspace:*",
    "@dealflow/types": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/instrumentation-express": "0.72.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/instrumentation-pino": "0.70.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/semantic-conventions": "1.44.0",
    "@prisma/instrumentation": "6.19.3",
    "cookie-parser": "1.4.7",
    "exceljs": "4.4.0",
    "helmet": "8.3.0",
    "jose": "5.10.0",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.1.0",
    "pdfkit": "0.15.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.20",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.13.9",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "unplugin-swc": "2.0.0",
    "vitest": "3.2.7"
  }
}
