{
  "manifest_version": 3,
  "name": "DealFlow lead capture",
  "short_name": "DealFlow",
  "description": "Find email addresses on the page you are reading and save them as leads in your DealFlow workspace.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "DealFlow: find emails on this page", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "sidePanel", "scripting", "contextMenus"],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
